<script>
function savebomdata() {

    // Collect values properly
    const part_no_list = [...document.getElementsByName('part_num[]')].map(e => e.value);
    const level_list = [...document.getElementsByName('level[]')].map(e => e.value);
    const revision_list = [...document.getElementsByName('rev[]')].map(e => e.value);
    const desc_list = [...document.getElementsByName('desc[]')].map(e => e.value);
    const qty_list = [...document.getElementsByName('qty[]')].map(e => e.value);
    const process_type_list = [...document.getElementsByName('process_type[]')].map(e => e.value);
    const scope_list = [...document.getElementsByName('scope[]')].map(e => e.value);
    const method_list = [...document.getElementsByName('method[]')].map(e => e.value);
    const nesting_list = [...document.getElementsByName('is_nesting_needed[]')].map(e => e.value);

    const payload = {
        part_no_list,
        level_list,
        revision_list,
        desc_list,
        qty_list,
