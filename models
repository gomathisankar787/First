class SMMaterial(models.Model):
    part_no = models.CharField(max_length=100)
    part_description = models.CharField(max_length=255)
    estimation_mthd = models.CharField(max_length=100)
    material_grade = models.CharField(max_length=100)
    rm_price_per_kg = models.FloatField()
    length = models.FloatField()
    width = models.FloatField()
    thickness = models.FloatField()
    sheet_length = models.FloatField()
    sheet_width = models.FloatField()
    cutting_process = models.CharField(max_length=100)
    sheet_weight = models.FloatField()
    no_of_blanks = models.IntegerField()
    blank_weight = models.FloatField()
    input_weight = models.FloatField()
    finish_weight = models.FloatField()
    yield_value = models.FloatField()
    surface_area_part = models.FloatField()
    scrap_weight = models.FloatField()
    scrap_price = models.FloatField()
    recovery_perc = models.FloatField()
    price_per_unit = models.FloatField()
    direct_rm_cost = models.FloatField()
    allowance_cost = models.FloatField()
    remarks = models.TextField()
    updated_on = models.DateField()
    updated_by = models.CharField(max_length=100)
    unique_csc_id = models.CharField(max_length=100)
    def save(self, *args, **kwargs):
        if not self.unique_csc_id:  # Only generate a new ID if it doesn't already exist
            self.unique_csc_id = self.generate_unique_csc_id()
        super().save(*args, **kwargs)

    def generate_unique_csc_id(self):
        """Generate a unique CSC ID based on the highest existing version."""
        existing_versions = BOMSheet.objects.filter(
            part_no=self.part_no,
            revision=self.revision
        ).values_list('unique_csc_id', flat=True)

        versions = []
        for id in existing_versions:
            parts = id.split('-')
            if len(parts) == 5:
                versions.append(int(parts[-1]))

        # Determine the next version
        next_version = max(versions, default=0) + 1

        unique_csc_id = f"KMC-CSC-{self.part_no}-{self.revision}-{next_version}"
        return unique_csc_id

