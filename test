                <tbody>
                    {% for values in page_obj %}
                    <tr>
                        <td>{{values.part_num}}</td>
                        <td>{{values.rev}}</td>
                        <td>{{values.desc}}</td>
                        <td>{{values.part_typ.parttype_name}}</td>
                        <td>{{values.rm_base}}</td>
                        <td>{{values.updated_by}}</td>
                        <td>{{values.unique_csc_id}}</td>
                        <td>{{values.csc_status}}</td>
                        <!-- <td><a href="#" class="btn btn-primary">View</a></td>
                        <td><a class="btn btn-secondary" data-toggle="modal" data-target="#exampleModalCenter" 
                    data-id="{{ values.id }}"
                    data-partnum="{{ values.part_num }}"
