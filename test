                <button type="button" class="btn btn-primary" onclick="updateData()">Update</button>
            </div>
        </div>
        </div>
        </div>


        <!-- create part type modal -->

        <div class="modal fade" id="addPartTypeModal" tabindex="-1" role="dialog" aria-labelledby="addPartTypeModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Create PartType</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="parttype">Name</label>
                    <input type="text" id="parttypename" name="remarks">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeParttype()">Close</button>
                <button type="button" class="btn btn-primary" onclick="createparttype()">Save changes</button>
            </div>
            </div>
        </div>
        </div>

        <!-- create project modal -->

        <div class="modal fade" id="addProjectModal" tabindex="-1" role="dialog" aria-labelledby="addProjectModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Create Project</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="project">Name</label>
                    <input type="text" id="projectname" name="remarks">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="closeProject()">Close</button>
                <button type="button" class="btn btn-primary" onclick="createproject()">Save changes</button>
            </div>
            </div>
        </div>
        </div>

        <!-- CSC Toaster -->
        <div aria-live="polite" id="successToast" aria-atomic="true" class="position-relative">
        <!-- Position it: -->
        <!-- - `.toast-container` for spacing between toasts -->
        <!-- - `.position-absolute`, `top-0` & `end-0` to position the toasts in the upper right corner -->
        <!-- - `.p-3` to prevent the toasts from sticking to the edge of the container  -->
        <div class="toast-container position-absolute top-0 end-0 p-3">

            <!-- Then put toasts within -->
            <div class="toast" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-body">
                    CSC Created Successfully!
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        </div>


        <script>

        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "timeOut":"2000"
        }
        
        document.getElementById('parttypebutton').addEventListener("click",function(){
            var modal = new bootstrap.Modal(document.getElementById('addPartTypeModal'));
            modal.show();
        });

        document.getElementById('projectbutton').addEventListener("click",function(){
            var modal = new bootstrap.Modal(document.getElementById('addProjectModal'));
            modal.show();
        });
            
        
        $('#updatecscModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var modal = $(this);

            // Extract data attributes
            modal.find('#edit_id').val(button.data('id'));
            modal.find('#editpartNumber').val(button.data('partnum'));
            modal.find('#editrevision').val(button.data('rev'));
            modal.find('#editdescription').val(button.data('desc'));
            modal.find('#editparttype').val(button.data('parttyp'));
            modal.find('#editproject').val(button.data('project'));
            modal.find('#editrmmaster').val(button.data('rmbase'));
            modal.find('#editprocessmaster').val(button.data('processbase'));
            modal.find('#editohprofit').val(button.data('ohprofitbase'));
            modal.find('#editremarks').val(button.data('remarks'));
        });


        function closeModal() {
            document.getElementById('partNumber').value = '';
            document.getElementById('revision').value = '';
            document.getElementById('description').value = '';
            document.getElementById('remarks').value = '';
            document.getElementById('processmaster').value = '';
            document.getElementById('ohprofit').value = '';
            document.getElementById('rmmaster').value = '';
            document.getElementById('project').value = '';
            document.getElementById('parttype').value = '';
        }   

        function closeParttype(){
            document.getElementById('parttypename').value ='';
        }

        function closeProject(){
            document.getElementById('projectname').value ='';
        }
        
        function createData() {
            const partnumber = document.getElementById('partNumber').value
            const revision = document.getElementById('revision').value
            const description = document.getElementById('description').value
            const parttype = document.getElementById('parttype').value
            const project = document.getElementById('project').value
            const rmbase = document.getElementById('rmmaster').value
            const ohProfitBase = document.getElementById('ohprofit').value;
            const processBase = document.getElementById('processmaster').value;
            const remarks = document.getElementById('remarks').value

            // Prepare data
            const payload = {
                part_num:partnumber,
                rev:revision,
                desc:description,
                part_typ:parttype,
                projects:project,
                rm_base:rmbase,
                oh_profit_base: ohProfitBase,
                process_base: processBase,
                remarks:remarks
            };

            // Call API
            fetch('createcsc', {
                method: 'POST',
                headers: {
                            'X-CSRFToken': '{{ csrf_token }}'  // Important for Django
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                
                if (data.status === 'success') {
                        // const toastEl = document.getElementById('successToast'); // Get the toast element
                        // const myToast = new bootstrap.Toast(toastEl)
                        // myToast.show();
                        toastr.success(data.message)
                        $('#createModal').modal('hide');
                        setTimeout(function(){
                            window.location.href = 'mycsc';
                        },1000)
                    } else {
                        // You can show an error toast similarly
                    }

                // console.log('Success:', data);
                // alert('Created successfully!');
                // closeModal();
                // $('#createModal').modal('hide');
                // window.location.href = 'mycsc';
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to create!');
            });
        }

        
        function updateData() {
            const payload = {
                id: document.getElementById('edit_id').value,
                part_num: document.getElementById('editpartNumber').value,
                rev:document.getElementById('editrevision').value,
                desc: document.getElementById('editdescription').value,
                part_typ: document.getElementById('editparttype').value,
                projects: document.getElementById('editproject').value,
                rm_base: document.getElementById('editrmmaster').value,
                process_base: document.getElementById('editprocessmaster').value,
                oh_profit_base: document.getElementById('editohprofit').value,
                remarks: document.getElementById('editremarks').value
            };

            fetch('updatecsc', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': '{{ csrf_token }}'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    // alert(data.message);
                    toastr.success(data.message)
                    $('#editModal').modal('hide');
                    setTimeout(() => {
                    window.location.href = "{% url 'mycsc' %}";    
                    }, 1000);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => console.error('Error updating:', error));
        }

        
        function deleteCSC(id) {
            const payload = {
                id: id}
            if (confirm('Are you sure you want to delete this CSC?')) {
                fetch(`deletecsc`, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRFToken': '{{ csrf_token }}' // Include if CSRF protection is enabled
                    },
                    body: JSON.stringify(payload)
                })
                .then(response => response.json())
                .then(data => {
                    // if (data.status === 'success') {
                        // location.reload()
                        toastr.success(data.message);
                        setTimeout(function(){
                            location.reload();
                        },1000)
                        // location.reload(); // Refresh the list
                    // } else {
                    //     toastr.error(data.message);
                    // }
                })
                .catch(error => {
                    toastr.error('Failed to delete');
                    console.error(error);
                });
            }
        }

        function uniquecscview(id){
            window.location.href = `/viewcsc?id=${encodeURIComponent(id)}`;
        }

        function createparttype(){
            name = document.getElementById('parttypename').value
            console.log('nae',name)
            const payload = {
                part_name:name,
            };

            // Call API
            fetch('add_parttype/', {
                method: 'POST',
                headers: {
                            'X-CSRFToken': '{{ csrf_token }}'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                // console.log('data',data.status)
                // if (data.status === 'success') {
                    console.log('workding')
                        // let modal = bootstrap.Modal.getInstance(document.getElementById("addPartTypeModal"))
                        // modal.hide();
                        $('#addPartTypeModal').modal('hide'); 
                        closeParttype();
                        toastr.success("part Type Created Successfully");
                        // setTimeout(()=>{
                        //     window.location.href = 'mycsc';
                        // },1000)
                        
                    // } else {
                    //     // You can show an error toast similarly
                    // }

                // console.log('Success:', data);
                // alert('Created successfully!');
                // closeModal();
                // $('#createModal').modal('hide');
                // window.location.href = 'mycsc';
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to create!');
            });
        }

        function createproject(){
            name = document.getElementById('projectname').value
            console.log('nae',name)
            const payload = {
                part_name:name,
            };

            // Call API
            fetch('add_project/', {
                method: 'POST',
                headers: {
                            'X-CSRFToken': '{{ csrf_token }}'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                $('#addProjectModal').modal('hide'); 
                closeProject();
                toastr.success("Project Created Successfully");
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to create!');
            });
        }

        </script>
