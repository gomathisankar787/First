#nav {
    background: #ffffff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 10px 20px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
}

    .navbar-brand {
        font-weight: 700;
        color: #24968f !important;
        font-size: 24px;
    }
    .navbar-nav .nav-link {
        font-size: 16px;
        color: #333 !important;
        margin-right: 15px;
        transition: color 0.3s ease;
    }
    .navbar-nav .nav-link:hover {
        color: #24968f !important;
    }

    /* Sidebar */
    /* #green {
        background: #f8f9fa;
        padding: 20px;
        box-shadow: 2px 0 6px rgba(0, 0, 0, 0.1);
        font-size: 16px;
    } */

    
    #green {
        position: fixed;
        top: 60px; /* Adjust based on nav height */
        left: 0;
        width: 265px; /* Sidebar width */
        height: calc(100vh - 60px); /* Full height minus nav */
        background: #f8f9fa;
        padding: 20px;
        box-shadow: 2px 0 6px rgba(0, 0, 0, 0.1);
        font-size: 16px;
        overflow-y: auto; /* Sidebar scroll if needed */
    }

    #green a {
        display: block;
        padding: 12px 10px;
        color: #333;
        text-decoration: none;
        border-radius: 6px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }
    #green a:hover {
        background-color: #24968f;
        color: #fff;
    }

    /* Main Content */
    /* .col-10 {
        position: relative;
        background: #fff;
        padding: 30px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    } */

    
    .col-10 {
        position: absolute;
        top: 72px; /* Below nav */
        left: 275px; /* Next to sidebar */
        /* width: calc(100% - 160px);
        height: calc(100vh - 60px);  */
        background: #fff;
        padding: 30px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        border-radius: 5px;
        overflow-y: hidden; /* Scroll only main content */
    }

    h1 {
        font-size: 28px;
        font-weight: 700;
        color: #0969ca;
        margin-bottom: 20px;
    }
    button {
        background-color: #24968f;
        color: #fff;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 20px;
    }
    button:hover {
        background-color: #006955;
        transform: translateY(-2px);
    }

    /* Table Styling */
    .table {
        width: 100%;
        border-collapse: collapse;
    }
    .table thead th {
        background: #04776f;/*linear-gradient(90deg, #24968f, #1abc9c); */
        color: #fff;
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    th, td {
        padding: 12px;
        text-align: center;
        font-size: 14px;
    }
    tr:nth-child(even) {
        background-color: #f8f8f8;
    }
    tr:hover {
        background-color: #eafaf9;
        transition: background-color 0.3s ease;
    }

    /* Buttons inside table */
    .btn-primary, .btn-secondary {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 14px;
        transition: all 0.3s ease;
    }
    .btn-primary {
        background-color: #3498db;
        color: #fff;
        border: none;
    }
    .btn-primary:hover {
        background-color: #2980b9;
        transform: translateY(-2px);
    }
    .btn-secondary {
        background-color: #95a5a6;
        color: #fff;
        border: none;
    }
    .btn-secondary:hover {
        background-color: #7f8c8d;
        transform: translateY(-2px);
    }

    
.modal-content {
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: #ffffff;
        padding: 20px;
    }

    .modal-header {
        background: linear-gradient(90deg, #24968f, #1abc9c);
        color: #fff;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
    }

    .modal-title {
        font-size: 20px;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 0 0 12px 12px;
    }

    /* Form Styling */
    .form-container {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .form-group label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
    }

    #parttype,#project,#editproject,#editparttype{
        height: 80%;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: #24968f;
        box-shadow: 0 0 8px rgba(36, 150, 143, 0.3);
        outline: none;
    }

    /* Buttons */
    .create-btn {
        background: linear-gradient(135deg, #24968f, #006955);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-right: 10px;
    }

    .create-btn:hover {
        background: linear-gradient(135deg, #006955, #004d40);
        transform: translateY(-2px);
    }

    #Editcsc:hover{
        background: linear-gradient(135deg, #c2e5df, #8cdbcd);
        transform: translateY(-2px);
    }

    #deletecsc:hover{
        background: linear-gradient(135deg, #f7bebe, #eb9fa5);
        transform: translateY(-2px);
    }

    #showcsc:hover{
        background: linear-gradient(135deg, #b1e7f5, #9fe6eb);
        transform: translateY(-2px);
    }

    .cancel-btn {
        background-color: #e4e4e4;
        color: #333;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 500;
        transition: all 0.3s ease;
