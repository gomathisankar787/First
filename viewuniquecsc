            <script>
                // console.log(bom_list)
                function nextprocess(id){
                    window.location.href = `bom_details/${id}/`
                }


                function savebomdata(id){
                    const part_no_list = [...document.getElementsByName('part_num[]')].map(e => e.value);
                    const level_list = [...document.getElementsByName('level[]')].map(e => e.value);
                    const revision_list = [...document.getElementsByName('rev[]')].map(e => e.value);
                    const desc_list = [...document.getElementsByName('desc[]')].map(e => e.value);
                    const qty_list = [...document.getElementsByName('qty[]')].map(e => e.value);
                    const process_type_list = [...document.getElementsByName('process_type[]')].map(e => e.value);
                    const scope_list = [...document.getElementsByName('scope[]')].map(e => e.value);
                    const method_list = [...document.getElementsByName('method[]')].map(e => e.value);
                    const nesting_list = [...document.getElementsByName('is_nesting_needed[]')].map(e => e.value);
                    const cscid = id;

                    const payload = {
                        cscid,
                        part_no_list,
                        level_list,
                        revision_list,
                        desc_list,
                        qty_list,
                        process_type_list,
                        scope_list,
                        method_list,
                        nesting_list
                    };

                    fetch("bom", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-CSRFToken": "{{ csrf_token }}"
                        },
                        body: JSON.stringify(payload)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === "success") {
                            toastr.success("Bom data save successfully")
                            setTimeout(() => {
                                window.location.href=`/viewcsc?id=${encodeURIComponent(id)}`
                            }, 1000);
                        } else {
                            alert("Error: " + data.message);
                        }
                    });
                }

                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "timeOut":"2000"
                }

                function toggleMethod(select) {
                    const row = select.closest("tr");
                    const processTypeSelect = row.querySelector('select[name="process_type[]"]');
                    const isNestingNeededSelect = row.querySelector('select[name="is_nesting_needed[]"]');
                    if (processTypeSelect.value === "Assembly" || select.value !== "CSC") {
                        isNestingNeededSelect.value = "No";
                        isNestingNeededSelect.disabled = true;
                    } else {
                        isNestingNeededSelect.disabled = false;
                    }
                }

                function toggleProcessType(select) {
                    const row = select.closest("tr");
                    const isNestingNeededSelect = row.querySelector('select[name="is_nesting_needed[]"]');
                    const methodSelect = row.querySelector('select[name="method[]"]');
                    if (select.value === "Assembly") {
                        isNestingNeededSelect.value = "No";
                        isNestingNeededSelect.disabled = true;
                    } else {
                        isNestingNeededSelect.disabled = false;
                    }
                }

                function addRow() {
                    const tableBody = document.getElementById("bom-table-body");
                    if (tableBody.rows.length >= 150) {
                        alert("Maximum of 150 rows allowed.");
                        return;
                    }
                    const newRow = tableBody.insertRow();
                    const sno = tableBody.rows.length; // Corrected serial number
                    newRow.innerHTML = `
                        <td class="sno">${sno}</td>
                        <td><input type="number" name="level[]" class="form-control" style="width: 50px; height:35px;"></td>
                        <td><input type="text" name="part_num[]" class="form-control"  style="width: 100px; height:35px;"></td>
                        <td><input type="text" name="rev[]" class="form-control" style="width: 50px; height:35px;"></td>
                        <td><input type="text" name="desc[]" class="form-control" style="width: 200px; height:35px;"></td>
                        <td><input type="number" name="qty[]" class="form-control" style="width: 50px; height:35px;"></td>
                        <td>
                            <select name="process_type[]" class="form-control" onchange="toggleProcessType(this)">
                                <option value="" disabled selected>Select Process Type</option>
                                {% for process in process_types %}
                                    <option value="{{ process }}">{{ process }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
