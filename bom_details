from django.http import JsonResponse

def get_material_rates(request):
    grade = request.GET.get('material_grade')
    try:
        rm = RMbase.objects.get(material_grade=grade)
        return JsonResponse({
            'rm_price': rm.rm_rate,
            'scrap_price': rm.scrap_rate
        })
    except RMbase.DoesNotExist:
        return JsonResponse({'rm_price': 0, 'scrap_price': 0})
path('ajax/material_rates/', views.get_material_rates, name='material_rates'),
function getMaterialRates(grade) {
    if (!grade) return;

    fetch(`/ajax/material_rates/?material_grade=${grade}`)
        .then(response => response.json())
        .then(data => {
            document.querySelector('input[name="rm_price"]').value = data.rm_price;
            document.querySelector('input[name="scrap_price"]').value = data.scrap_price;

            // trigger recalculation
            const evt = new Event('input');
            document.querySelector('input[name="length"]').dispatchEvent(evt);
        })
        .catch(err => console.log("Error fetching material rates", err));
}
