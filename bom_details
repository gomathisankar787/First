{% csrf_token %}
<div class="table-container">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>S.No</th>
                <th>Level</th>
                <th>Part No.</th>
                <th>Rev</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Process Type</th>
                <th>Scope</th>
                <th>Method</th>
                <th>Nesting Needed</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="bom-table-body">
            {% for row in bom_list %}
            <tr>
                <td class="sno">{{ forloop.counter }}</td>

                <!-- IMPORTANT : BOM ID -->
                <input type="hidden" name="bom_id[]" value="{{ row.id }}">

                <td><input type="number" name="level[]" class="form-control" value="{{ row.level }}"></td>
                <td><input type="text" name="part_num[]" class="form-control" value="{{ row.part_no }}"></td>
                <td><input type="text" name="rev[]" class="form-control" value="{{ row.revision }}"></td>
                <td><input type="text" name="desc[]" class="form-control" value="{{ row.part_description }}"></td>
                <td><input type="number" name="qty[]" class="form-control" value="{{ row.qty }}"></td>

                <td>
                    <select name="process_type[]" class="form-control">
                        <option value="" disabled>Select</option>
                        {% for p in process_types %}
                        <option value="{{ p }}" {% if row.process_type == p %}selected{% endif %}>{{ p }}</option>
                        {% endfor %}
                    </select>
                </td>

                <td>
                    <select name="scope[]" class="form-control">
                        <option value="" disabled>Select</option>
                        <option value="InHouse" {% if row.scope == 'InHouse' %}selected{% endif %}>InHouse</option>
                        <option value="BOSF" {% if row.scope == 'BOSF' %}selected{% endif %}>BOSF</option>
                        <option value="BOF" {% if row.scope == 'BOF' %}selected{% endif %}>BOF</option>
                    </select>
                </td>

                <td>
                    <select name="method[]" class="form-control">
                        <option value="" disabled>Select</option>
                        {% for m in method_list %}
                        <option value="{{ m }}" {% if row.method == m %}selected{% endif %}>{{ m }}</option>
                        {% endfor %}
                    </select>
                </td>

                <td>
                    <select name="is_nesting_needed[]" class="form-control">
                        <option value="" disabled>Select</option>
                        <option value="Yes" {% if row.is_nesting_needed == 'Yes' %}selected{% endif %}>Yes</option>
                        <option value="No" {% if row.is_nesting_needed == 'No' %}selected{% endif %}>No</option>
                    </select>
                </td>

                <td>
                    <i class="bi bi-plus-circle btn" onclick="addRow()"></i>
                    <i class="bi bi-trash btn" onclick="deleteRow(this)"></i>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="col-3 d-flex justify-content-end">
    {% if bom_list %}
    <button type="button" class="btn btn-warning" onclick="updatebomdata({{ csc_values.id }})">Update BOM Data</button>
    {% else %}
    <button type="button" class="btn btn-primary" onclick="savebomdata({{ csc_values.id }})">Save BOM Data</button>
    {% endif %}
</div>
function renumberRows() {
    document.querySelectorAll('#bom-table-body .sno').forEach((td, index) => {
        td.textContent = index + 1;
    });
}

function addRow() {
    const tbody = document.getElementById("bom-table-body");
    const sno = tbody.rows.length + 1;

    const row = document.createElement("tr");
    row.innerHTML = `
        <td class="sno">${sno}</td>
        <input type="hidden" name="bom_id[]" value="">  <!-- new row -->
        <td><input type="number" name="level[]" class="form-control"></td>
        <td><input type="text" name="part_num[]" class="form-control"></td>
        <td><input type="text" name="rev[]" class="form-control"></td>
        <td><input type="text" name="desc[]" class="form-control"></td>
        <td><input type="number" name="qty[]" class="form-control"></td>

        <td>
            <select name="process_type[]" class="form-control">
                <option value="" disabled selected>Select</option>
                {% for p in process_types %}
                <option value="{{ p }}">{{ p }}</option>
                {% endfor %}
            </select>
        </td>

        <td>
            <select name="scope[]" class="form-control">
                <option value="" disabled selected>Select</option>
                <option value="InHouse">InHouse</option>
                <option value="BOSF">BOSF</option>
                <option value="BOF">BOF</option>
            </select>
        </td>

        <td>
            <select name="method[]" class="form-control">
                <option value="" disabled selected>Select</option>
                {% for m in method_list %}
                <option value="{{ m }}">{{ m }}</option>
                {% endfor %}
            </select>
        </td>

        <td>
            <select name="is_nesting_needed[]" class="form-control">
                <option value="" disabled selected>Select</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
        </td>

        <td>
            <i class="bi bi-plus-circle btn" onclick="addRow()"></i>
            <i class="bi bi-trash btn" onclick="deleteRow(this)"></i>
        </td>
    `;

    tbody.appendChild(row);
}

function deleteRow(btn) {
    btn.closest("tr").remove();
    renumberRows();
}
