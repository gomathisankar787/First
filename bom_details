from django.shortcuts import render, get_object_or_404, redirect
from django.core.paginator import Paginator
from django.contrib import messages
from .models import CRCSCTBL, BOMSheet, SMMaterial, RMbase
import datetime, math, os


def bomdetails(request, id):

    # ──────────────────────────────
    # 0️⃣ BASE CSC & BOM ROW FETCH
    # ──────────────────────────────
    csc_values = get_object_or_404(CRCSCTBL, id=id)
    unique_csc_id = csc_values.unique_csc_id

    bom_rows = BOMSheet.objects.filter(unique_csc_id=unique_csc_id).order_by('id')
    paginator = Paginator(bom_rows, 1)  # 1 row per page
    page_number = request.GET.get('page')
    page_obj = paginator.get_page(page_number)
    row = page_obj.object_list.first()

    if not row:
        messages.warning(request, 'No BOM rows available for this CSC.')
        return render(request, 'bom_details.html', {'csc_values': csc_values})

    material_grades = RMbase.objects.values_list('material_grade', flat=True)
    system_user = os.environ.get('USERNAME', 'system')
    current_date = datetime.datetime.now().strftime('%Y-%m-%d')

    # Defaults for dynamic values
    rm_price = scrap_price = 0
    sheet_length = 2500
    sheet_width = 1250
    sheet_weight = blank_weight = input_weight = scrap_weight = 0
    no_of_blanks = yield_value = surface_area_part = 0
    price_per_unit = direct_rm_cost = allowance_cost = 0
    finish_weight = 0

    # Restore previous values if exist
    old_smm = SMMaterial.objects.filter(bom_id=row.id).first()
    if old_smm:
        rm_price = old_smm.rm_price_per_kg
        scrap_price = old_smm.scrap_price
        sheet_length = old_smm.sheet_length
        sheet_width = old_smm.sheet_width
        sheet_weight = old_smm.sheet_weight
        no_of_blanks = old_smm.no_of_blanks
        blank_weight = old_smm.blank_weight
        input_weight = old_smm.input_weight
        finish_weight = old_smm.finish_weight
        yield_value = old_smm.yield_value
        surface_area_part = old_smm.surface_area_part
        scrap_weight = old_smm.scrap_weight
        price_per_unit = old_smm.price_per_unit
        direct_rm_cost = old_smm.direct_rm_cost
        allowance_cost = old_smm.allowance_cost

    # ──────────────────────────────
    # 1️⃣ SAVE MATERIAL RECORD
    # ──────────────────────────────
    if request.method == 'POST' and 'save_material_data' in request.POST:
        try:
            SMMaterial.objects.update_or_create(
                bom_id=row.id,
                defaults={
                    'unique_csc_id': unique_csc_id,
                    'part_no': row.part_no,
                    'part_description': row.part_description,
                    'estimation_mthd': row.method,
                    'material_grade': request.POST['material_grade'],
                    'rm_price_per_kg': float(request.POST['rm_price']),
                    'length': float(request.POST['length']),
                    'width': float(request.POST['width']),
                    'thickness': float(request.POST['thickness']),
                    'sheet_length': float(request.POST['sheet_length']),
                    'sheet_width': float(request.POST['sheet_width']),
                    'cutting_process': request.POST['process'],
                    'sheet_weight': float(request.POST['sheet_weight']),
                    'no_of_blanks': int(request.POST['no_of_blanks']),
                    'blank_weight': float(request.POST['blank_weight']),
                    'input_weight': float(request.POST['input_weight']),
                    'finish_weight': float(request.POST['finish_weight']),
                    'yield_value': float(request.POST['yield']),
                    'surface_area_part': float(request.POST['surface_area']),
                    'scrap_weight': float(request.POST['scrap_weight']),
                    'scrap_price': float(request.POST['scrap_price']),
                    'recovery_perc': 95,
                    'price_per_unit': float(request.POST['price_per_unit']),
                    'direct_rm_cost': float(request.POST['direct_rm_cost']),
                    'allowance_cost': float(request.POST['allowance_cost']),
                    'remarks': request.POST.get("remarks", ""),
                    'updated_on': current_date,
                    'updated_by': system_user
                }
            )

            csc_values.csc_status = "Completed till SMMaterial details"
            csc_values.save(update_fields=['csc_status'])

            messages.success(request, "SM Material saved successfully!")
            return redirect(f"/bom_details/{id}/?page={page_obj.number}")

        except Exception as e:
            messages.error(request, f"Error saving material: {e}")
            return redirect(f"/bom_details/{id}/?page={page_obj.number}")

    # ──────────────────────────────
    # 2️⃣ DYNAMIC CALCULATIONS
    # ──────────────────────────────
    if request.method == 'POST' and 'save_material_data' not in request.POST:

        material_grade = request.POST.get("material_grade")
        length = float(request.POST.get("length") or 0)
        width = float(request.POST.get("width") or 0)
        thickness = float(request.POST.get("thickness") or 0)
        finish_weight = float(request.POST.get("finish_weight") or 0)
        process = request.POST.get("process")

        # Fetch RM prices
        try:
            base = RMbase.objects.get(material_grade=material_grade)
            rm_price, scrap_price = base.rm_rate, base.scrap_rate
        except RMbase.DoesNotExist:
            rm_price = scrap_price = 0

        # SHEET DIMENSION LOGIC
        if process:
            if process.lower() == "shearing":
                sl = max(length, 2500)
                sw = max(width, 1250)
            elif process.lower() == "blanking":
                sl = max(length + thickness * 3, 2500)
                sw = max(width + thickness * 3, 1250)
            else:  # laser/plasma
                sl = max(length + 4, 2500)
                sw = max(width + 4, 1250)

            sheet_length = math.ceil(sl / 5) * 5
            sheet_width = math.ceil(sw / 5) * 5

        # BLANK LOGIC
        if process.lower() == "shearing":
            bl, bw = length, width
        elif process.lower() == "blanking":
            bl, bw = length + thickness * 1.5, width + thickness * 3
        else:
            bl, bw = length + 4, width + 4

        no_of_blanks = int(max(
            (sheet_length // bl) * (sheet_width // bw),
            (sheet_length // bw) * (sheet_width // bl)
        ))

        sheet_weight = round(sheet_length * sheet_width * thickness * 7.86 / 1e6, 2)
        blank_weight = round(length * width * thickness * 7.86 / 1e6, 2)
        input_weight = round(sheet_weight / no_of_blanks if no_of_blanks else 0, 2)
        yield_value = round((finish_weight / input_weight) * 100) if input_weight else 0
        surface_area_part = round((finish_weight / thickness / 7.86 * 2), 3) if finish_weight else 0
        scrap_weight = round(input_weight - finish_weight, 2) if finish_weight else 0
        price_per_unit = round((rm_price * input_weight) - (scrap_price * scrap_weight * 0.95), 2)
        direct_rm_cost = round(finish_weight * rm_price, 2)
        allowance_cost = round(price_per_unit - direct_rm_cost, 2)

    # ──────────────────────────────
    # 3️⃣ RETURN CONTEXT TO TEMPLATE
    # ──────────────────────────────
    context = {
        'csc_values': csc_values,
        'page_obj': page_obj,
        'row': row,
        'material_grades': material_grades,
        'rm_price': rm_price,
        'scrap_price': scrap_price,
        'sheet_length': sheet_length,
        'sheet_width': sheet_width,
        'sheet_weight': sheet_weight,
        'no_of_blanks': no_of_blanks,
        'blank_weight': blank_weight,
        'input_weight': input_weight,
        'finish_weight': finish_weight,
        'yield_value': yield_value,
        'surface_area_part': surface_area_part,
        'scrap_weight': scrap_weight,
        'price_per_unit': price_per_unit,
        'direct_rm_cost': direct_rm_cost,
        'allowance_cost': allowance_cost,
    }

    return render(request, "bom_details.html", context)
