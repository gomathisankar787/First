{% for values in bom_list %}
                                    <tr>
                                    <td class="sno">{{ forloop.counter }}</td>
                                    <td><input type="number" name="level[]" class="form-control" value="{{values.level}}" style="width: 60px;height:35px;"></td>
                                    <td><input type="text" name="part_num[]" class="form-control" value="{{values.part_no}}" style="width: 100px; height:35px;"></td>
                                    <td><input type="text" name="rev[]" class="form-control" value="{{values.revision}}" style="width: 50px; height:35px;"></td>
                                    <td><input type="text" name="desc[]" class="form-control" value="{{values.part_description}}" style="width: 200px; height:35px;"></td>
                                    <td><input type="number" name="qty[]" class="form-control" value="{{values.qty}}" style="width: 50px; height:35px;"></td>
                                    <td>
                                        <select name="process_type[]" class="form-control" onchange="toggleProcessType(this)">
                                        {% if values.process_type %}
                                        <option value="{{values.process_type}}" disabled selected></option>
                                        {% endif %} 
                                        <option value="">Select Process Type</option>
                                        {% for process in process_types %}
                                            <option value="{{ process }}">{{ process }}</option>
                                        {% endfor %}
                                        </select>
                                    </td>
                                    <td>
                                        <select name="scope[]" class="form-control">
                                            {% if values.scope %}
                                            <option value="{{values.scope}}">Select Scope</option>
                                            {% endif %}    
                                        <option value="" disabled selected>Select Scope</option>
                                        <option value="InHouse">InHouse</option>
                                        <option value="BOSF">BOSF</option>
                                        <option value="BOF">BOF</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select name="method[]" class="form-control"  onchange="toggleMethod(this)">
                                        <option value="" disabled selected>Select Method</option>
                                        <option value="CSC">CSC</option>
                                        <option value="Import">Import</option>
                                        <option value="Quote">Quote</option>
                                        <option value="Reference">Reference</option>
                                        <option value="Consumables">Consumables</option>
                                        <option value="LPP-Regression">LPP-Regression</option>
                                        <option value="LPP-Thumbrule">LPP-Thumbrule</option>
                                        <option value="KMC">KMC</option>
                                        <option value="ME2M">ME2M</option>
                                        <option value="MM03">MM03</option>
                                        <option value="ZS08">ZS08</option>
                                        <option value="ZS12">ZS12</option>
                                        <option value="CS03">CS03</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select name="is_nesting_needed[]" class="form-control" onchange="toggleNoOfBlanks(this)">
                                        <option value="" disabled selected>Select</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                        </select>
                                    </td>
                                    <td>
                                        <!-- <button type="button" class="btn small-btn"  style="background-color: green;" onclick="addRow()">Add Row</button> -->
                                        <i class="bi bi-plus-circle btn" id="showcsc" onclick="addRow()"></i>
                                        <!-- <i class="bi bi-pencil-square btn" id="Editcsc"></i> -->
                                        <i class="bi bi-trash btn" id="deletecsc" onclick="deleteRow(this)"></i>
                                        <!-- <button type="button" class="btn small-btn"  style="background-color: rgba(255, 0, 0, 0.712);" onclick="">Delete</button> -->
                                    </td>
                                    </tr>
                                    {% endfor %}
