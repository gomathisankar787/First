{% load static %}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>BOM Details - SM Material</title>

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

  <style>
    /* small visual tweaks */
    .table-responsive-x { overflow-x: auto; white-space: nowrap; }
    .rowdata input, .rowdata select { width: 110px; }
    .small-cell { width: 80px; }
    .readonly { background-color: #e9ecef; }
    .card { margin-bottom: 20px; }
    .pagination { margin-top: 12px; display:flex; gap:8px; align-items:center; }
  </style>
</head>
<body>
<div class="container-fluid p-3">
  <!-- Messages -->
  {% if messages %}
    <div class="mb-2">
      {% for message in messages %}
        <div class="alert alert-{{ message.tags }}">{{ message }}</div>
      {% endfor %}
    </div>
  {% endif %}

  <!-- Header card -->
  <div class="card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">CSC UNIQUE ID : <b>{{ csc_values.unique_csc_id }}</b></div>
        <div class="col-md-3">PART NUMBER : <b>{{ csc_values.part_num }}</b></div>
        <div class="col-md-2">REVISION : <b>{{ csc_values.rev }}</b></div>
        <div class="col-md-3">RM BASE : <b>{{ csc_values.rm_base }}</b></div>
      </div>
      <div class="row mt-2">
        <div class="col-md-4">DESCRIPTION : <b>{{ csc_values.desc }}</b></div>
        <div class="col-md-3">ESTIMATED BY : <b>{{ csc_values.updated_by }}</b></div>
      </div>
    </div>
  </div>

  <!-- Pagination -->
  <div class="pagination">
    {% if page_obj.has_previous %}
      <a class="btn btn-outline-primary btn-sm" href="?page={{ page_obj.previous_page_number }}">Previous</a>
    {% else %}
      <button class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
    {% endif %}

    <!-- show current page number and total -->
    <div>Page <strong>{{ page_obj.number }}</strong> of {{ page_obj.paginator.num_pages }}</div>

    {% if page_obj.has_next %}
      <a class="btn btn-outline-primary btn-sm" href="?page={{ page_obj.next_page_number }}">Next</a>
    {% else %}
      <button class="btn btn-outline-secondary btn-sm" disabled>Next</button>
    {% endif %}
  </div>

  <!-- Accordion: SM MATERIAL -->
  <div class="accordion" id="accordionExample">
    <div class="card">
      <div class="card-header" id="headingOne">
        <h5 class="mb-0">
          <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#collapseOne"
                  aria-expanded="true" aria-controls="collapseOne">
            SM MATERIAL (BOM Row: {{ row.part_no }})
          </button>
        </h5>
      </div>

      <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordionExample">
        <div class="card-body">
          <form method="post" action="{% url 'bom_details' csc_values.id %}" id="smmaterial-form">
            {% csrf_token %}

            <div class="table-responsive-x">
              <table class="table table-bordered">
                <thead>
                  <tr>
                    <th class="small-cell">Part No</th>
                    <th class="small-cell">Description</th>
                    <th class="small-cell">Est. Method</th>
                    <th class="small-cell">Material Grade</th>
                    <th class="small-cell">RM Price / Kg</th>
                    <th class="small-cell">Length (mm)</th>
                    <th class="small-cell">Width (mm)</th>
                    <th class="small-cell">Thick (mm)</th>
                    <th class="small-cell">Sheet Length (mm)</th>
                    <th class="small-cell">Sheet Width (mm)</th>
                    <th class="small-cell">Process</th>
                    <th class="small-cell">Sheet Weight (kg)</th>
                    <th class="small-cell">No of Blanks</th>
                    <th class="small-cell">Blank wt (kg)</th>
                    <th class="small-cell">Input wt (kg)</th>
                    <th class="small-cell">Finish wt (kg)</th>
                    <th class="small-cell">Yield (%)</th>
                    <th class="small-cell">Surface Area</th>
                    <th class="small-cell">Scrap wt (kg)</th>
                    <th class="small-cell">Scrap mat.Price</th>
                    <th class="small-cell">Price per unit</th>
                    <th class="small-cell">Direct RM Cost</th>
                    <th class="small-cell">Allowance cost</th>
                    <th class="small-cell">Remarks</th>
                  </tr>
                </thead>

                <tbody>
                  <tr class="rowdata">
                    <!-- Part data comes from BOM row -->
                    <td><input type="text" name="part_num" value="{{ row.part_no }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="description" value="{{ row.part_description }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="estimation_method" value="{{ row.method }}" readonly class="form-control readonly"></td>

                    <!-- Material grade dropdown (auto-submit on change) -->
                    <td>
                      <select name="material_grade" id="material_grade" class="form-control auto-submit">
                        <option value="">--</option>
                        {% for grade in material_grades %}
                          <option value="{{ grade }}" {% if grade == request.POST.material_grade %}selected{% endif %}>{{ grade }}</option>
                        {% endfor %}
                      </select>
                    </td>

                    <!-- RM price -> from view context (rm_price) -->
                    <td><input type="text" name="rm_price" id="rm_price" value="{{ rm_price|default:'' }}" readonly class="form-control readonly"></td>

                    <!-- Length / Width / Thickness (user inputs that trigger server calc) -->
                    <td><input type="number" step="any" name="length" id="length" value="{{ request.POST.length|default:'' }}" class="form-control auto-submit"></td>
                    <td><input type="number" step="any" name="width" id="width" value="{{ request.POST.width|default:'' }}" class="form-control auto-submit"></td>
                    <td><input type="number" step="any" name="thickness" id="thickness" value="{{ request.POST.thickness|default:'' }}" class="form-control auto-submit"></td>

                    <!-- Sheet size (calculated by view; user may override if needed) -->
                    <td><input type="number" step="any" name="sheet_length" id="sheet_length" value="{{ sheet_length|default:'' }}" class="form-control"></td>
                    <td><input type="number" step="any" name="sheet_width" id="sheet_width" value="{{ sheet_width|default:'' }}" class="form-control"></td>

                    <!-- Process select -->
                    <td>
                      <select name="process" id="process" class="form-control auto-submit">
                        <option value="">Select</option>
                        <option value="shearing" {% if request.POST.process == "shearing" %}selected{% endif %}>Shearing</option>
                        <option value="blanking" {% if request.POST.process == "blanking" %}selected{% endif %}>Blanking</option>
                        <option value="laser cutting" {% if request.POST.process == "laser cutting" %}selected{% endif %}>Laser Cutting</option>
                        <option value="plasma cutting" {% if request.POST.process == "plasma cutting" %}selected{% endif %}>Plasma Cutting</option>
                      </select>
                    </td>

                    <!-- Calculated read-only fields from view -->
                    <td><input type="text" name="sheet_weight" id="sheet_weight" value="{{ sheet_weight|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="no_of_blanks" id="no_of_blanks" value="{{ no_of_blanks|default:'' }}" class="form-control"></td>
                    <td><input type="text" name="blank_weight" id="blank_weight" value="{{ blank_weight|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="input_weight" id="input_weight" value="{{ input_weight|default:'' }}" readonly class="form-control readonly"></td>

                    <!-- Finish weight triggers recalculation -->
                    <td><input type="number" step="any" name="finish_weight" id="finish_weight" value="{{ finish_weight|default:'' }}" class="form-control auto-submit"></td>

                    <td><input type="text" name="yield" id="yield" value="{{ yield_value|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="surface_area" id="surface_area" value="{{ surface_area_part|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="scrap_weight" id="scrap_weight" value="{{ scrap_weight|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="scrap_price" id="scrap_price" value="{{ scrap_price|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="price_per_unit" id="price_per_unit" value="{{ price_per_unit|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="direct_rm_cost" id="direct_rm_cost" value="{{ direct_rm_cost|default:'' }}" readonly class="form-control readonly"></td>
                    <td><input type="text" name="allowance_cost" id="allowance_cost" value="{{ allowance_cost|default:'' }}" readonly class="form-control readonly"></td>

                    <td><input type="text" name="remarks" id="remarks" value="{{ request.POST.remarks|default:'' }}" class="form-control"></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="d-flex justify-content-between mt-2">
              <div>
                <!-- Save button: name is important for view to detect saving -->
                <button type="submit" name="save_material_data" class="btn btn-success">Save Material Data</button>
              </div>

              <div>
                <!-- When saving, we should include the current page in the querystring so redirect returns here.
                     But we are using redirect in view to f"/bom_details/{id}/?page={page_obj.number}" -->
                <small class="text-muted">Row ID: {{ row.id }}</small>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- bottom pagination repeat (same links) -->
  <div class="pagination">
    {% if page_obj.has_previous %}
      <a class="btn btn-outline-primary btn-sm" href="?page={{ page_obj.previous_page_number }}">Previous</a>
    {% else %}
      <button class="btn btn-outline-secondary btn-sm" disabled>Previous</button>
    {% endif %}
    <div>Page <strong>{{ page_obj.number }}</strong> of {{ page_obj.paginator.num_pages }}</div>
    {% if page_obj.has_next %}
      <a class="btn btn-outline-primary btn-sm" href="?page={{ page_obj.next_page_number }}">Next</a>
    {% else %}
      <button class="btn btn-outline-secondary btn-sm" disabled>Next</button>
    {% endif %}
  </div>

</div>

<!-- jQuery + Bootstrap JS (required) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
  (function () {
    const form = document.getElementById('smmaterial-form');

    // Auto-submit controls: any change on these elements will submit the form to recalc on server
    const autoControls = document.querySelectorAll('.auto-submit');

    autoControls.forEach(ctrl => {
      ctrl.addEventListener('change', function (e) {
        // Attach a hidden input to indicate this is NOT a save action (just recalc)
        // We don't need to add anything — view checks absence/presence of save_material_data.
        form.submit();
      });
    });

    // Prevent form double-submit on save
    form.addEventListener('submit', function (ev) {
      const saveBtn = form.querySelector('button[name="save_material_data"]');
      if (document.activeElement === saveBtn) {
        // regular save - let it proceed
        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';
      }
    });
  })();
</script>

</body>
</html>
