<div class="modal fade" id="updatecscModal" tabindex="-1" data-backdrop="static" data-keyboard="false" aria-labelledby="updatecscModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content"> 
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLongTitle">Update Bom Details</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closeModal()">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="form-container">
                            <!-- <form class="create-csc-form" class="row mx-0" method="post" action=""> -->
                                <h5>SM MATERIAL</h5>
                            <form id="sm_material_form" method="post" action="{% url 'bom_details' csc_values.id %}">
                                    {% csrf_token %}
                                    <div class="table-responsive-sm" style="overflow-x: auto; white-space: nowrap;">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Part No</th>
                                                <th>Description</th>
                                                <th>Estimation Method</th>
                                                <th>Material Grade</th>
                                                <th>Length (mm)</th>
                                                <th>Width (mm)</th>
                                                <th>Thick (mm)</th>
                                                <th>Shearing/ Blanking/ Laser cutting</th>
                                                <th>Finish weight (Kg)</th>
                                                <th>RM Price / Kg (INR)</th>
                                                <th>Sheet Length (mm)</th>
                                                <th>Sheet Width (mm)</th>
                                                <th>Sheet Weight (kg)</th>
                                                <th>No of Blanks per sheet</th>
                                                <th>Blank weight (Kg)</th>
                                                <th>Input Weight (Kg)</th>
                                                <th>Yield (%)</th>
                                                <th>Surface Area / Part</th>
                                                <th>Scrap wt (kg)</th>
                                                <th>Scrap mat.Price</th>
                                                <th>Recovery (%)</th>
                                                <th>Price per unit (INR)</th>
                                                <th>Direct RM Cost</th>
                                                <th>Allowance cost</th>
                                                <th>Remarks</th>
                                            </tr>                   
                                        </thead>
                                        <tbody>
                                            
                                        {% if page_obj %}
                                            <tr class="rowdata">

                                                <td>
                                                    <input type="hidden" id="edit_id">
                                                    <input type="text" id="editpartNumber"  name="part_num" style="width: 100px;" readonly>
                                                </td>
                                                <td><input type="text" id="editdescription" name="description" style="width: 80px;" readonly></td>
                                                <td><input type="text" id="editmethod" name="estimation_method" style="width: 80px;" readonly></td>
                                                <td>
                                                    <select id="materialgrades" name="material_grade" style="width: 100px;" onchange="getMaterialRates(this.value)" required>
                                                        <option></option> <!-- This empty option is needed for the placeholder to work -->
                                                        {% for grade in material_grades %}
                                                        <option value="{{ grade }}" {% if grade == request.POST.material_grade %}selected{% endif %} >{{ grade }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </td>
                                                <td><input type="" name="length" value="{{ request.POST.length }}" required min="0"></td>
                                                <td><input type="" name="width" value="{{ request.POST.width }}" required min="0"></td>
                                                <td><input type="" name="thickness" value="{{ request.POST.thickness }}" required min="0"></td>
                                                <td>
                                                    <select name="process" style="width: 100px;" required>
                                                        <!-- onchange="this.form.submit()" -->
                                                        <option value="" disabled selected>Select Process</option>
                                                        <option value="shearing" {% if request.POST.process == "shearing" %}selected{% endif %}>Shearing</option>
                                                        <option value="blanking" {% if request.POST.process == "blanking" %}selected{% endif %}>Blanking</option>
                                                        <option value="laser cutting" {% if request.POST.process == "laser cutting" %}selected{% endif %}>Laser Cutting</option>
                                                        <option value="plasma cutting" {% if request.POST.process == "plasma cutting" %}selected{% endif %}>Plasma Cutting</option>
                                                    </select>
                                                </td>
                                                <td><input type="" name="finish_weight" value="{{ request.POST.finish_weight }}" required min="0"></td>
                                                <td><input name="rm_price" value="{{ rm_price }}" readonly style="background-color: #e9ecef;"></td>
                                                <td><input name="sheet_length" value="{{ sheet_length }}" ></td>
                                                <td><input name="sheet_width" value="{{ sheet_width }}" ></td>
                                                <td><input type="" name="sheet_weight" value="{{ sheet_weight }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="no_of_blanks" value="{{ no_of_blanks }}" id="no_of_blanks"></td>
                                                <td><input type="" name="blank_weight" value="{{ blank_weight }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="input_weight" value="{{ input_weight }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="yield" value="{{ yield_value }}" ></td>
                                                <td><input type="" name="surface_area" value="{{ surface_area_part }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="scrap_weight" value="{{ scrap_weight }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input name="scrap_price" value="{{ scrap_price }}" readonly style="background-color: #e9ecef;"></td>
                                                <td><input type="text" name="recovery" value="95" readonly style="background-color: #e9ecef;"></td>
                                                <td><input type="" name="price_per_unit" value="{{ price_per_unit }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="direct_rm_cost" value="{{ direct_rm_cost }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="" name="allowance_cost" value="{{ allowance_cost }}" style="background-color: #e9ecef;" readonly></td>
                                                <td><input type="text" name="remarks" style="width: 100px;"></td>
                                            </tr>
                                            
                                        {% else %}
                                            <td colspan="16" style="text-align:center;">No data on this page.</td>
                                        {% endif %}

                                        </tbody>
                                    </table></div>
