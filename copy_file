                                                data-qty="{{values.qty}}"
                                                data-partno="{{values.part_no}}"
                                                data-description="{{values.part_description}}"
                                                data-scope="{{values.scope}}"
                                                data-process_description="{{values.process_type}}"
                                                data-is_nesting_needed = "{{values.is_nesting_needed}}"
                                                data-unique_csc_id = "{{csc_values.unique_csc_id}}"
                                                data-method="{{values.method}}" onclick="othermodelmethod({{values.id}})"></i>
                                                {% elif values.process_type == "Assembly" %}
                                                <i class="bi bi-pencil-square btn" id="Editcsc" data-toggle="modal" data-target="#AssemblyModal"
                                                data-id="{{values.id}}"
                                                data-partno="{{values.part_no}}"
                                                data-description="{{values.part_description}}"
                                                data-scope="{{values.scope}}"
                                                data-process_description="{{values.cutting_process}}"
                                                data-is_nesting_needed = "{{values.is_nesting_needed}}"
                                                data-unique_csc_id = "{{csc_values.unique_csc_id}}"
                                                data-method="{{values.method}}" onclick="sm_materialById({{values.id}})"></i>
                                                {% else %}
                                                <i class="bi bi-pencil-square btn" id="Editcsc" data-toggle="modal" data-target="#updatecscModal"
                                                data-id="{{values.id}}"
                                                data-partno="{{values.part_no}}"
                                                data-description="{{values.part_description}}"
                                                data-scope="{{values.scope}}"
                                                data-process_description="{{values.cutting_process}}"
                                                data-is_nesting_needed = "{{values.is_nesting_needed}}"
                                                data-method="{{values.method}}" onclick="sm_materialById({{values.id}})"></i>
                                                {% endif %}
                                                <!-- <i class="bi bi-grip-vertical drag-handle" title="Drag to reorder"></i> -->
                                                <i class="bi bi-trash btn delete-bom" id="deletecsc" data-toggle="modal" data-id="{{values.id}}" data-target="#deleteBomModal"></i>
                                                {% endif %}
                                            </td>

