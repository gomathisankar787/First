function getMachineTypeNorms(grade) {
                if (!grade) return;

                fetch(`/ajax/machine_norms/?machine_type=${grade}`)
                    .then(response => response.json())
                    .then(data => {
                        // document.querySelector('input[name="rm_price"]').value = data.rm_price;
                        // document.querySelector('input[name="scrap_price"]').value = data.scrap_price;
                        $('#updatecscModal').find('input[name="norms"]').val(data.norms);
                        // trigger recalculation
                        // const evt = new Event('input');
                        // document.querySelector('input[name="length"]').dispatchEvent(evt);
                    })
                    .catch(err => console.log("Error fetching material rates", err));
            }
