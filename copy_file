path('oh/create/', views.OHProfitCreateAPIView.as_view()),
path('oh/list/', views.OHProfitListAPIView.as_view()),
path('oh/update/<int:id>/', views.OHProfitUpdateAPIView.as_view()),

class OHProfitCreateAPIView(generics.CreateAPIView):
    serializer_class = OHProfitModelSerializer

    def perform_create(self, serializer):
        serializer.save(
            updated_by=os.environ.get("USERNAME", "").lower()
        )


class OHProfitListAPIView(generics.ListAPIView):
    serializer_class = OHProfitModelSerializer
    pagination_class = StandardResultsPagination

    def get_queryset(self):
        return OH_ProfitData.objects.all().order_by("-updated_on")


class OHProfitUpdateAPIView(generics.UpdateAPIView):
    serializer_class = OHProfitModelSerializer
    queryset = OH_ProfitData.objects.all()
    lookup_field = "id"

class OHProfitModelSerializer(serializers.ModelSerializer):
    class Meta:
        model = OH_ProfitData
        fields = "__all__"
        extra_kwargs = {
            'updated_by': {'required': False}
        }

<form id="ohBulkUploadForm" method="post" enctype="multipart/form-data">

document.getElementById("ohBulkUploadForm")
.addEventListener("submit", async e => {
    e.preventDefault();

    const form = e.target;

    const formData = new FormData();
    formData.append("input_excel", form.querySelector('input[type="file"]').files[0]);
    formData.append("sheet_name", "OH,Profit & Other Base");  // IMPORTANT
    formData.append("effective_from", form.querySelector('input[type="date"]').value);
    formData.append("base", "OH");
    formData.append("remarks", "Bulk Upload");

    const res = await fetch("/excel_upload/oh_profit", {
        method: "POST",
        body: formData
    });

    if (res.ok) {
        toastr.success("OH Profit Bulk Upload Success");
        loadOHList();
    } else {
        toastr.error("Upload failed");
    }
});

<form id="ohSingleForm">

let pendingOHCreatePayload = null;

document.getElementById("ohSingleForm")
.addEventListener("submit", e => {
    e.preventDefault();

    const form = e.target;

    pendingOHCreatePayload = Object.fromEntries(
        new FormData(form).entries()
    );

    confirmOHAction("create");
});

async function performOHCreate() {
    if (!pendingOHCreatePayload) return;

    const res = await fetch("/oh/create/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(pendingOHCreatePayload)
    });

    if (res.ok) {
        toastr.success("OH Profit Created Successfully");
        document.getElementById("ohSingleForm").reset();
        loadOHList(ohCurrentPage);
    } else {
        toastr.error("Failed to create OH Profit");
    }

    pendingOHCreatePayload = null;
}

let ohCurrentPage = 1;

async function loadOHList(page = 1) {
    ohCurrentPage = page;

    const res = await fetch(`/oh/list/?page=${page}`);
    const data = await res.json();

    const tbody = document.querySelector("#ohList tbody");
    tbody.innerHTML = "";

    data.results.forEach(item => {
        tbody.innerHTML += `
        <tr data-id="${item.id}">
            <td contenteditable>${item.process_type || ""}</td>

            <td contenteditable>${item.icc_rm}</td>
            <td contenteditable>${item.icc_conv}</td>
            <td contenteditable>${item.icc_bof}</td>

            <td contenteditable>${item.rej_rm}</td>
            <td contenteditable>${item.rej_conv}</td>
            <td contenteditable>${item.rej_bof}</td>

            <td contenteditable>${item.inspection_rm}</td>
            <td contenteditable>${item.inspection_conv}</td>
            <td contenteditable>${item.inspection_bof}</td>

            <td contenteditable>${item.tmc_rm}</td>
            <td contenteditable>${item.tmc_conv}</td>
            <td contenteditable>${item.tmc_bof}</td>

            <td contenteditable>${item.design_cost_rm}</td>
            <td contenteditable>${item.design_cost_conv}</td>
            <td contenteditable>${item.design_cost_bof}</td>

            <td contenteditable>${item.oh_rm}</td>
            <td contenteditable>${item.oh_conv}</td>
            <td contenteditable>${item.oh_bof}</td>

            <td contenteditable>${item.profit_rm}</td>
            <td contenteditable>${item.profit_conv}</td>
            <td contenteditable>${item.profit_bof}</td>

            <td contenteditable>${item.warranty_cost}</td>
            <td contenteditable>${item.inbound_logistics}</td>

            <td>
                <button class="btn btn-sm btn-primary"
                    onclick="confirmOHAction('update', ${item.id}, this)">
                    Update
                </button>
            </td>
        </tr>
        `;
    });

    renderOHPagination(data.count);
}

function renderOHPagination(totalCount) {
    const totalPages = Math.ceil(totalCount / 15);
    const pagination = document.querySelector("#ohList .pagination");

    pagination.innerHTML = "";

    for (let i = 1; i <= totalPages; i++) {
        pagination.innerHTML += `
            <li class="page-item ${i === ohCurrentPage ? 'active' : ''}">
                <a class="page-link" onclick="loadOHList(${i})">${i}</a>
            </li>
        `;
    }
}

async function updateOH(btn) {
    const row = btn.closest("tr");
    const id = row.dataset.id;

    const payload = {
        process_type: row.children[0].innerText.trim(),

        icc_rm: row.children[1].innerText.trim(),
        icc_conv: row.children[2].innerText.trim(),
        icc_bof: row.children[3].innerText.trim(),

        rej_rm: row.children[4].innerText.trim(),
        rej_conv: row.children[5].innerText.trim(),
        rej_bof: row.children[6].innerText.trim(),

        inspection_rm: row.children[7].innerText.trim(),
        inspection_conv: row.children[8].innerText.trim(),
        inspection_bof: row.children[9].innerText.trim(),

        tmc_rm: row.children[10].innerText.trim(),
        tmc_conv: row.children[11].innerText.trim(),
        tmc_bof: row.children[12].innerText.trim(),

        design_cost_rm: row.children[13].innerText.trim(),
        design_cost_conv: row.children[14].innerText.trim(),
        design_cost_bof: row.children[15].innerText.trim(),

        oh_rm: row.children[16].innerText.trim(),
        oh_conv: row.children[17].innerText.trim(),
        oh_bof: row.children[18].innerText.trim(),

        profit_rm: row.children[19].innerText.trim(),
        profit_conv: row.children[20].innerText.trim(),
        profit_bof: row.children[21].innerText.trim(),

        warranty_cost: row.children[22].innerText.trim(),
        inbound_logistics: row.children[23].innerText.trim(),
    };

    const res = await fetch(`/oh/update/${id}/`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        toastr.success("OH Profit Updated");
        loadOHList(ohCurrentPage);
    } else {
        toastr.error("Update failed");
    }
}

let pendingOHAction = null;

function confirmOHAction(type, id = null, btn = null) {
    pendingOHAction = { type, id, btn };

    document.getElementById("confirmTitle").innerText =
        type === "update" ? "Confirm Update" : "Confirm Action";

    document.getElementById("confirmMessage").innerText =
        type === "update"
        ? "Are you sure you want to update this OH Profit record?"
        : "Are you sure you want to proceed?";

    $("#confirmModal").modal("show");
}

document.getElementById("confirmYesBtn")
.addEventListener("click", async () => {

    if (!pendingOHAction) return;

    if (pendingOHAction.type === "update") {
        await updateOH(pendingOHAction.btn);
    }

    if (pendingOHAction.type === "create") {
        await performOHCreate();
    }

    $("#confirmModal").modal("hide");
    pendingOHAction = null;
});
