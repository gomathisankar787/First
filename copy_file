function hideColumnByIndex(colIndex, hide) {
    const table = document.getElementById("processTableBody");
    if (!table) return;

    // Hide header
    const headerRow = table.parentElement.querySelector("thead tr");
    if (headerRow && headerRow.children[colIndex]) {
        headerRow.children[colIndex].style.display = hide ? "none" : "";
    }

    // Hide all rows' cells
    const rows = table.querySelectorAll("tr");
    rows.forEach(row => {
        if (row.children[colIndex]) {
            row.children[colIndex].style.display = hide ? "none" : "";
        }
    });
}

function processbaserows() {
    const mainProcess = document.querySelector('select[name="process"]').value;
    if (!mainProcess) return;

    const table = document.getElementById('processTableBody');
    table.innerHTML = ""; // clear all existing rows

    const processList = [
        "Shearing",
        "2nd Shearing",
        "Blanking",
        "Laser Cutting",
        "Hole Spotting",
        "Piercing",
        "Bending",
        "Forming",
        "Dressing",
        "Block_setting",
        "Setting_assy_handling"
    ];

    let exclude = [];

    // -----------------
    // COLUMN INDICES
    // -----------------
    const COL_MACHINE_TYPE = 4;
    const COL_CUTG_FRMG_LEN = 5;

    // -----------------
    // PROCESS RULES
    // -----------------
    if (mainProcess === "shearing") {
        hideColumnByIndex(COL_MACHINE_TYPE, true);
        hideColumnByIndex(COL_CUTG_FRMG_LEN, true);

        exclude = ["Laser Cutting", "Blanking"];

    } else if (mainProcess === "blanking") {
        hideColumnByIndex(COL_MACHINE_TYPE, false);
        hideColumnByIndex(COL_CUTG_FRMG_LEN, false);

        exclude = ["Shearing", "2nd Shearing", "Laser Cutting"];

    } else if (mainProcess === "laser cutting") {
        hideColumnByIndex(COL_MACHINE_TYPE, false);
        hideColumnByIndex(COL_CUTG_FRMG_LEN, false);

        exclude = ["Shearing", "2nd Shearing", "Blanking"];
    }

    // -----------------
    // Create filtered rows
    // -----------------
    const filtered = processList.filter(item => !exclude.includes(item));

    filtered.forEach(proc => {
        let row = document.createElement("tr");

        row.innerHTML = `
            <td><input style="width: 130px;"></td>
            <td><input style="width: 130px"></td>
            <td><input style="width: 130px;"></td>
            <td>
                <select>
                    <option>${proc}</option>
                </select>
            </td>
            <td>
                <select>
                    <option value="" disabled selected>Select Process</option>
                    <option>Mechanical Press - Cutting</option>
                    <option>Mechanical Press - Forming</option>
                    <option>Hydraulic Press - Cutting</option>
                    <option>Hydraulic Press - Forming</option>
                </select>
            </td>
            <td><input></td>
            <td><input></td>
            <td><input></td>
            <td>
                <select style="width: 130px;" onchange="getMachineTypeNorms(this)">
                    <option value="" disabled selected>Select Type</option>
                </select>
            </td>
            <td><input></td>
            <td><input></td>
            <td><input name="norms"></td>
            <td><input></td>
            <td><input></td>
            <td><input style="width: 130px;"></td>
            <td>
                <i class="bi bi-plus-circle btn" onclick="processaddRow(this)"></i>
                <i class="bi bi-trash btn" onclick="processdeleteRow(this)"></i>
            </td>
        `;

        table.appendChild(row);
    });
}
