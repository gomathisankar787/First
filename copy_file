function hasSMProcessData() {
    let hasValue = false;

    $('#processTableBody tr').each(function () {
        const machineType = $(this).find('select[name="machine_type"]').val();
        const cuttingFormula = $(this).find('.cutting_len_formula').val();
        const cuttingLength = $(this).find('.process-length').val();

        if (
            (machineType && machineType.trim() !== '') ||
            (cuttingFormula && cuttingFormula.trim() !== '') ||
            (cuttingLength && cuttingLength.trim() !== '')
        ) {
            hasValue = true;
            return false; // break loop
        }
    });

    return hasValue;
}
function save_material_data() {
    if (hasSMProcessData()) {
        // show confirm modal ONLY if data exists
        $('#updateConfirmModal').modal('show');
    } else {
        // directly update
        submitMaterialUpdate();
    }
}
