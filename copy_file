path('save_welding_rows/', views.SaveWeldingRows.as_view())

class SaveWeldingRowSerializer(serializers.Serializer):
    id = serializers.IntegerField(required=False, allow_null=True)
    unique_csc_id = serializers.CharField()
    part_no = serializers.CharField()
    process_description = serializers.CharField()
    no_of_operations = serializers.IntegerField()
    parts_per_cycle = serializers.IntegerField()
    remarks = serializers.CharField(required=False, allow_blank=True)

class SaveWeldingRows(generics.GenericAPIView):
    serializer_class = SaveWeldingRowSerializer

    def post(self, request):
        try:
            rows = request.data.get('rows', [])

            saved_ids = []

            for row in rows:
                serializer = self.serializer_class(data=row)
                serializer.is_valid(raise_exception=True)
                data = serializer.validated_data

                obj, created = SMProcess.objects.update_or_create(
                    id=data.get('id'),
                    defaults={
                        'unique_csc_id': data['unique_csc_id'],
                        'part_no': data['part_no'],
                        'process_description': 'Welding',
                        'no_of_operations': data['no_of_operations'],
                        'parts_per_cycle': data['parts_per_cycle'],
                        'remarks': data.get('remarks', '')
                    }
                )
                saved_ids.append(obj.id)

            return Response({
                'status': 'success',
                'saved_ids': saved_ids
            })

        except Exception as e:
            return Response(
                {'error': str(e)},
                status=status.HTTP_400_BAD_REQUEST
            )
function collectAllWeldingRows() {
    const rows = document.querySelectorAll('#weldingbody tr');
    const payload = [];

    rows.forEach(row => {
        payload.push({
            id: row.querySelector('.assy_process_description').dataset.id || null,
            unique_csc_id: CURRENT_UNIQUE_CSC_ID,   // store globally from fetch
            part_no: row.querySelector('.assy_partNumber').value,
            process_description: $(row).find('.assy_process_description').val(),
            no_of_operations: row.querySelector('.assy_no_of_operations').value,
            parts_per_cycle: row.querySelector('.assy_parts_per_cycle').value,
            remarks: row.querySelector('.assy_remarks').value
        });
    });

    return payload;
}
<button class="btn btn-primary" onclick="saveWeldingRows()">Save Welding</button>

function saveWeldingRows() {
    const rows = collectAllWeldingRows();

    fetch('/save_welding_rows/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows })
    })
    .then(res => res.json())
    .then(data => {
        alert('Welding rows saved successfully');
        console.log(data);
    })
    .catch(err => {
        console.error('Save failed', err);
        alert('Save failed');
    });
}
