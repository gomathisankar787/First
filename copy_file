# app.css
:root {
  --header-height: 64px;
  --radius: 10px;
  --gap: 12px;

  --bg: #e7f7f7;
  --surface: #f1f5f9; /* slate-100 */
  --text: #0f172a;    /* slate-900 */
  --muted: #334155;   /* slate-700 */
  --primary: #2563eb; /* blue-600 */
  --primary-hover: #1d4ed8; /* blue-700 */
  --outline: #cbd5e1; /* slate-300 */
}

/* App wrapper */
.app {
  min-height: 100%;
  display: flex;
  flex-direction: column;
}

/* Sticky header */
.app-header {
  position: sticky;
  top: 0;
  z-index: 50;
  height: var(--header-height);
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: var(--gap);
  padding: 0 16px;
  background: var(--bg);
  border-bottom: 1px solid var(--outline);
  backdrop-filter: saturate(180%) blur(6px);
}

/* Left: brand */
.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo {
  width: 250px;
  height: auto;
}

.bg-logo{
  width: 100%;
  height: 93vh;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

/* Middle: nav */
.header-nav {
  display: none; /* hidden on small screens */
  gap: 16px;
  align-items: center;
}

.nav-link {
  color: var(--muted);
  text-decoration: none;
  font-weight: 500;
  padding: 8px 10px;
  border-radius: 8px;
}

.nav-link:hover {
  background: var(--surface);
  color: var(--text);
}

/* Right: actions */
.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn {
  height: 36px;
  padding: 0 14px;
  border-radius: 8px;
  font-weight: 600;
  letter-spacing: 0.2px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 160ms ease;
}

.btn-outline {
  background: transparent;
  border-color: var(--outline);
  color: var(--text);
}

.btn-outline:hover {
  background: var(--surface);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.btn-primary:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
}

/* Main area (blank screen beneath header) */
.app-main {
  flex: 1;
  background:
    radial-gradient(900px 300px at 10% -20%, rgba(37, 99, 235, 0.08), transparent 60%),
    radial-gradient(900px 300px at 90% -20%, rgba(147, 51, 234, 0.08), transparent 60%);
}

/* Responsive: show nav on >=768px */
@media (min-width: 768px) {
  .header-nav {
    display: flex;
  }

  .app-header {
    grid-template-columns: 1fr auto auto;
    padding: 0 24px;
  }
}

