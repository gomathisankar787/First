function getRowAssyPayload(row) {
                return {
                    id: row.querySelector('.assy_cost_process_description').dataset.id || null,
                    process_description: $(row).find('.assy_cost_process_description').val(),
                    cycle_time: row.querySelector('.assy_cost_cycle_time').value,
                    MHR: row.querySelector('.assy_cost_MHR').value,
                    no_of_labour: row.querySelector('.assy_cost_no_of_labour').value,
                    labour_type: row.querySelector('.assy_cost_labour_type').value,
                    remarks: row.querySelector('.assy_cost_remarks').value
                };
            }


            document.addEventListener("input", function (e) {
                if (
                    e.target.classList.contains("assy_cost_cycle_time") ||
                    e.target.classList.contains("assy_cost_MHR") ||
                    e.target.classList.contains("assy_cost_no_of_labour")
                    // e.target.classList.contains("assy_remarks")
                ) {
                    const row = e.target.closest("tr");
                    assy_cost_calculation(getRowAssyPayload(row), row);
                }
            });

            document.addEventListener("change",function(e){
                const row = e.target.closest("select");
                if (
                    e.target.classList.contains("assy_cost_labour_type")
                ) {
                    console.log('working')
                    assy_cost_calculation(getRowAssyPayload(row), row);
                }
            })

            $(document).on('select2:select', '.assy_cost_process_description', function () {
                const row = $(this).closest('tr')[0];
                assy_cost_calculation(getRowAssyPayload(row), row);
            });

            function assy_cost_calculation(payload, row) {
                fetch("/calculate_assembly_value/", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(data => {
                    row.querySelector('.assy_cost_cycle_time').value = data.cycle_time;
                    row.querySelector('.assy_cost_MHR').value = data.MHR;
                    row.querySelector('.assy_cost_no_of_labour').value = data.no_of_labour;
                    row.querySelector('.assy_cost_labour_type').value = data.labour_type;
                    row.querySelector('.assy_cost_remarks').value = data.remarks;
                    row.querySelector('td:nth-child(7) input').value = data.machine_cost;
                    row.querySelector('td:nth-child(10) input').value = data.labour_rates;
                    row.querySelector('td:nth-child(11) input').value = data.labour_cost;
                    row.querySelector('td:nth-child(12) input').value = data.assembly_cost_per_unit;
                })
                .catch(err => console.error("Calculation error", err));
            }
