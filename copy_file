    (function() {
    const tbody = document.getElementById('bom-table-body');
    if (!tbody) return;

    // Make all rows draggable and bind events
    function bindRowDnD(row) {
        if (row.dataset.dndBound === "1") return;
        row.dataset.dndBound = "1";
        row.setAttribute("draggable", "true");

        row.addEventListener('dragstart', (e) => {
        row.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        // Firefox requires data set
        e.dataTransfer.setData('text/plain', '');
        });

        row.addEventListener('dragend', () => {
        row.classList.remove('dragging');
        reindexSerialNumbers(tbody);  // update S.No + order_index[]
        });
    }

    // Initial bind
    Array.from(tbody.rows).forEach(bindRowDnD);

    // If rows are added later, observe and bind automatically
    const observer = new MutationObserver((mutations) => {
        mutations.forEach(m => {
        m.addedNodes.forEach(node => {
            if (node.nodeType === 1 && node.tagName === 'TR') {
            bindRowDnD(node);
            }
        });
        });
    });
    observer.observe(tbody, { childList: true });

    // Calculate where to drop relative to mouse Y
    function getRowAfterY(container, y) {
        const rows = [...container.querySelectorAll('tr:not(.dragging)')];
        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
        rows.forEach((row) => {
        const rect = row.getBoundingClientRect();
        const offset = y - (rect.top + rect.height / 2);
        if (offset < 0 && offset > closest.offset) {
            closest = { offset, element: row };
        }
        });
        return closest.element;
    }

    // Rearrange rows live during dragover
    tbody.addEventListener('dragover', (e) => {
        e.preventDefault();
        const dragging = tbody.querySelector('.dragging');
        if (!dragging) return;

        const after = getRowAfterY(tbody, e.clientY);
        if (after == null) {
        tbody.appendChild(dragging);
        } else {
        tbody.insertBefore(dragging, after);
        }
    });

    // Keep S.No and hidden order_index[] aligned with visible order
    window.reindexSerialNumbers = function(tbody) {
        Array.from(tbody.rows).forEach((row, idx) => {
        const snoCell = row.querySelector('td.sno');
        if (snoCell) snoCell.textContent = String(idx + 1);
        const orderInput = row.querySelector('input.order-index');
        if (orderInput) orderInput.value = String(idx + 1);
        });
    };
    })();


