function weldingaddRow(el) {
    const currentRow = el.closest('tr');
    const tbody = document.getElementById("weldingbody");

    const newRow = document.createElement("tr");
    newRow.classList.add('rowdata');

    const processOptionsHtml = `
        <option value="">Select Process Description</option>
        ${process_description_list
            .map(item => `<option value="${item}">${item}</option>`)
            .join('')}
    `;

    newRow.innerHTML = `
        <td><input class="assy_partNumber" value="${currentRow.querySelector('.assy_partNumber').value}" disabled style="background-color: #e6e6e6;"></td>
        <td><input class="assy_place" value="${currentRow.querySelector('.assy_place').value}" disabled style="background-color: #e6e6e6;"></td>
        <td>
            <select disabled style="background-color: #e6e6e6;">
                <option>Shearing</option>
                <option>2nd Shearing</option>
                <option>Blanking</option>
                <option>Laser Cutting</option>
                <option>Hole Spotting</option>
                <option>Piercing</option>
                <option>Bending</option>
                <option>Forming</option>
                <option selected>Welding</option>
                <option>Dressing</option>
                <option>Block_setting</option>
                <option>Setting_assy_handling</option>
            </select>
        </td>
        <td><input disabled style="background-color: #e6e6e6;"></td>
        <td><input disabled style="background-color: #e6e6e6;"></td>
        <td>
            <select class="assy_process_description" name="process_description">
                ${processOptionsHtml}
            </select>
        </td>
        <td><input value="1"></td>
        <td><input value="1"></td>
        <td><input></td>
        <td><input></td>
        <td><input></td>
        <td>
            <i class="bi bi-plus-circle btn" onclick="weldingaddRow(this)"></i>
            <i class="bi bi-trash btn" onclick="weldingdeleteRow(this)"></i>
        </td>
    `;

    tbody.appendChild(newRow);

    // Reinitialize select2
    $(newRow).find('.assy_process_description').select2({
        dropdownParent: $('#AssemblyModal'),
        width: '200px',
        placeholder: 'Select Process Description',
    });
}

function weldingdeleteRow(el) {
    const row = el.closest('tr');
    const tbody = document.getElementById("weldingbody");

    // Prevent deleting the last row
    if (tbody.rows.length === 1) {
        alert("At least one welding row must exist.");
        return;
    }

    row.remove();
}
