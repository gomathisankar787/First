function openDeleteModal(button, procId) {
    deleteRowRef = button.closest('tr');
    deleteProcId = procId;

    $('#deleteProcessModal').modal('show');

    // Z-index fix for fullscreen parent
    $('#updatecscModal').css('z-index', 1040);
    $('#deleteProcessModal').css('z-index', 1050);
    $('.modal-backdrop').last().css('z-index', 1045);
}

$('#confirmProcessDeleteBtn').on('click', function () {

    if (!deleteRowRef || !deleteProcId) return;

    // 1️⃣ Remove row from UI
    deleteRowRef.remove();

    // 2️⃣ Call backend delete
    fetch('/delete_single_sm_process/', {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': '{{ csrf_token }}'
        },
        body: JSON.stringify({ id: deleteProcId })
    })
    .then(res => res.json())
    .then(() => {
        toastr.success("Row deleted successfully");
    })
    .catch(err => {
        console.error("Delete error", err);
        toastr.error("Delete failed");
    });

    // 3️⃣ Close ONLY delete modal
    $('#deleteProcessModal').modal('hide');
});
