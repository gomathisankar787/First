function formatBaseMonth(dateValue) {
    if (!dateValue) return "";

    const date = new Date(dateValue);

    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    const month = monthNames[date.getMonth()];
    const year = date.getFullYear();

    return `${month}-${year}`;
}

