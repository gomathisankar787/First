html, body {
        height: 100%;
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: #f4f6f9;
        overflow: hidden; /* prevent body scroll */
    }


#nav {
     position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: linear-gradient(90deg, #005685, #005685);
    box-shadow: 0 3px 10px rgba(0,0,0,0.15);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 24px;

}

    .navbar-brand {
        font-size: 22px;
        font-weight: 700;
        color: #ffffff !important;
        letter-spacing: 0.5px;

    }
    .navbar-nav .nav-link {
        color: #ffffff !important;
        font-size: 15px;
        margin-right: 18px;
        opacity: 0.9;

    }
    .navbar-nav .nav-link:hover {
        opacity: 1;
        text-decoration: underline;
        color:  #0fa3b1 !important;
    }

    .col-12 {
        position: absolute;
        top: 64px; /* below header */
        left: 0;
        width: 100%;
        height: calc(100vh - 64px);
        background: #ffffff;
        padding: 20px 24px;
        box-shadow: inset 0 1px 0 #e5e5e5;
        overflow: hidden; /* important */
    }

    h1 {
        font-size: 28px;
        font-weight: 700;
        color: #0969ca;
        margin-bottom: 20px;
    }
    button {
        background-color: linear-gradient(90deg, #005685, #005685);
        color: #fff;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 20px;
    }

    button:hover {
        background-color: #005685;
        transform: translateY(-2px);
    }

    .btn-danger {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .btn-danger {
        background-color: #ee5454;
        color: #fff;
        border: none;
    }
    .btn-danger:hover {
        background-color: #ee5454;
        transform: translateY(-2px);
    }

    /* Table Styling */
    .table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
    }
    .table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background:#005685;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        padding: 10px;
    }
    th, td {
        padding: 12px;
        text-align: center;
        font-size: 14px;
    }
    .table td {
    padding: 8px;
    font-size: 13px;
    border: 1px solid #e1e1e1;
    text-align: center;
}

    tr:nth-child(even) {
        background-color: #f7f9fc;
    }
    tr:hover {
        background-color: #eaf1fb;
        transition: background-color 0.3s ease;
    }

    /* Buttons inside table */
    .btn-primary, .btn-secondary {
       background:  linear-gradient(90deg, #005685, #005685);
        color: #ffffff;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 16px;
        transition: background 0.3s ease, transform 0.2s ease;
    }
    .btn-primary {
        background-color: #3498db;
        color: #fff;
        border: none;
    }
    .btn-primary:hover {
        background:  #005685;
        transform: translateY(-1px);
    }
    .btn-secondary {
        background-color: #95a5a6;
        background: #6c757d;
        color: #fff;
        border: none;
    }
    .btn-secondary:hover {
        background-color: #7f8c8d;
        transform: translateY(-2px);
    }

    .btn-danger {
    background: #d32f2f;
}

.modal-content {
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        background-color: #ffffff;
        padding: 20px;
    }

    .modal-header {
        background:  linear-gradient(90deg, #005685, #005685);
        color: #ffffff;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
    }

    .modal-title {
        font-size: 20px;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 0 0 12px 12px;
    }

    /* Form Styling */
    .form-container {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .form-group label {
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
    }

    #parttype,#project,#editproject,#editparttype{
        height: 80%;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        height: 44px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: #1f6fd2;
        box-shadow: 0 0 0 2px rgba(151,20,77,0.15);
        outline: none;
    }

    /* Buttons */
    .create-btn {
        background: linear-gradient(90deg, #005685, #005685);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-right: 10px;
    }

    .create-btn:hover {
        background: linear-gradient(90deg, #005685, #005685);
        transform: translateY(-2px);
    }

    #Editcsc:hover{
        background: #77acf5;
    }

    #deletecsc:hover{
        background: #f5b4b4;
    }

    #showcsc:hover{
        background: #bfe6f3;
    }

    .cancel-btn {
        background-color: #e4e4e4;
        color: #333;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .cancel-btn:hover {
        background-color: #cfcfcf;
        transform: translateY(-2px);
    }

    .modal-footer .btn-primary {
        background-color: #24968f;
        border: none;
    }

    .modal-footer .btn-primary:hover {
        background-color: #006955;
    }

    .table-scroll-wrapper {
    height: 100%;
    overflow-y: auto;
    padding-bottom: 20px;
}



    /* Responsive */
    @media (max-width: 768px) {
        #green {
            display: none; /* Hide sidebar on small screens */
        }
        .col-12 {
            width: 100%;
            margin: 10px;
            padding: 15px;
        }
        table {
            font-size: 12px;
        }
    }
</style>
</head>

