from rest_framework.pagination import PageNumberPagination

class StandardResultsPagination(PageNumberPagination):
    page_size = 15
    page_size_query_param = 'page_size'
    max_page_size = 50

from .pagination import StandardResultsPagination

class RMListAPIView(generics.ListAPIView):
    serializer_class = RMBaseSerializer
    pagination_class = StandardResultsPagination

    def get_queryset(self):
        return RMbase.objects.all().order_by("-updated_on")

let rmCurrentPage = 1;

async function loadRMList(page = 1) {
    rmCurrentPage = page;

    const res = await fetch(`/rm/list/?page=${page}`);
    const data = await res.json();

    const tbody = document.querySelector("#rmList tbody");
    tbody.innerHTML = "";

    data.results.forEach(item => {
        tbody.innerHTML += `
            <tr data-id="${item.id}">
                <td contenteditable>${item.category || ""}</td>
                <td contenteditable>${item.material_grade || ""}</td>
                <td contenteditable>${item.rm_rate}</td>
                <td contenteditable>${item.scrap_rate}</td>
                <td contenteditable>${item.uom || ""}</td>
                <td>${item.effective_from || ""}</td>
                <td>
                    <button class="btn btn-sm btn-primary"
                        onclick="confirmAction('update', ${item.id}, this)">
                        Update
                    </button>
                </td>
            </tr>
        `;
    });

    renderRMPagination(data.count);
}

function renderRMPagination(totalCount) {
    const totalPages = Math.ceil(totalCount / 15);
    const pagination = document.querySelector("#rmList .pagination");

    pagination.innerHTML = "";

    pagination.innerHTML += `
        <li class="page-item ${rmCurrentPage === 1 ? 'disabled' : ''}">
            <a class="page-link" onclick="loadRMList(${rmCurrentPage - 1})">Prev</a>
        </li>
    `;

    for (let i = 1; i <= totalPages; i++) {
        pagination.innerHTML += `
            <li class="page-item ${i === rmCurrentPage ? 'active' : ''}">
                <a class="page-link" onclick="loadRMList(${i})">${i}</a>
            </li>
        `;
    }

    pagination.innerHTML += `
        <li class="page-item ${rmCurrentPage === totalPages ? 'disabled' : ''}">
            <a class="page-link" onclick="loadRMList(${rmCurrentPage + 1})">Next</a>
        </li>
    `;
}

<div class="modal fade" id="confirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header bg-warning">
        <h5 class="modal-title" id="confirmTitle">Confirm Action</h5>
        <button class="close" data-dismiss="modal">&times;</button>
      </div>

      <div class="modal-body" id="confirmMessage">
        Are you sure?
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" id="confirmYesBtn">Yes</button>
      </div>

    </div>
  </div>
</div>

let pendingAction = null;

function confirmAction(type, id = null, btn = null) {
    pendingAction = { type, id, btn };

    document.getElementById("confirmTitle").innerText =
        type === "update" ? "Confirm Update" : "Confirm Action";

    document.getElementById("confirmMessage").innerText =
        type === "update"
        ? "Are you sure you want to update this RM record?"
        : "Are you sure you want to proceed?";

    $("#confirmModal").modal("show");
}


document.getElementById("confirmYesBtn").addEventListener("click", async () => {
    if (!pendingAction) return;

    if (pendingAction.type === "update") {
        await performRMUpdate(pendingAction.btn);
    }

    $("#confirmModal").modal("hide");
    pendingAction = null;
});


async function performRMUpdate(btn) {
    const row = btn.closest("tr");
    const id = row.dataset.id;

    const payload = {
        category: row.children[0].innerText.trim(),
        material_grade: row.children[1].innerText.trim(),
        rm_rate: row.children[2].innerText.trim(),
        scrap_rate: row.children[3].innerText.trim(),
        uom: row.children[4].innerText.trim(),
    };

    const res = await fetch(`/rm/update/${id}/`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        toastr.success("RM Updated Successfully");
        loadRMList(rmCurrentPage);
    } else {
        toastr.error("Update failed");
    }
}


