import React, { useState } from "react";
import { useParams } from "react-router-dom";
import "./bom.css";

const ITEMS_PER_PAGE = 8;

const Bom: React.FC = () => {
  const { cscId } = useParams();

  const [currentPage, setCurrentPage] = useState(1);

  const [rows, setRows] = useState(
    Array.from({ length: 22 }, (_, i) => ({
      sno: i + 1,
      level: "",
      partNo: "",
      rev: "",
      desc: "",
      qty: "",
      processType: "",
      scope: "",
      method: "",
      nesting: ""
    }))
  );

  const totalPages = Math.ceil(rows.length / ITEMS_PER_PAGE);
  const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
  const currentRows = rows.slice(startIndex, startIndex + ITEMS_PER_PAGE);

  const addRow = () => {
    setRows([
      ...rows,
      {
        sno: rows.length + 1,
        level: "",
        partNo: "",
        rev: "",
        desc: "",
        qty: "",
        processType: "",
        scope: "",
        method: "",
        nesting: ""
      }
    ]);
  };

  const deleteRow = (index: number) => {
    const actualIndex = startIndex + index;
    setRows(rows.filter((_, i) => i !== actualIndex));
  };

  const getPages = () => {
    const pages: (number | string)[] = [];
    if (totalPages <= 5) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      if (currentPage <= 3) pages.push(1, 2, 3, "...", totalPages);
      else if (currentPage >= totalPages - 2)
        pages.push(1, "...", totalPages - 2, totalPages - 1, totalPages);
      else
        pages.push(
          1,
          "...",
          currentPage - 1,
          currentPage,
          currentPage + 1,
          "...",
          totalPages
        );
    }
    return pages;
  };

  return (
    <div className="bom-page">

      {/* TOP CARDS */}
      <div className="bom-top">
        <div className="bom-csc-card">
          <h3>CSC Details</h3>
          <div className="bom-info-grid">
            <div><b>CSC ID:</b> {cscId}</div>
            <div><b>Part No:</b> F4J03714</div>
            <div><b>Rev:</b> #</div>
            <div><b>Description:</b> BRACKET-AIR TANK</div>
            <div><b>Estimated By:</b> parthiban.c1</div>
            <div><b>RM Base:</b> 2025</div>
            <div><b>Process Base:</b> 2025</div>
            <div><b>OH Profit Base:</b> 2025</div>
          </div>
        </div>

        <div className="bom-cost-card">
          <span>Total Estimated Cost</span>
          <h2>₹ 97.68</h2>
        </div>
      </div>

      {/* TABS */}
      <div className="bom-tabs">
        <button className="tab active">BOM</button>
        <button className="tab">BOM Summary</button>
        <button className="tab">Graph View</button>
      </div>

      {/* BOM TABLE */}
      <div className="bom-table-card">
        <div className="bom-table-header">
          <h3>BOM List</h3>
          <div className="bom-actions">
            <button className="btn btn-primary">Save BOM Data</button>
            <button className="btn btn-outline">Update BOM Data</button>
          </div>
        </div>

        <div className="bom-table-wrapper">
          <table className="bom-table">
            <thead>
              <tr>
                <th>S.No</th>
                <th>Level</th>
                <th>Part No</th>
                <th>Rev</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Process Type</th>
                <th>Scope</th>
                <th>Method</th>
                <th>Nesting</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {currentRows.map((_, index) => (
                <tr key={index}>
                  <td>{startIndex + index + 1}</td>
                  <td><input className="tbl-input" /></td>
                  <td><input className="tbl-input" /></td>
                  <td><input className="tbl-input" /></td>
                  <td><input className="tbl-input" /></td>
                  <td><input className="tbl-input" /></td>

                  <td>
                    <select className="tbl-select">
                      <option>Select</option>
                      <option>Laser</option>
                      <option>Bending</option>
                    </select>
                  </td>

                  <td>
                    <select className="tbl-select">
                      <option>Select</option>
                      <option>In Scope</option>
                      <option>Out Scope</option>
                    </select>
                  </td>

                  <td>
                    <select className="tbl-select">
                      <option>Select</option>
                      <option>Make</option>
                      <option>Buy</option>
                    </select>
                  </td>

                  <td>
                    <select className="tbl-select">
                      <option>Select</option>
                      <option>Yes</option>
                      <option>No</option>
                    </select>
                  </td>

                  <td className="action-cell">
                    <button className="icon-btn edit" title="Edit">
                      ✏️
                    </button>
                    <button
                      className="icon-btn delete"
                      title="Delete"
                      onClick={() => deleteRow(index)}
                    >
                      🗑️
                    </button>
                    <button
                      className="icon-btn add"
                      title="Add"
                      onClick={addRow}
                    >
                      ➕
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* PAGINATION */}
        <div className="pagination-bar">
          <button
            className="page-btn"
            disabled={currentPage === 1}
            onClick={() => setCurrentPage(currentPage - 1)}
          >
            Prev
          </button>

          {getPages().map((p, i) =>
            p === "..." ? (
              <span key={i} className="page-dots">…</span>
            ) : (
              <button
                key={i}
                className={`page-btn ${currentPage === p ? "active" : ""}`}
                onClick={() => setCurrentPage(p as number)}
              >
                {p}
              </button>
            )
          )}

          <button
            className="page-btn"
            disabled={currentPage === totalPages}
            onClick={() => setCurrentPage(currentPage + 1)}
          >
            Next
          </button>
        </div>
      </div>
    </div>
  );
};

export default Bom;



.bom-page {
  padding: 16px;
  height: calc(100vh - 64px);
  display: flex;
  flex-direction: column;
}

/* TOP */
.bom-top {
  display: grid;
  grid-template-columns: 1fr 260px;
  gap: 12px;
  margin-bottom: 12px;
}

/* CSC Card */
.bom-csc-card {
  background: #fff;
  padding: 14px;
  border-radius: 12px;
  box-shadow: 0 6px 16px rgba(0,0,0,0.08);
}

.bom-info-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  font-size: 12px;
}

/* COST CARD */
.bom-cost-card {
  background: #ecfeff;
  border: 1px solid #22d3ee;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  position: sticky;
  top: 80px;
}

.bom-cost-card h2 {
  color: #0f766e;
  margin-top: 6px;
}

/* Tabs */
.bom-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.tab {
  padding: 8px 14px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
  background: #fff;
  cursor: pointer;
}

.tab.active {
  background: #24968f;
  color: #fff;
}

/* TABLE CARD */
.bom-table-card {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
  padding: 12px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.bom-table-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

/* TABLE */
.bom-table-wrapper {
  flex: 1;
  overflow: auto;
}

.bom-table {
  width: 100%;
  border-collapse: collapse;
}

.bom-table th {
  background: #24968f;
  color: #fff;
  padding: 8px;
  font-size: 12px;
  position: sticky;
  top: 0;
}

.bom-table td {
  padding: 4px;
  text-align: center;
}

/* Inputs */
.tbl-input,
.tbl-select {
  width: 100%;
  padding: 6px 8px;
  font-size: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
}

.tbl-input:focus,
.tbl-select:focus {
  outline: none;
  border-color: #24968f;
  box-shadow: 0 0 0 2px rgba(36,150,143,0.15);
}

/* ACTION ICONS */
.action-cell {
  display: flex;
  gap: 6px;
  justify-content: center;
}

.icon-btn {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn.add { background: #dcfce7; }
.icon-btn.edit { background: #dbeafe; }
.icon-btn.delete { background: #fee2e2; }

/* PAGINATION */
.pagination-bar {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 8px;
}

.page-btn {
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid #cbd5e1;
  background: #fff;
}

.page-btn.active {
  background: #24968f;
  color: #fff;
}

.page-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.page-dots {
  padding: 6px;
  color: #64748b;
}

