function updateCscStatus(unique_csc_id) {

    const confirmBtn = document.getElementById("confirmReviewBtn");
    confirmBtn.disabled = true;

    fetch("/csc_status_update/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-CSRFToken": getCookie("csrftoken")
        },
        body: JSON.stringify({
            unique_csc_id: unique_csc_id
        })
    })
    .then(response => response.json())
    .then(data => {

        if (data.success) {

            toastr.success("Status moved to Review successfully");

            // Close modal
            $("#reviewConfirmModal").modal("hide");

            // Change floating total color to green
            const totalBox = document.getElementById("floatingTotal");
            totalBox.style.backgroundColor = "#198754";

            // Change Review section content
            const reviewSection = document.getElementById("reviewSection");
            reviewSection.innerHTML = `
                <label class="under-review-label">
                    <i class="bi bi-patch-check"></i>
                    <span class="question-text">Under Review</span>
                </label>
            `;

        } else {
            toastr.error(data.message || "Failed to update status");
        }

        confirmBtn.disabled = false;

    })
    .catch(error => {
        toastr.error("Something went wrong");
        confirmBtn.disabled = false;
    });
}

onclick="updateCscStatus('{{ csc_values.unique_csc_id }}')"

function getCookie(name) {
    let cookieValue = null;
    if (document.cookie && document.cookie !== "") {
        const cookies = document.cookie.split(";");
        for (let i = 0; i < cookies.length; i++) {
            const cookie = cookies[i].trim();
            if (cookie.substring(0, name.length + 1) === (name + "=")) {
                cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                break;
            }
        }
    }
    return cookieValue;
}

