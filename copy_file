class ProcessCreateAPIView(generics.CreateAPIView):
    serializer_class = ProcessBaseSerializer

    def perform_create(self, serializer):
        serializer.save(
            updated_by=os.environ.get("USERNAME", "").lower()
        )


class ProcessListAPIView(generics.ListAPIView):
    serializer_class = ProcessBaseSerializer
    pagination_class = StandardResultsPagination

    def get_queryset(self):
        return Processbase.objects.all().order_by("-updated_on")


class ProcessUpdateAPIView(generics.UpdateAPIView):
    serializer_class = ProcessBaseSerializer
    queryset = Processbase.objects.all()
    lookup_field = "id"

class ProcessBaseSerializer(serializers.ModelSerializer):
    class Meta:
        model = Processbase
        fields = "__all__"
        extra_kwargs = {
            'updated_by': {'required': False}
        }

<form id="processBulkUploadForm" method="post" enctype="multipart/form-data">

document.getElementById("processBulkUploadForm")
.addEventListener("submit", async e => {
    e.preventDefault();

    const form = e.target;

    const formData = new FormData();
    formData.append("input_excel", form.querySelector('input[type="file"]').files[0]);
    formData.append("sheet_name", "Process Base");
    formData.append("effective_from", form.querySelector('input[type="date"]').value);
    formData.append("base", "PROCESS");
    formData.append("remarks", "Bulk Upload");

    const res = await fetch("/excel_upload/oh_profit", {
        method: "POST",
        body: formData
    });

    if (res.ok) {
        toastr.success("Process Bulk Upload Success");
        loadProcessList();
    } else {
        toastr.error("Upload failed");
    }
});

<form id="processSingleForm">

let pendingProcessCreatePayload = null;

document.getElementById("processSingleForm")
.addEventListener("submit", e => {
    e.preventDefault();

    const form = e.target;

    pendingProcessCreatePayload = {
        process_category: form.children[0].querySelectorAll("input")[0].value,
        process_description: form.children[0].querySelectorAll("input")[1].value,
        norms: form.children[0].querySelectorAll("input")[2].value,
        uom: form.children[0].querySelectorAll("input")[3].value,
        effective_from: form.children[1].querySelectorAll("input")[0].value,
        source: form.children[1].querySelectorAll("input")[1].value,
        remarks: form.children[1].querySelectorAll("input")[2].value,
        base: "PROCESS"
    };

    confirmProcessAction("create");
});

async function performProcessCreate() {
    if (!pendingProcessCreatePayload) return;

    const res = await fetch("/process/create/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(pendingProcessCreatePayload)
    });

    if (res.ok) {
        toastr.success("Process Created Successfully");
        document.getElementById("processSingleForm").reset();
        loadProcessList(processCurrentPage);
    } else {
        toastr.error("Failed to create Process");
    }

    pendingProcessCreatePayload = null;
}

let processCurrentPage = 1;

async function loadProcessList(page = 1) {
    processCurrentPage = page;

    const res = await fetch(`/process/list/?page=${page}`);
    const data = await res.json();

    const tbody = document.querySelector("#prList tbody");
    tbody.innerHTML = "";

    data.results.forEach(item => {
        tbody.innerHTML += `
            <tr data-id="${item.id}">
                <td contenteditable>${item.process_category || ""}</td>
                <td contenteditable>${item.process_description || ""}</td>
                <td contenteditable>${item.norms || ""}</td>
                <td contenteditable>${item.uom || ""}</td>
                <td contenteditable>${item.source || ""}</td>
                <td>${item.effective_from || ""}</td>
                <td>
                    <button class="btn btn-sm btn-primary"
                        onclick="confirmProcessAction('update', ${item.id}, this)">
                        Update
                    </button>
                </td>
            </tr>
        `;
    });

    renderProcessPagination(data.count);
}

function renderProcessPagination(totalCount) {
    const totalPages = Math.ceil(totalCount / 15);
    const pagination = document.querySelector("#prList .pagination");

    pagination.innerHTML = "";

    for (let i = 1; i <= totalPages; i++) {
        pagination.innerHTML += `
            <li class="page-item ${i === processCurrentPage ? 'active' : ''}">
                <a class="page-link" onclick="loadProcessList(${i})">${i}</a>
            </li>
        `;
    }
}

async function updateProcess(btn) {
    const row = btn.closest("tr");
    const id = row.dataset.id;

    const payload = {
        process_category: row.children[0].innerText.trim(),
        process_description: row.children[1].innerText.trim(),
        norms: row.children[2].innerText.trim(),
        uom: row.children[3].innerText.trim(),
        source: row.children[4].innerText.trim(),
    };

    const res = await fetch(`/process/update/${id}/`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });

    if (res.ok) {
        toastr.success("Process Updated");
        loadProcessList(processCurrentPage);
    } else {
        toastr.error("Update failed");
    }
}

let pendingProcessAction = null;

function confirmProcessAction(type, id = null, btn = null) {
    pendingProcessAction = { type, id, btn };

    document.getElementById("confirmTitle").innerText =
        type === "update" ? "Confirm Update" : "Confirm Action";

    document.getElementById("confirmMessage").innerText =
        type === "update"
        ? "Are you sure you want to update this Process record?"
        : "Are you sure you want to proceed?";

    $("#confirmModal").modal("show");
}

document.getElementById("confirmYesBtn")
.addEventListener("click", async () => {

    if (!pendingProcessAction) return;

    if (pendingProcessAction.type === "update") {
        await updateProcess(pendingProcessAction.btn);
    }

    if (pendingProcessAction.type === "create") {
        await performProcessCreate();
    }

    $("#confirmModal").modal("hide");
    pendingProcessAction = null;
});
