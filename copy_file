html, body {
    height: 100%;
    margin: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f4f5f7;
}

/* Top Navbar */
#nav {
    position: fixed;
    top: 0;
    width: 100%;
    height: 64px;
    background: linear-gradient(90deg, #005685, #003f63);
    box-shadow: 0 3px 10px rgba(0,0,0,0.2);
    z-index: 1000;
}

/* Hero Section */
.hero-section {
    background: url('/static/images/image.png') no-repeat center center;
    background-size: cover;
    min-height: 100vh;
    padding-top: 64px; /* navbar height */
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

/* Dark overlay */
.hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
}

/* Card container */
.card-container {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    width: 100%;
    max-width: 1100px;
    padding: 20px;
}

/* Title */
.card-container h1 {
    font-weight: 700;
    margin-bottom: 50px;
    font-size: clamp(24px, 3vw, 38px);
}

/* Card Wrapper */
.card-wrapper {
    display: flex;
    justify-content: center;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 30px;
}

/* Navigation Cards */
.nav-card {
    background: rgba(255, 255, 255, 0.97);
    border-radius: 16px;
    padding: 30px 20px;
    width: 240px;
    min-height: 200px;
    transition: all 0.3s ease;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.nav-card i {
    font-size: 42px;
    color: #005685;
    margin-bottom: 15px;
}

#approved {
    color: #28a745;
}

.nav-card h5 {
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
}

.nav-card p {
    font-size: 14px;
}

.nav-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 35px rgba(0,0,0,0.35);
}

/* Tablet */
@media (max-width: 992px) {
    .nav-card {
        width: 220px;
    }
}

/* Mobile */
@media (max-width: 768px) {
    .card-wrapper {
        flex-direction: column;
        align-items: center;
    }

    .nav-card {
        width: 90%;
    }
}

<div class="card-wrapper">

.card-container {
    animation: fadeIn 0.8s ease-in-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}
