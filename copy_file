function saveWeldingRows() {
    const welding_rows = collectAllWeldingRows();
    const assembly_rows = collectAllAssemblyRows(); // 👈 create this like welding

    fetch('/save_welding_rows/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            welding_rows,
            assembly_rows
        })
    })
    .then(res => res.json())
    .then(data => {
        toastr.success(data.message);
        console.log(data);
    })
    .catch(err => {
        console.error('Save failed', err);
        alert('Save failed');
    });
}

class SaveWeldingRows(generics.GenericAPIView):
    serializer_class = SaveWeldingRowSerializer

    def post(self, request):
        try:
            welding_rows = request.data.get('welding_rows', [])
            assembly_rows = request.data.get('assembly_rows', [])

            welding_ids = []
            assembly_ids = []

            # -------------------------
            # Save Welding Rows
            # -------------------------
            for row in welding_rows:
                serializer = SaveWeldingRowSerializer(data=row)
                serializer.is_valid(raise_exception=True)
                data = serializer.validated_data

                obj, created = SMProcess.objects.update_or_create(
                    id=data.get('id'),
                    defaults={
                        'unique_csc_id': data['unique_csc_id'],
                        'part_no': data['part_no'],
                        'process_type': data['process_place'],
                        'process_description': 'Welding',
                        'machinetype': data['process_description'],
                        'no_of_operations': data['no_of_operations'],
                        'parts_per_cycle': data['parts_per_cycle'],
                        'norms': data['norms'],
                        'process_cost_unit': data['process_cost_unit'],
                        'remarks': data.get('remarks', '')
                    }
                )
                welding_ids.append(obj.id)

            # -------------------------
            # Save Assembly Cost Rows
            # -------------------------
            for row in assembly_rows:
                serializer = AssemblyCostSerializer(data=row)
                serializer.is_valid(raise_exception=True)
                data = serializer.validated_data

                obj, created = AssemblyCost.objects.update_or_create(
                    id=data.get('id'),
                    defaults={
                        'bom': data.get('bom'),
                        'process_description': data.get('process_description'),
                        'cycle_time': data.get('cycle_time'),
                        'MHR': data.get('MHR'),
                        'machine_cost': data.get('machine_cost'),
                        'no_of_labour': data.get('no_of_labour'),
                        'labour_type': data.get('labour_type'),
                        'labour_rates': data.get('labour_rates'),
                        'labour_cost': data.get('labour_cost'),
                        'assembly_cost_per_unit': data.get('assembly_cost_per_unit'),
                        'remarks': data.get('remarks')
                    }
                )
                assembly_ids.append(obj.id)

            return Response({
                'message': 'Welding & Assembly rows saved successfully',
                'welding_ids': welding_ids,
                'assembly_ids': assembly_ids
            })

        except Exception as e:
            return Response(
                {'error': str(e)},
                status=status.HTTP_400_BAD_REQUEST
            )

