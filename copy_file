def pick_process_for_thickness(material_thickness: float, process_qs):
    """
    material_thickness: numeric thickness from your material record (e.g., 6)
    process_qs: QuerySet of Processbase objects (or iterable with .process_description)
    required_kind: optional keyword to filter by process kind (e.g., 'shearing', 'laser cutting')
    Returns the best matching Processbase object (or None).
    """
    candidates = []
    # rx = re.compile(r'^\s*(\d+(?:\.\d+)?)\s*mm\b', re.IGNORECASE)

    for p in process_qs:
        desc = (getattr(p, "process_description", "") or "")
        print('desc',desc)
        # m = rx.search(desc)
        # print('m',m)
        # if not m:
        #     continue 
        try:
            mm_value = float(desc.group(1))
        except ValueError:
            continue
        candidates.append((mm_value, p))

    if not candidates:
        return None

    candidates.sort(key=lambda t: t[0])

    for mm_value, proc in candidates:
        if mm_value >= material_thickness:
            return proc
    return candidates[-1][1]
