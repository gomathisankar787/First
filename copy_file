import React, { useState } from "react";

interface BomRow {
  level: number;
  partNo: string;
  revision: string;
  description: string;
  qty: number;
  processType: string;
  scope: string;
  method: string;
  nesting: string;
}

const BomPage: React.FC = () => {
  const [activeTab, setActiveTab] = useState("bom");

  const [rows, setRows] = useState<BomRow[]>([
    {
      level: 1,
      partNo: "",
      revision: "",
      description: "",
      qty: 1,
      processType: "",
      scope: "",
      method: "",
      nesting: "",
    },
  ]);

  const addRow = () => {
    setRows([
      ...rows,
      {
        level: rows.length + 1,
        partNo: "",
        revision: "",
        description: "",
        qty: 1,
        processType: "",
        scope: "",
        method: "",
        nesting: "",
      },
    ]);
  };

  const updateRow = (index: number, field: keyof BomRow, value: any) => {
    const updated = [...rows];
    updated[index][field] = value;
    setRows(updated);
  };

  return (
    <>
      {/* Navbar */}
      <nav className="navbar app-navbar">
        <div className="container-fluid">
          <span className="navbar-brand fw-bold text-success">
            BOM Costing
          </span>
        </div>
      </nav>

      {/* Sidebar */}
      <div className="sidebar">
        <a href="#">Home</a>
        <a href="#">CSC</a>
        <a href="#">BOM</a>
        <a href="#">SM Material</a>
      </div>

      {/* Main Content */}
      <div className="main-content">
        {/* Tabs */}
        <ul className="nav nav-pills mb-3">
          <li className="nav-item">
            <button
              className={`nav-link ${activeTab === "bom" ? "active" : ""}`}
              onClick={() => setActiveTab("bom")}
            >
              BOM
            </button>
          </li>
          <li className="nav-item">
            <button
              className={`nav-link ${activeTab === "summary" ? "active" : ""}`}
              onClick={() => setActiveTab("summary")}
            >
              BOM Summary
            </button>
          </li>
        </ul>

        {/* BOM TAB */}
        {activeTab === "bom" && (
          <>
            <div className="d-flex justify-content-between mb-2">
              <h5>Create New BOM</h5>
              <button className="btn primary-btn" onClick={addRow}>
                <i className="bi bi-plus-circle me-1"></i>
                Add Row
              </button>
            </div>

            <table className="table table-bordered">
              <thead>
                <tr>
                  <th>S.No</th>
                  <th>Level</th>
                  <th>Part No</th>
                  <th>Rev</th>
                  <th>Description</th>
                  <th>Qty</th>
                  <th>Process</th>
                  <th>Scope</th>
                  <th>Method</th>
                  <th>Nesting</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row, i) => (
                  <tr key={i}>
                    <td>{i + 1}</td>
                    <td>
                      <input
                        type="number"
                        className="form-control"
                        value={row.level}
                        onChange={(e) =>
                          updateRow(i, "level", Number(e.target.value))
                        }
                      />
                    </td>
                    <td>
                      <input
                        className="form-control"
                        value={row.partNo}
                        onChange={(e) =>
                          updateRow(i, "partNo", e.target.value)
                        }
                      />
                    </td>
                    <td>
                      <input
                        className="form-control"
                        value={row.revision}
                        onChange={(e) =>
                          updateRow(i, "revision", e.target.value)
                        }
                      />
                    </td>
                    <td>
                      <input
                        className="form-control"
                        value={row.description}
                        onChange={(e) =>
                          updateRow(i, "description", e.target.value)
                        }
                      />
                    </td>
                    <td>
                      <input
                        type="number"
                        className="form-control"
                        value={row.qty}
                        onChange={(e) =>
                          updateRow(i, "qty", Number(e.target.value))
                        }
                      />
                    </td>
                    <td>
                      <select
                        className="form-select"
                        value={row.processType}
                        onChange={(e) =>
                          updateRow(i, "processType", e.target.value)
                        }
                      >
                        <option value="">Select</option>
                        <option value="Cutting">Cutting</option>
                        <option value="Assembly">Assembly</option>
                      </select>
                    </td>
                    <td>
                      <select
                        className="form-select"
                        value={row.scope}
                        onChange={(e) =>
                          updateRow(i, "scope", e.target.value)
                        }
                      >
                        <option value="">Select</option>
                        <option value="InHouse">InHouse</option>
                        <option value="BOF">BOF</option>
                      </select>
                    </td>
                    <td>
                      <input
                        className="form-control"
                        value={row.method}
                        onChange={(e) =>
                          updateRow(i, "method", e.target.value)
                        }
                      />
                    </td>
                    <td>
                      <select
                        className="form-select"
                        value={row.nesting}
                        onChange={(e) =>
                          updateRow(i, "nesting", e.target.value)
                        }
                      >
                        <option value="">Select</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                      </select>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}

        {/* SUMMARY TAB */}
        {activeTab === "summary" && (
          <h5>BOM Summary (API driven)</h5>
        )}
      </div>
    </>
  );
};

export default BomPage;



