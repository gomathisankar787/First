            async function sm_materialById(id) {
                bom_id = id
                if (!id) return;

                try {
                    const response = await fetch(`/ajax/sm_material/${id}/`);
                    const data = await response.json();

                    const arr = data?.sm_material_by_id || [];
                    const sm_process = data.sm_process || [];
                    const oh_profit = data.oh_profit_data || [];
                    const bom_scope = data.bom_scope || '';
                    const bom_method = data.bom_method || '';
                    const norm_values = data.norms_values || [];
                    // console.log('oh_profit',oh_profit)

                    if (Array.isArray(oh_profit) && oh_profit.length > 0) {
                    console.log('array has elements');

                    if (oh_profit[0]?.process_type === 'Assembly') {
                        populateOhProfitTable(oh_profit, norm_values[0],bom_scope,bom_method);
                    } else {
                        console.log('first item is not Assembly:', oh_profit[0]?.process_type);
                    }
                    } else {
                    console.log('oh_profit is empty or not an array');
                    }


                    if (!arr.length) {
                        console.warn("No SM Material found");
                        return;
                    }

                    const m = arr[0]; // first row
                    sm_material_by_id = m
                    setValue("editpartNumber", m.part_no);
                    setValue("editdescription", m.part_description);
                    setSelect("viewmethod", m.material_grade);
                    setValue("viewlength", m.length);
                    setValue("view_length_formula",m.length_formula);
                    setValue("viewwidth", m.width);
                    setValue("view_width_formula",m.width_formula);
                    setValue("viewthickness", m.thickness);
                    setValue("viewfinishweight",m.finish_weight);
                    setValue("view_finish_weight_formula",m.finish_weight_formula);
                    setSelect("viewprocess",m.cutting_process)
                    setValue("viewrmprice",m.rm_price_per_kg);
                    setValue("viewsheetlength",m.sheet_length);
                    setValue("viewsheetwidth",m.sheet_width);
                    setValue("viewsheetweight",m.sheet_weight);
                    setValue("viewnoofblanks",m.no_of_blanks);
                    setValue("viewblanweight",m.blank_weight);
                    setValue("viewinputweight",m.input_weight);
                    setValue("viewyield",m.yield_value);
                    setValue("viewsurfacearea",m.surface_area_part);
                    setValue("viewscrapweight",m.scrap_weight);
                    setValue("viewscrapprice",m.scrap_price);
                    setValue("viewrecovery",m.recovery_perc);
                    setValue("viewpriceperunit",m.price_per_unit);
                    setValue("viewdirectrmcost",m.direct_rm_cost);
                    setValue("viewallowancecost",m.allowance_cost);
                    setValue("viewremarks",m.remarks);

                    // optionally set fields if they exist
                    setSelect("viewmaterialgrades", m.material_grade);
                    setSelect("process", m.cutting_process);

                    getMaterialRates(data.sm_material_by_id[0].material_grade);
                    populateSMProcessTable(sm_process,data.process_base,data.process_desc,data.machine_type,data.surface_process_base_list, bom_scope, bom_method);
                    const response_oh = await fetch(`/ajax/ohprofitBosfValues/${id}/`);
                    const data_oh = await response_oh.json();
                    // console.log(data_oh.oh_profit_values)
                    if ((bom_scope === "BOSF" || bom_scope === "BOF") && (bom_method === "CSC")){
                        populateOhBOFProfitTable(data_oh.oh_profit_values,norm_values[0],bom_scope,bom_method)
                    }

                    populateOhProfitTable(oh_profit,norm_values[0],bom_scope,bom_method)

                } catch (err) {
                    console.error("Fetch error:", err);
                }

                function setValue(id, value) {
                    const el = document.getElementById(id);
                    if (el) el.value = value ?? "";
                }

                function setSelect(id, value) {
                    const el = document.getElementById(id);
                    if (el) el.value = value ?? "";
                }
            }

