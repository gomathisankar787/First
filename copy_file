from datetime import datetime
from django.db.models import F

def sort_month_year(values):
    """
    Sorts ['Dec-25', 'Oct-25', 'Nov-25'] → ['Dec-25', 'Nov-25', 'Oct-25']
    """
    return sorted(
        values,
        key=lambda x: datetime.strptime(x, "%b-%y"),
        reverse=True
    )

def mycsc(request):
    csc = CRCSCTBL.objects.all().order_by('-updated_on')
    part_types = PARTTYPETBL.objects.all()
    projects = PROJECTLISTTBL.objects.all()

    # -------- RM BASE --------
    rm_base_values = None
    rm_latest = None
    if RMbase.objects.exists():
        rm_base_values = list(
            RMbase.objects.order_by('-id')
            .values_list('base', flat=True)
            .distinct()
        )
        rm_base_values = list(dict.fromkeys(rm_base_values))  # remove duplicates
        rm_base_values = sort_month_year(rm_base_values)
        rm_latest = rm_base_values[0]

    # -------- PROCESS BASE --------
    process_base_values = None
    process_latest = None
    if Processbase.objects.exists():
        process_base_values = list(
            Processbase.objects.order_by('-id')
            .values_list('base', flat=True)
            .distinct()
        )
        process_base_values = list(dict.fromkeys(process_base_values))
        process_base_values = sort_month_year(process_base_values)
        process_latest = process_base_values[0]

    # -------- OH PROFIT BASE --------
    ohprofit_base_values = None
    ohprofit_latest = None
    if OH_ProfitData.objects.exists():
        ohprofit_base_values = list(
            OH_ProfitData.objects.order_by('-id')
            .values_list('base', flat=True)
            .distinct()
        )
        ohprofit_base_values = list(dict.fromkeys(ohprofit_base_values))
        ohprofit_base_values = sort_month_year(ohprofit_base_values)
        ohprofit_latest = ohprofit_base_values[0]

    paginator = Paginator(csc, 15)
    page_number = request.GET.get('page')
    page_obj = paginator.get_page(page_number)

    return render(request, 'test.html', {
        'page_obj': page_obj,
        'part_types': part_types,
        'projects': projects,
        'rm_base_values': rm_base_values,
        'process_base_values': process_base_values,
        'ohprofit_base_values': ohprofit_base_values,
        'rm_latest': rm_latest,
        'process_latest': process_latest,
        'ohprofit_latest': ohprofit_latest,
    })
