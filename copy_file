def UpdateSmProcess(request):
    try:  
        data = json.loads(request.body.decode('utf-8')) if request.body else request.POST
        id = data.get('id')
        value = data.get('value')
        value_type = data.get('type')

        process_base = Processbase.objects.all()
        sm_process = SMProcess.objects.filter(id=id).first()
        sm = SMMaterial.objects.filter(
                    part_no=sm_process.part_no,
                    unique_csc_id=sm_process.unique_csc_id
                ).values()
        first = sm.first()
        rm = RMbase.objects.filter(material_grade = first['material_grade']).first()
        material_thickness = first['thickness']
        if value_type == "process-desc":
            sm_process.mechanical_hydraulic = value
            sm_process.save()
            return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
        if value_type == "process-length":
            sm_process.cutting_forminglength = value
            if sm_process.process_description.lower() == 'forming':
                density = 0.75
            else:
                density = 1
            tonnage = (material_thickness * value * rm.UTS * density * 1.1) / 1000 / 9.81
            qs = process_base.filter(process_description__icontains=sm_process.mechanical_hydraulic).values_list("process_description", flat=True)
            best, norms = get_best_process(tonnage, qs, sm_process.mechanical_hydraulic)
            if norms:
                process_cost_unit = (norms * sm_process.no_of_operations) / sm_process.parts_per_cycle
            sm_process.machinetype = best
            sm_process.norms = norms
            sm_process.process_cost_unit = process_cost_unit
            sm_process.save()
            return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
        if value_type == "process-type-desc":
            sm_process.machinetype = value
            obj = Processbase.objects.filter(process_description=value).first()
            norms = obj.norms if obj else None
            if norms:
                process_cost_unit = (norms * sm_process.no_of_operations) / sm_process.parts_per_cycle
            sm_process.norms = norms
            sm_process.process_cost_unit = process_cost_unit
            sm_process.save()
            return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
        if value_type == "no_of_operation":
            process_cost_unit = (sm_process.norms * value) / sm_process.parts_per_cycle
            sm_process.no_of_operations = value
            sm_process.process_cost_unit = process_cost_unit
            sm_process.save()
            return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
        if value_type == "parts_per_cycle":
            process_cost_unit = (sm_process.norms * sm_process.no_of_operations) / value
            sm_process.parts_per_cycle = value
            sm_process.process_cost_unit = process_cost_unit
            sm_process.save()
            return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
        return JsonResponse({"status":"success","message":"SM process Data Updated Successfully"})
    except Exception as e:
        return JsonResponse({"error": str(e)}, status=500)
