            const labels = [];
            const ranges = [];
            const backgroundColors = [];
            const borderWidths = [];
            const borderColors = [];

            costData.forEach(item => {
                let start, end;

                if (item.isTotal) {
                    // Total bars start from 0
                    start = 0;
                    cumulative = item.value; // reset baseline
                    end = cumulative;
                    backgroundColors.push('rgba(0, 102, 204, 0.8)'); // dark blue
                    borderColors.push('rgb(0, 102, 204)');
                    borderWidths.push(3);
                }
                 else {
                    start = cumulative;
                    end = cumulative + item.value;
                    cumulative = end;
                    backgroundColors.push('rgba(0, 102, 204, 0.35)'); // light blue
                    borderColors.push('rgba(0, 102, 204, 0.6)');
                    borderWidths.push(1);
                }

                labels.push(item.label);
                ranges.push([start, end]);
            });

            const waterfallConnectorPlugin = {
                id: 'waterfallConnector',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const meta = chart.getDatasetMeta(0);

                    ctx.save();
                    ctx.strokeStyle = '#666';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([4, 4]);

                    for (let i = 1; i < meta.data.length; i++) {
                        const prev = meta.data[i - 1];
                        const curr = meta.data[i];

                        if(borderWidths[i] > 2 || borderWidths[i-1] > 2) continue;

                        ctx.beginPath();
                        ctx.moveTo(prev.x, prev.y);
                        ctx.lineTo(curr.x, curr.base);
                        ctx.stroke();
                    }

                    ctx.restore();
                }
            };

            const waterfallValueLabelPlugin = {
                id: 'waterfallValueLabels',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const meta = chart.getDatasetMeta(0);
                    ctx.save();
                    ctx.font = '12px sans-serif';
                    ctx.fillStyle = '#000';
                    ctx.textAlign = 'center';

                    meta.data.forEach((bar, index) => {
                        if (!bar) return;

                        const raw = chart.data.datasets[0].data[index];
                        const start = raw[0];
                        const end = raw[1];
                        const value = end - start;

                        // position above bar end
                        const x = bar.x;
                        const y = bar.y - 6;

                        // total bars (thick border)
                        const isTotal = chart.data.datasets[0].borderWidth[index] > 2;

                        const label = isTotal
                            ? `₹${Math.round(value)}`   // show cumulative total
                            : `₹${Math.round(value)}`;

                        ctx.fillText(label, x, y);
                    });

                    ctx.restore();
                }
            };

