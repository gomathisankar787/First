function clearCalculatedValues() {
    const fieldsToClear = [
        "viewrmprice",
        "viewsheetlength",
        "viewsheetwidth",
        "viewsheetweight",
        "viewnoofblanks",
        "viewblanweight",
        "viewinputweight",
        "viewsurfacearea",
        "viewscrapweight",
        "viewscrapprice",
        "viewpriceperunit",
        "viewdirectrmcost",
        "viewallowancecost"
    ];

    fieldsToClear.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = ""; // DO NOT use += — always overwrite
    });
}
