function populateSMProcessTable(processList, selectprocesslist, selectprocessdesclist) {
    const tbody = document.getElementById("processTableBody");
    tbody.innerHTML = ""; // clear existing rows

    processList.forEach(proc => {
        const row = document.createElement("tr");

        // Build Process Description Dropdown
        let processDescOptions = `<option value="">Select</option>`;
        selectprocessdesclist.forEach(desc => {
            const selected = proc.process_description === desc ? "selected" : "";
            processDescOptions += `<option value="${desc}" ${selected}>${desc}</option>`;
        });

        // Build Machine Type Dropdown
        let processTypeOptions = `<option value="">Select</option>`;
        selectprocesslist.forEach(item => {
            const selected = proc.machinetype === item.process_description ? "selected" : "";
            processTypeOptions += `<option value="${item.process_description}" ${selected}>${item.process_description}</option>`;
        });

        row.innerHTML = `
            <td><input value="${proc.part_no || ''}" style="width:110px"></td>
            <td><input value="${proc.process_type || ''}"></td>
            <td><input value="${proc.part_description || ''}"></td>

            <!-- Process Description Dropdown -->
            <td>
                <select>
                    ${processDescOptions}
                </select>
            </td>

            <td><input value="${proc.mechanical_hydraulic || ''}"></td>
            <td><input value="${proc.cutting_forminglength || ''}"></td>

            <!-- Machine Type Dropdown -->
            <td>
                <select>
                    ${processTypeOptions}
                </select>
            </td>

            <td><input value="${proc.no_of_operations || ''}"></td>
            <td><input value="${proc.parts_per_cycle || ''}"></td>
            <td><input value="${proc.norms || ''}"></td>
            <td><input value="${proc.process_cost_unit || ''}"></td>
            <td><input value="${proc.uts || ''}"></td>
            <td><input value="${proc.remarks || ''}"></td>

            <td>
                <i class="bi bi-plus-circle btn" onclick="processaddRow(this)"></i>
                <i class="bi bi-trash btn" onclick="processdeleteRow(this)"></i>
            </td>
        `;

        tbody.appendChild(row);
    });
}
