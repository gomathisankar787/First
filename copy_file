            </div>

            <div class="nav-card m-3" onclick="location.href='/listcsc'">
                <i class="bi bi-graph-up-arrow" id="approved"></i>
                <h5>List CSC</h5>
                <p class="text-muted">Approved Sheet Calculator</p>
            </div>

