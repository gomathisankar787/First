<style>
    html, body {
        height: 100%;
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: #f4f5f7;
        overflow: hidden;
    }

    /* Top Navbar */
    #nav {
        position: fixed;
        top: 0;
        width: 100%;
        height: 64px;
        background: linear-gradient(90deg, #005685, #003f63);
        box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        z-index: 1000;
    }

    /* Background section */
    .hero-section {
        background: url('/static/images/image.png') no-repeat center center/cover;
        height: 100vh;
        padding-top: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* Dark overlay */
    .hero-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
    }

    /* Card container */
    .card-container {
        position: relative;
        z-index: 2;
        text-align: center;
        color: white;
        margin-bottom: 230px;
    }

    .card-container h1 {
        font-weight: 700;
        margin-bottom: 40px;
    }

    /* Navigation Cards */
    .nav-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        padding: 30px 20px;
        width: 220px;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }

    .nav-card i {
        font-size: 40px;
        color: #005685;
        margin-bottom: 15px;
    }

    #approved{
        color: #28a745;
    }

    .nav-card h5 {
        font-weight: 600;
        color: #333;
    }

    .nav-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.35);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .nav-card {
            margin-bottom: 20px;
            width: 100%;
        }
    }
</style>

</head>

<body>
