/* Card container */
.table-card {
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
    padding: 20px;
}

/* Scrollable wrapper */
.table-wrapper {
    max-height: 420px;
    overflow-y: auto;
    overflow-x: auto;
    border-radius: 10px;
}

/* Clean table */
.custom-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
}

/* Sticky Header */
.custom-table thead th {
    position: sticky;
    top: 0;
    background: #f8f9fa;
    z-index: 10;
    font-weight: 600;
    font-size: 14px;
    border-bottom: 2px solid #dee2e6;
    padding: 12px;
}

/* Table body */
.custom-table tbody td {
    padding: 10px 12px;
    font-size: 13px;
    vertical-align: middle;
}

/* Zebra rows */
.custom-table tbody tr:nth-child(even) {
    background-color: #fafafa;
}

/* Hover effect */
.custom-table tbody tr:hover {
    background-color: #eef3ff;
}

/* Scrollbar styling */
.table-wrapper::-webkit-scrollbar {
    width: 8px;
}

.table-wrapper::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 4px;
}

.floating-total {
    position: absolute;
    right: 20px;
    top: -18px;
    background: #0d6efd;
    color: white;
    padding: 8px 18px;
    border-radius: 25px;
    font-weight: 600;
    font-size: 14px;
    box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
}

</div> <!-- table-wrapper -->

<div class="pagination-container mt-3 text-center">
