                                ${machineTypeOption}
                            </select>
                        </td>
                        <td class="process_numeric_input"><input type="text" class="cutting_len_formula process_numeric_input" name="cutting_len_formula" data-id="${proc.id}" value="${proc.cutting_formula || ''}" value=""></td>
