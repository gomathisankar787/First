<div class="flex-item button-container2 floating-total 
    {% if csc.csc_status == 'Review' %}reviewed{% endif %}">

    <div>
        Total Estimated Cost :
        <b>₹ {{ totals.total_cpa|default:0|floatformat:2 }}</b>
    </div>

    <div class="review-section mt-2">
        {% if csc.csc_status == "WIP" %}
            <a href="{% url 'move_to_review' part_no part_rev %}" 
               class="move-review-link">
               Move to Review?
            </a>
        {% elif csc.csc_status == "Review" %}
            <span class="under-review-text">
                Under Review
            </span>
        {% endif %}
    </div>

</div>

.floating-total {
    background: #0d6efd;
    color: #fff;
    padding: 14px 22px;
    border-radius: 12px;
    font-size: 14px;
    box-shadow: 0 6px 18px rgba(13,110,253,0.25);
    transition: all 0.3s ease;
}

/* When moved to review */
.floating-total.reviewed {
    background: #198754;
    box-shadow: 0 6px 18px rgba(25,135,84,0.25);
}

/* Question link */
.move-review-link {
    font-size: 12px;
    color: #fff;
    opacity: 0.85;
    text-decoration: underline;
    cursor: pointer;
}

.move-review-link:hover {
    opacity: 1;
    text-decoration: none;
}

/* Under Review text */
.under-review-text {
    font-size: 12px;
    font-weight: 500;
    opacity: 0.9;
}

path(
    'move-to-review/<str:part_no>/<str:part_rev>/',
    views.move_to_review,
    name='move_to_review'
),

from django.shortcuts import redirect, get_object_or_404
from .models import CRCSCTBL

def move_to_review(request, part_no, part_rev):
    csc = get_object_or_404(
        CRCSCTBL,
        part_num=part_no,
        rev=part_rev
    )

    # Only update if currently WIP
    if csc.csc_status == "WIP":
        csc.csc_status = "Review"
        csc.save()

    return redirect(request.META.get('HTTP_REFERER', '/'))
