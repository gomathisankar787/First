<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>BOM Page</title>

    <!-- Bootstrap + Icons -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <style>
        /* ================= GLOBAL ================= */
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden; /* 🔒 prevent page scroll */
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f7;
        }

        /* ================= NAVBAR ================= */
        #nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: #fff;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 700;
            color: #24968f !important;
            font-size: 22px;
        }

        /* ================= PAGE WRAPPER ================= */
        .page-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 15px;
            overflow: hidden;
        }

        /* ================= HEADER CARD ================= */
        .info-card {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            margin-bottom: 10px;
        }

        /* ================= TAB HEADER ================= */
        .top-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        /* ================= TAB CONTENT ================= */
        .tab-content {
            height: calc(100vh - 250px);
            display: flex;
            flex-direction: column;
        }

        /* ================= TABLE SCROLL ================= */
        .table-container {
            flex: 1;
            overflow-y: auto;   /* ✅ ONLY scroll here */
            background: #fff;
            border: 1px solid #ddd;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            position: sticky;
            top: 0;
            background: #24968f;
            color: #fff;
            z-index: 2;
            text-align: center;
        }

        th, td {
            text-align: center;
            font-size: 14px;
            padding: 6px;
            vertical-align: middle;
        }

        tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        tbody tr:hover {
            background: #eafaf9;
        }

        /* ================= PAGINATION ================= */
        .pagination-wrapper {
            position: sticky;
            bottom: 0;
            background: #fff;
            border-top: 1px solid #ddd;
            padding: 10px;
            display: flex;
            gap: 15px;
            z-index: 3;
        }

        /* ================= BUTTONS ================= */
        .btn-primary {
            background: #24968f;
            border: none;
        }

        .btn-primary:hover {
            background: #006955;
        }

        /* ================= MOBILE ================= */
        @media (max-width: 768px) {
            .tab-content {
                height: calc(100vh - 280px);
            }
            table {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-light" id="nav">
    <a class="navbar-brand" href="#">CSC</a>
</nav>

<!-- ================= PAGE ================= -->
<div class="page-wrapper">

    <!-- CSC INFO -->
    <div class="info-card">
        <div class="row">
            <div class="col-md-3">CSC ID: <b>{{ csc_values.unique_csc_id }}</b></div>
            <div class="col-md-3">PART NO: <b>{{ csc_values.part_num }}</b></div>
            <div class="col-md-2">REV: <b>{{ csc_values.rev }}</b></div>
            <div class="col-md-4">DESC: <b>{{ csc_values.desc }}</b></div>
        </div>
    </div>

    <!-- TABS + TOTAL -->
    <div class="top-actions">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <button class="nav-link active" data-toggle="pill" data-target="#bomTab">BOM</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-toggle="pill" data-target="#summaryTab">SUMMARY</button>
            </li>
        </ul>
        <div>
            Total Estimated Cost: <b>{{ totals.total_cpa|default:0|floatformat:2 }}</b>
        </div>
    </div>

    <!-- TAB CONTENT -->
    <div class="tab-content">

        <!-- ================= BOM TAB ================= -->
        <div class="tab-pane fade show active" id="bomTab">

            <!-- ACTION BUTTONS -->
            <div class="d-flex justify-content-between mb-2">
                <h5>Create New BOM</h5>
                <div>
                    <button class="btn btn-primary">Update BOM</button>
                    <button class="btn btn-primary">Save BOM</button>
                </div>
            </div>

            <!-- TABLE SCROLL -->
            <div class="table-container">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Level</th>
                            <th>Part No</th>
                            <th>Rev</th>
                            <th>Description</th>
                            <th>Qty</th>
                            <th>Process</th>
                            <th>Scope</th>
                            <th>Method</th>
                            <th>Nesting</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for values in page_obj %}
                        <tr>
                            <td>{{ forloop.counter }}</td>
                            <td><input class="form-control" value="{{ values.level }}"></td>
                            <td><input class="form-control" value="{{ values.part_no }}"></td>
                            <td><input class="form-control" value="{{ values.revision }}"></td>
                            <td><input class="form-control" value="{{ values.part_description }}"></td>
                            <td><input class="form-control" value="{{ values.qty }}"></td>
                            <td>{{ values.process_type }}</td>
                            <td>{{ values.scope }}</td>
                            <td>{{ values.method }}</td>
                            <td>{{ values.is_nesting_needed }}</td>
                            <td>
                                <i class="bi bi-pencil-square btn"></i>
                                <i class="bi bi-trash btn"></i>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            <div class="pagination-wrapper">
                {% if page_obj.has_previous %}
                    <a href="?page={{ page_obj.previous_page_number }}">Previous</a>
                {% else %}
                    <span>Previous</span>
                {% endif %}

                {% for num in page_obj.paginator.page_range %}
                    {% if page_obj.number == num %}
                        <strong>{{ num }}</strong>
                    {% else %}
                        <a href="?page={{ num }}">{{ num }}</a>
                    {% endif %}
                {% endfor %}

                {% if page_obj.has_next %}
                    <a href="?page={{ page_obj.next_page_number }}">Next</a>
                {% else %}
                    <span>Next</span>
                {% endif %}
            </div>

        </div>

        <!-- ================= SUMMARY TAB ================= -->
        <div class="tab-pane fade" id="summaryTab">
            <div class="table-container">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Cost Head</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Total Cost</td>
                            <td>{{ totals.total_cpa|default:0 }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

</body>
</html>
