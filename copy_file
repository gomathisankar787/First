from rest_framework.views import APIView
from django.http import HttpResponse
from openpyxl import Workbook
from datetime import datetime


class DownloadOhProfitSample(APIView):

    def get(self, request):
        sheet_name = request.GET.get("sheet_name", "RM Base")

        wb = Workbook()
        ws = wb.active
        ws.title = sheet_name

        if sheet_name == "RM Base":
            headers = [
                "S.No",
                "Type",
                "Category",
                "Material Grade",
                "RM Rate",
                "UOM",
                "Source",
                "Effective From",
                "Updated On",
                "Remarks",
                "Scrap Rate"
            ]

            ws.append(headers)

            ws.append([
                1,
                "Raw Material",
                "Steel",
                "EN8",
                100,
                "KG",
                "Vendor",
                "2026-01-01",
                datetime.today().date(),
                "Sample Data",
                5
            ])

        if sheet_name == "Process Base":
            headers = [
                "S.No",
                "Type",
                "Process Category",
                "Process Description",
                "Machine",
                "Norms",
                "UOM",
                "Source",
                "Effective From",
                "Updated On"
            ]

            ws.append(headers)

            ws.append([
                1,
                "Machining",
                "Turning",
                "CNC Turning",
                "CNC-01",
                2.5,
                "Hrs",
                "Internal",
                "2026-01-01",
                datetime.today().date()
            ])

        if sheet_name == "OH,Profit & Other Base":
            headers = [
                "Process Type",
                "ICC RM %",
                "ICC CONV %",
                "ICC BOF %",
                "REJ RM %",
                "REJ CONV %",
                "REJ BOF %",
                "INSPECTION RM %",
                "INSPECTION CONV %",
                "INSPECTION BOF %",
                "TMC RM %",
                "TMC CONV %",
                "TMC BOF %",
                "DESIGN RM %",
                "DESIGN CONV %",
                "DESIGN BOF %",
                "OH RM %",
                "OH CONV %",
                "OH BOF %",
                "PROFIT RM %",
                "PROFIT CONV %",
                "PROFIT BOF %",
                "Warranty %",
                "Inbound Logistics %"
            ]

            ws.append(headers)

            ws.append([
                "Inhouse",
                5,5,5,
                2,2,2,
                1,1,1,
                3,3,3,
                1,1,1,
                10,10,10,
                15,15,15,
                2,
                3
            ])

        response = HttpResponse(
            content_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        )
        response["Content-Disposition"] = f'attachment; filename="{sheet_name}_Sample.xlsx"'

        wb.save(response)
        return response

path("download-ohprofit-sample/", DownloadOhProfitSample.as_view()),

<div class="col-md-2 d-flex align-items-end">
    <button type="button" class="btn btn-success w-100"
        onclick="downloadSample('RM Base')">
        Download Sample
    </button>
</div>

<script>
function downloadSample(sheetName) {
    const url = `/download-ohprofit-sample/?sheet_name=${encodeURIComponent(sheetName)}`;

    fetch(url)
        .then(response => {
            if (!response.ok) {
                throw new Error("Download failed");
            }
            return response.blob();
        })
        .then(blob => {
            const link = document.createElement("a");
            link.href = window.URL.createObjectURL(blob);
            link.download = sheetName + "_Sample.xlsx";
            document.body.appendChild(link);
            link.click();
            link.remove();
        })
        .catch(error => {
            alert("Error downloading file");
            console.error(error);
        });
}
</script>

