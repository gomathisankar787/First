document.addEventListener("DOMContentLoaded", loadProcessBaseAndPopulate);
            let process_description_list = []
            async function loadProcessBaseAndPopulate() {
                const response = await fetch("/process_base_list/", {
                    method: "GET",
                    headers: { "Accept": "application/json" },
                });

                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                process_description_list = data
            }
const processOptionsHtml = `
                    <option value="">Select Process Description</option>
                    ${process_description_list
                        .map(item => `<option data.machine_type === item value="${item}">${item}</option>`)
                        .join('')}
                    `;
