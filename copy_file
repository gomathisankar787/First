const excelInput = document.getElementById("excelInput");
const pInput = document.getElementById("pInput");

let storedFormula = "";

// Dynamic function like Excel variable
function p() {
  return Number(pInput.value || 0);
}

// Formula evaluator
function evaluateFormula(formula) {
  if (!formula.startsWith("=")) return formula;

  const expression = formula.slice(1);

  try {
    const func = new Function("p", `return ${expression}`);
    return func(p);
  } catch (error) {
    return "Error";
  }
}

// When user leaves input → calculate
excelInput.addEventListener("blur", () => {
  const value = excelInput.value;

  if (!value.startsWith("=")) return;

  storedFormula = value;

  const result = evaluateFormula(value);

  excelInput.title = storedFormula; // Tooltip
  excelInput.value = result;
});

// When user clicks input → show formula back
excelInput.addEventListener("focus", () => {
  if (storedFormula) {
    excelInput.value = storedFormula;
  }
});

// Recalculate automatically when p changes
pInput.addEventListener("input", () => {
  if (!storedFormula) return;

  const result = evaluateFormula(storedFormula);
  excelInput.value = result;
});
