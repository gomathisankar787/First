<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="fw-bold">User Access Management</span>

    <!-- Filters -->
    <div class="d-flex gap-2 align-items-center flex-wrap">

        <!-- Search -->
        <input type="text"
               id="userSearch"
               class="form-control form-control-sm"
               style="width: 200px;"
               placeholder="Search user / email">

        <!-- Access Level Dropdown -->
        <select id="accessFilter"
                class="form-control form-control-sm"
                style="width: 160px;">
            <option value="">All Access</option>
            <option value="View">View</option>
            <option value="Download">Download</option>
            <option value="Edit">Edit</option>
            <option value="Review">Review</option>
            <option value="Admin">Admin</option>
        </select>

        <!-- Status Toggle -->
        <div class="form-check form-switch">
            <input class="form-check-input"
                   type="checkbox"
                   id="statusToggle">
            <label class="form-check-label" for="statusToggle">
                Active only
            </label>
        </div>

        <button class="btn btn-primary btn-sm"
                data-toggle="modal"
                data-target="#createUserModal">
            + Create User
        </button>

    </div>
</div>


let filteredUsers = [];

function applyFilters() {
    const searchText = document.getElementById('userSearch').value.toLowerCase().trim();
    const accessValue = document.getElementById('accessFilter').value;
    const activeOnly = document.getElementById('statusToggle').checked;

    filteredUsers = users.filter(user => {

        // Search filter
        const matchesSearch =
            user.username.toLowerCase().includes(searchText) ||
            user.email.toLowerCase().includes(searchText);

        // Access filter
        const matchesAccess =
            !accessValue ||
            (user.access_level || []).includes(accessValue);

        // Status filter
        const matchesStatus =
            !activeOnly || user.is_active;

        return matchesSearch && matchesAccess && matchesStatus;
    });

    currentPage = 1;
    renderTable();
}

document.getElementById('userSearch').addEventListener('input', applyFilters);
document.getElementById('accessFilter').addEventListener('change', applyFilters);
document.getElementById('statusToggle').addEventListener('change', applyFilters);

