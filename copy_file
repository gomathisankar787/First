 async function sm_materialById(id){
                console.log('function working',id)
                if (!id) return;

                fetch(`/ajax/sm_material/${id}/`)
                    .then(response => response.json())
                    .catch(err => console.log("Error fetching material rates", err));
                
                const data = await response.json();
                const arr = data?.sm_material_by_id || [];
                const m = arr[0];
                setValue('editmethod', m.estimation_mthd);
                setValue('length', m.length);
                setValue('width', m.width);
                setValue('thickness', m.thickness);
            
            
            function setValue(id, value) {
                const el = document.getElementById(id);
                if (el) el.value = value ?? '';
            }
            }

