document.getElementById("rmBulkUploadForm").addEventListener("submit", async e => {
        e.preventDefault();

        const formData = new FormData();
        formData.append("input_excel", document.querySelector('input[type="file"]').files[0]);
        formData.append("sheet_name", "RM Base");
        formData.append("effective_from", document.querySelector('input[type="date"]').value);
        formData.append("base", "RM");
        formData.append("remarks", "Bulk Upload");

        const res = await fetch("/excel_upload/oh_profit", {
            method: "POST",
            body: formData
        });

        if (res.ok) {
            toastr.success("RM Bulk Upload Success");
            loadRMList();
        } else {
            toastr.error("Upload failed");
        }
    });


    document.getElementById("rmSingleForm").addEventListener("submit", e => {
        e.preventDefault();

        pendingCreatePayload = {
            category: document.querySelector('[name="category"]').value,
            material_grade: document.querySelector('[name="material"]').value,
            rm_rate: document.querySelector('[name="rm_rate"]').value,
            scrap_rate: document.querySelector('[name="scrap_rate"]').value,
            uom: document.querySelector('[name="uom"]').value,
            effective_from: document.querySelector('[name="effective_from"]').value,
            source: document.querySelector('[name="source"]').value,
            remarks: document.querySelector('[name="remarks"]').value,
            base: "RM"
        };

        confirmAction("create"); // open modal
    });

    async function performRMCreate() {
        if (!pendingCreatePayload) return;

        const res = await fetch("/rm/create/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(pendingCreatePayload)
        });

        if (res.ok) {
            toastr.success("RM Created Successfully");
            document.getElementById("rmSingleForm").reset();
            loadRMList(rmCurrentPage);
        } else {
            toastr.error("Failed to create RM");
        }

        pendingCreatePayload = null;
    }

    let rmCurrentPage = 1;

    async function loadRMList(page = 1) {
        rmCurrentPage = page;

        const res = await fetch(`/rm/list/?page=${page}`);
        const data = await res.json();

        const tbody = document.querySelector("#rmList tbody");
        tbody.innerHTML = "";

        data.results.forEach(item => {
            tbody.innerHTML += `
                <tr data-id="${item.id}">
                    <td contenteditable>${item.category || ""}</td>
                    <td contenteditable>${item.material_grade || ""}</td>
                    <td contenteditable>${item.rm_rate}</td>
                    <td contenteditable>${item.scrap_rate}</td>
                    <td contenteditable>${item.uom || ""}</td>
                    <td>${item.effective_from || ""}</td>
                    <td>
                        <button class="btn btn-sm btn-primary"
                            onclick="confirmAction('update', ${item.id}, this)">
                            Update
                        </button>
                    </td>
                </tr>
            `;
        });

        renderRMPagination(data.count);
    }

    function renderRMPagination(totalCount) {
        const totalPages = Math.ceil(totalCount / 15);
        const pagination = document.querySelector("#rmList .pagination");

        pagination.innerHTML = "";

        const createPage = (page, label = page, active = false, disabled = false) => `
            <li class="page-item ${active ? 'active' : ''} ${disabled ? 'disabled' : ''}">
                <a class="page-link" onclick="${disabled ? '' : `loadRMList(${page})`}">
                    ${label}
                </a>
            </li>
        `;

        // Prev
        pagination.innerHTML += createPage(
            rmCurrentPage - 1,
            "Prev",
            false,
            rmCurrentPage === 1
        );

        // Always show first page
        pagination.innerHTML += createPage(1, 1, rmCurrentPage === 1);

        // Left dots
        if (rmCurrentPage > 4) {
            pagination.innerHTML += `
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            `;
        }

        // Middle pages
        const start = Math.max(2, rmCurrentPage - 1);
        const end = Math.min(totalPages - 1, rmCurrentPage + 1);

        for (let i = start; i <= end; i++) {
            pagination.innerHTML += createPage(i, i, i === rmCurrentPage);
        }

        // Right dots
        if (rmCurrentPage < totalPages - 3) {
            pagination.innerHTML += `
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            `;
        }

        // Always show last page (if more than one)
        if (totalPages > 1) {
            pagination.innerHTML += createPage(
                totalPages,
                totalPages,
                rmCurrentPage === totalPages
            );
        }

        // Next
        pagination.innerHTML += createPage(
            rmCurrentPage + 1,
            "Next",
            false,
            rmCurrentPage === totalPages
        );
    }

    loadRMList();

    let pendingAction = null;

    function confirmAction(type, id = null, btn = null) {
        pendingAction = { type, id, btn };

        document.getElementById("confirmTitle").innerText =
            type === "update" ? "Confirm Update" : "Confirm Action";

        document.getElementById("confirmMessage").innerText =
            type === "update"
            ? "Are you sure you want to update this RM record?"
            : "Are you sure you want to proceed?";

        $("#confirmModal").modal("show");
    }


    document.getElementById("confirmYesBtn").addEventListener("click", async () => {
        if (!pendingAction) return;

        if (pendingAction.type === "update") {
            await updateRM(pendingAction.btn);
        }

        if (pendingAction.type === "create") {
            await performRMCreate();
        }

        $("#confirmModal").modal("hide");
        pendingAction = null;
    });

    async function updateRM(btn) {
        const row = btn.closest("tr");
        const id = row.dataset.id;

        const payload = {
            category: row.children[0].innerText.trim(),
            material_grade: row.children[1].innerText.trim(),
            rm_rate: row.children[2].innerText.trim(),
            scrap_rate: row.children[3].innerText.trim(),
            uom: row.children[4].innerText.trim(),
        };

        const res = await fetch(`/rm/update/${id}/`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            toastr.success("RM Updated");
            loadRMList(rmCurrentPage);
        } else {
            toastr.error("Update failed");
        }
    }

