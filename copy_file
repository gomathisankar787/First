<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>BOM View</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f7;
        }

        /* Navbar */
        #nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: #fff;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* Page wrapper below navbar */
        .page-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 15px;
            overflow: hidden;
        }

        /* Tabs + buttons row */
        .flex-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        /* Tab content layout */
        .tab-content {
            height: calc(100vh - 280px);
            display: flex;
            flex-direction: column;
        }

        /* Scrollable table container */
        .table-container {
            flex: 1;
            overflow-y: auto;
            border: 1px solid #ddd;
        }

        /* Sticky table header */
        .table-container thead th {
            position: sticky;
            top: 0;
            background: #24968f;
            color: #fff;
            z-index: 2;
        }

        /* Sticky pagination */
        .pagination {
            position: sticky;
            bottom: 0;
            background: #fff;
            padding: 10px;
            display: flex;
            gap: 15px;
            border-top: 1px solid #ddd;
            z-index: 3;
        }

        /* Input height */
        table input,
        table select {
            height: 60px;
        }

        @media (max-width: 768px) {
            .tab-content {
                height: calc(100vh - 240px);
            }
            table {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light" id="nav">
    <a class="navbar-brand" href="#">KNOW MY COST</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse"
            data-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
            <a class="nav-item nav-link active" href="#">Home</a>
            <a class="nav-item nav-link" href="/mycsc">CSC</a>
        </div>
    </div>
</nav>

<!-- PAGE WRAPPER -->
<div class="page-wrapper">
    <div class="container-fluid h-100">
        <div class="row h-100">
            <div class="col-12">

                <!-- CSC INFO CARD -->
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-3">CSC UNIQUE ID : <b>{{csc_values.unique_csc_id}}</b></div>
                            <div class="col-3">PART NUMBER : <b>{{csc_values.part_num}}</b></div>
                            <div class="col-2">REVISION : <b>{{csc_values.rev}}</b></div>
                            <div class="col-4">DESCRIPTION : <b>{{csc_values.desc}}</b></div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-3">ESTIMATED BY : <b>{{csc_values.updated_by}}</b></div>
                            <div class="col-2">RM BASE : <b>{{csc_values.rm_base}}</b></div>
                            <div class="col-2">PROCESS BASE : <b>{{csc_values.rm_base}}</b></div>
                            <div class="col-2">OH PROFIT BASE : <b>{{csc_values.rm_base}}</b></div>
                        </div>
                    </div>
                </div>

                <!-- TABS + TOTAL -->
                <div class="flex-container">
                    <ul class="nav nav-pills">
                        <li class="nav-item mr-2">
                            <button class="nav-link active" data-toggle="pill"
                                    data-target="#pills-home">BOM</button>
                        </li>
                        <li class="nav-item mr-2">
                            <button class="nav-link" data-toggle="pill"
                                    data-target="#pills-bomsummary">BOM SUMMARY</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-toggle="pill"
                                    data-target="#graphview">GRAPH VIEW</button>
                        </li>
                    </ul>
                    <div>
                        Total Estimated Cost :
                        <b>{{totals.total_cpa|default:0|floatformat:2}}</b>
                    </div>
                </div>

                <!-- TAB CONTENT -->
                <div class="tab-content">

                    <!-- BOM TAB -->
                    <div class="tab-pane fade show active">

                        <div class="flex-container">
                            <h4>Create New BOM</h4>
                            <div>
                                <button class="btn btn-primary mr-2"
                                        onclick="updatebomdata({{csc_values.id}})">
                                    Update BOM Data
                                </button>
                                <button class="btn btn-primary"
                                        onclick="savebomdata({{csc_values.id}})">
                                    Save BOM Data
                                </button>
                            </div>
                        </div>

                        {% csrf_token %}

                        <!-- TABLE -->
                        <div class="table-container">
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Level</th>
                                    <th>Part No</th>
                                    <th>Rev</th>
                                    <th>Description</th>
                                    <th>Qty</th>
                                    <th>Process</th>
                                    <th>Scope</th>
                                    <th>Method</th>
                                    <th>Nesting</th>
                                    <th>Actions</th>
                                </tr>
                                </thead>
                                <tbody id="bom-table-body">
                                {% for values in page_obj %}
                                <tr>
                                    <td>{{ forloop.counter }}</td>
                                    <td><input class="form-control" value="{{values.level}}"></td>
                                    <td><input class="form-control" value="{{values.part_no}}"></td>
                                    <td><input class="form-control" value="{{values.revision}}"></td>
                                    <td><input class="form-control" value="{{values.part_description}}"></td>
                                    <td><input class="form-control" value="{{values.qty}}"></td>
                                    <td>{{values.process_type}}</td>
                                    <td>{{values.scope}}</td>
                                    <td>{{values.method}}</td>
                                    <td>{{values.is_nesting_needed}}</td>
                                    <td>
                                        <i class="bi bi-pencil-square btn"></i>
                                        <i class="bi bi-trash btn"></i>
                                    </td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                            <!-- PAGINATION -->
                            <div class="pagination">
                                {% if page_obj.has_previous %}
                                    <a href="?page={{page_obj.previous_page_number}}">Previous</a>
                                {% else %}
                                    <span>Previous</span>
                                {% endif %}

                                {% for num in page_obj.paginator.page_range %}
                                    {% if page_obj.number == num %}
                                        <strong>{{ num }}</strong>
                                    {% else %}
                                        <a href="?page={{ num }}">{{ num }}</a>
                                    {% endif %}
                                {% endfor %}

                                {% if page_obj.has_next %}
                                    <a href="?page={{ page_obj.next_page_number }}">Next</a>
                                {% else %}
                                    <span>Next</span>
                                {% endif %}
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
