<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createUserModalLabel">Create User</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createUserForm">
                    <div class="mb-3">
                        <label for="userName" class="form-label">User Name</label>
                        <input type="text" class="form-control" id="userName" required>
                    </div>
                    <div class="mb-3">
                        <label for="userEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="userEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="userAccess" class="form-label">Access Levels</label>
                        <select class="form-select" id="userAccess" multiple>
                            <option value="View">View</option>
                            <option value="Download">Download</option>
                            <option value="Edit">Edit</option>
                            <option value="Review">Review</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                    </div>
                    <button type="submit" class="btn btn-primary">Create</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const apiBase = '/users/';  // Adjust API base URL
    const rowsPerPage = 3;
    let users = [];
    let currentPage = 1;

    // Fetch users from API
    async function fetchUsers() {
        const res = await fetch(apiBase);
        users = await res.json();
        renderTable();
    }

    function renderTable() {
        const tableBody = document.getElementById('userTableBody');
        tableBody.innerHTML = '';
        let start = (currentPage - 1) * rowsPerPage;
        let end = start + rowsPerPage;
        const paginatedUsers = users.slice(start, end);

        paginatedUsers.forEach((user, idx) => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="userName">${user.username}</td>
                <td class="userEmail">${user.email}</td>
                <td class="userAccess">${user.access_level.map(a => `<span class="badge bg-info me-1">${a}</span>`).join('')}</td>
                <td class="userStatus"><span class="badge ${user.is_active ? 'bg-success' : 'bg-secondary'}">${user.is_active ? 'Active' : 'Inactive'}</span></td>
                <td class="text-center">
                    <button class="btn btn-sm btn-warning editBtn">✎</button>
                </td>
            `;
            tableBody.appendChild(row);
        });

        renderPagination();
        addEditListeners();
    }

    function renderPagination() {
        const pagination = document.getElementById('pagination');
        pagination.innerHTML = '';
        const totalPages = Math.ceil(users.length / rowsPerPage);

        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement('li');
            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
            li.addEventListener('click', e => {
                e.preventDefault();
                currentPage = i;
                renderTable();
            });
            pagination.appendChild(li);
        }
    }

    // Inline Edit
    function addEditListeners() {
        const editButtons = document.querySelectorAll('.editBtn');
        editButtons.forEach((btn, idx) => {
            btn.addEventListener('click', async () => {
                const rowIndex = (currentPage - 1) * rowsPerPage + idx;
                const user = users[rowIndex];
                const row = btn.closest('tr');

                row.querySelector('.userName').innerHTML = `<input type="text" class="form-control form-control-sm" value="${user.username}">`;
                row.querySelector('.userEmail').innerHTML = `<input type="email" class="form-control form-control-sm" value="${user.email}">`;
                row.querySelector('.userAccess').innerHTML = `
                    <select class="form-select form-select-sm" multiple>
                        <option value="View" ${user.access_level?.includes('View')?'selected':''}>View</option>
                        <option value="Download" ${user.access_level?.includes('Download')?'selected':''}>Download</option>
                        <option value="Edit" ${user.access_level?.includes('Edit')?'selected':''}>Edit</option>
                        <option value="Review" ${user.access_level?.includes('Review')?'selected':''}>Review</option>
                        <option value="Admin" ${user.access_level?.includes('Admin')?'selected':''}>Admin</option>
                    </select>
                `;
                row.querySelector('.userStatus').innerHTML = `
                    <select class="form-select form-select-sm">
                        <option value="true" ${user.is_active?'selected':''}>Active</option>
                        <option value="false" ${!user.is_active?'selected':''}>Inactive</option>
                    </select>
                `;
                btn.parentElement.innerHTML = `
                    <button class="btn btn-sm btn-success me-1 saveBtn">✔</button>
                    <button class="btn btn-sm btn-danger cancelBtn">❌</button>
                `;

                // Save
                row.querySelector('.saveBtn').addEventListener('click', async () => {
                    const payload = {
                        username: row.querySelector('.userName input').value,
                        email: row.querySelector('.userEmail input').value,
                        access_level: Array.from(row.querySelector('.userAccess select').selectedOptions).map(o=>o.value),
                        is_active: row.querySelector('.userStatus select').value === 'true'
                    };
                    await fetch(`${apiBase}update/${user.id}/`, {
                        method: 'PATCH',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(payload)
                    });
                    await fetchUsers();
                });

                // Cancel
                row.querySelector('.cancelBtn').addEventListener('click', fetchUsers);
            });
        });
    }

    // Create User
    document.getElementById('createUserForm').addEventListener('submit', async e => {
        e.preventDefault();
        const payload = {
            username: document.getElementById('userName').value,
            email: document.getElementById('userEmail').value,
            access_level: Array.from(document.getElementById('userAccess').selectedOptions).map(o=>o.value),
            is_active: true
        };
        await fetch(`${apiBase}create/`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        });
        document.getElementById('createUserForm').reset();
        const modal = bootstrap.Modal.getInstance(document.getElementById('createUserModal'));
        modal.hide();
        fetchUsers();
    });

    // Initial load
    fetchUsers();
</script>

