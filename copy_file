<div class="modal-body">
                <form id="createUserForm">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="userName">User Name</label>
                            <input type="text" class="form-control" id="userName" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="userEmail">Email</label>

                            <div class="input-group" >
                                <!-- user types only the local part -->
                                <input type="text"
                                    class="form-control"
                                    id="userEmail"
                                    placeholder="Enter email name"
                                    autocomplete="off"
                                    required
                                    title="Only letters, numbers and . _ % + - are allowed">
                                <div class="input-group-append">
                                <span class="input-group-text">@ashokleyland.com</span>
                                </div>
                            </div>

                        </div>
                    </div>

document.getElementById('createUserForm').addEventListener('submit', async e=>{
        e.preventDefault();
        const payload = {
            username: document.getElementById('userName').value,
            email: document.getElementById('userEmail').value,
            access_level: Array.from(document.getElementById('userAccess').selectedOptions).map(o=>o.value),
            is_active: true
        };
        try {
            const res = await fetch(`${apiBase}create/`, {
                method: 'POST',
                headers:{'Content-Type':'application/json'},
                body: JSON.stringify(payload)
            });
            if(res.ok){
                toastr.success('User created successfully');
            } else {
                toastr.error('Failed to create user');
            }
            document.getElementById('createUserForm').reset();
            $('#createUserModal').modal('hide'); // Bootstrap 4
            fetchUsers();
        } catch(err){
            toastr.error('Error creating user');
            console.error(err);
        }
    });
