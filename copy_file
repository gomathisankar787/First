<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<button type="button" class="btn btn-danger" onclick="downloadBOMPDF()">
    <i class="bi bi-download"></i> Download PDF
</button>

<div id="pdfContent" style="padding:20px; background:white;">

    <h2>BOM LIST</h2>
    <div id="pdfBomTable"></div>

    <br><br>

    <h2>BOM SUMMARY</h2>
    <div id="pdfBomSummary"></div>

    <br><br>

    <h2>GRAPH VIEW</h2>
    <canvas id="pdfChartCanvas"></canvas>

    <br><br>

    <h2>SM MATERIAL / PROCESS / OH PROFIT DETAILS</h2>
    <div id="pdfModalData"></div>

</div>

<script>
async function downloadBOMPDF() {

    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF('p', 'mm', 'a4');

    // Clone BOM TABLE
    document.getElementById("pdfBomTable").innerHTML =
        document.querySelector("#pills-home .custom-table").outerHTML;

    // Clone BOM SUMMARY
    document.getElementById("pdfBomSummary").innerHTML =
        document.querySelector("#pills-bomsummary .custom-table").outerHTML;

    // Clone Graph Data Table
    let graphTable = document.querySelector("#graphview .custom-table").outerHTML;
    document.getElementById("pdfModalData").innerHTML = graphTable;

    // Capture existing chart
    const originalChartCanvas = document.querySelector("#graphview canvas");
    const pdfCanvas = document.getElementById("pdfChartCanvas");
    const ctx = pdfCanvas.getContext("2d");
    pdfCanvas.width = originalChartCanvas.width;
    pdfCanvas.height = originalChartCanvas.height;
    ctx.drawImage(originalChartCanvas, 0, 0);

    // Capture full content
    const element = document.getElementById("pdfContent");

    const canvas = await html2canvas(element, { scale: 2 });

    const imgData = canvas.toDataURL("image/png");

    const imgWidth = 210;
    const pageHeight = 295;
    const imgHeight = canvas.height * imgWidth / canvas.width;

    let heightLeft = imgHeight;
    let position = 0;

    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
    heightLeft -= pageHeight;

    while (heightLeft >= 0) {
        position = heightLeft - imgHeight;
        pdf.addPage();
        pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;
    }

    pdf.save("BOM_Report.pdf");
}
</script>
pdf.setFontSize(16);
pdf.text("KMC - Sheet Metal Costing", 10, 10);
