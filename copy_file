function populateSMProcessTable(
    processList,
    selectprocesslist,
    selectprocessdesclist,
    machine_type,
    surface_process_base_list,
    scope,
    method
)
if (scope === "BOSF" && method === "CSC") {

    $('#processTableBody').find('.process_type').each(function () {

        const currentValue = $(this).val() || "Inhouse";

        $(this).replaceWith(`
            <select class="process_type form-control" name="process_type_bof">
                <option value="Inhouse" ${currentValue === "Inhouse" ? "selected" : ""}>Inhouse</option>
                <option value="Outsourced" ${currentValue === "Outsourced" ? "selected" : ""}>Outsourced</option>
            </select>
        `);

    });

}
populateSMProcessTable(
    processList,
    selectprocesslist,
    selectprocessdesclist,
    machine_type,
    surface_process_base_list,
    bomScope,
    bomMethod
);
