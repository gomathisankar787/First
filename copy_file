from django.core.paginator import Paginator
from django.http import JsonResponse

def mycsc(request):
    # ---------------- CSC LIST ----------------
    csc_qs = CRCSCTBL.objects.all().order_by('-updated_on')

    paginator = Paginator(csc_qs, 15)
    page_number = request.GET.get("page", 1)
    page_obj = paginator.get_page(page_number)

    csc_list = list(
        page_obj.object_list.values(
            "id",
            "part_num",
            "rev",
            "desc",
            "part_typ",
            "projects",
            "rm_base",
            "process_base",
            "oh_profit_base",
            "remarks",
            "unique_csc_id",
            "csc_status",
        )
    )

    # ---------------- PART TYPES ----------------
    part_types = list(
        PARTTYPETBL.objects.values("id", "name")
    )

    # ---------------- PROJECTS ----------------
    projects = list(
        PROJECTLISTTBL.objects.values("id", "name")
    )

    # ---------------- RM BASE ----------------
    rm_base_values = []
    rm_latest = None
    if RMbase.objects.exists():
        rm_base_values = list(
            dict.fromkeys(
                RMbase.objects.order_by('-id')
                .values_list('base', flat=True)
            )
        )
        rm_base_values = sort_month_year(rm_base_values)
        rm_latest = rm_base_values[0]

    # ---------------- PROCESS BASE ----------------
    process_base_values = []
    process_latest = None
    if Processbase.objects.exists():
        process_base_values = list(
            dict.fromkeys(
                Processbase.objects.order_by('-id')
                .values_list('base', flat=True)
            )
        )
        process_base_values = sort_month_year(process_base_values)
        process_latest = process_base_values[0]

    # ---------------- OH / PROFIT BASE ----------------
    ohprofit_base_values = []
    ohprofit_latest = None
    if OHProfitBase.objects.exists():
        ohprofit_base_values = list(
            dict.fromkeys(
                OHProfitBase.objects.order_by('-id')
                .values_list('base', flat=True)
            )
        )
        ohprofit_base_values = sort_month_year(ohprofit_base_values)
        ohprofit_latest = ohprofit_base_values[0]

    # ---------------- RESPONSE ----------------
    return JsonResponse({
        "csc_list": csc_list,
        "pagination": {
            "page": page_obj.number,
            "total_pages": paginator.num_pages,
            "total_records": paginator.count,
        },
        "part_types": part_types,
        "projects": projects,
        "rm_base": {
            "values": rm_base_values,
            "latest": rm_latest,
        },
        "process_base": {
            "values": process_base_values,
            "latest": process_latest,
        },
        "ohprofit_base": {
            "values": ohprofit_base_values,
            "latest": ohprofit_latest,
        },
    }, safe=False)
