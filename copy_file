function populateWeldingValues(dataList, partno, place) {
                const tbody = document.getElementById("weldingbody");
                tbody.innerHTML = "";

                const createRow = (data) => {
                    const row = document.createElement("tr");
                    row.classList.add('rowdata');

                    const processOptionsHtml = `
                        <option value="">Select Process Description</option>
                        ${process_description_list
                            .map(item => `<option value="${item}" ${data?.machinetype === item ? 'selected' : ''}>${item}</option>`)
                            .join('')}
                    `;

                    row.innerHTML = `
                        <td><input class="assy_partNumber" value="${data?.part_no || partno}" disabled style="background-color:#e6e6e6;"></td>
                        <td><input class="assy_place" value="${data?.process_type || place}" disabled style="background-color:#e6e6e6;"></td>
                        <td>
                            <select disabled style="background-color:#e6e6e6;">
                                <option selected>Welding</option>
                            </select>
                        </td>
                        <td><input disabled style="background-color:#e6e6e6;"></td>
                        <td><input disabled style="background-color:#e6e6e6;"></td>
                        <td>
                            <select class="assy_process_description" data-id="${data?.id || ''}">
                                ${processOptionsHtml}
                            </select>
                        </td>
                        <td><input class="assy_no_of_operations" value="${data?.no_of_operations || 1}"></td>
                        <td><input class="assy_parts_per_cycle" value="${data?.parts_per_cycle || 1}"></td>
                        <td><input class="assy_norms" disabled style="background-color:#e6e6e6;" value="${(data?.norms ?? '') != '' ? Number(data.norms).toFixed(2) : ''}"></td>
                        <td><input class="assy_process_cost_unit" disabled style="background-color:#e6e6e6;" value="${(data?.process_cost_unit ?? '') !== '' ? Number(data.process_cost_unit).toFixed(2) : ''}"></td>
                        <td><input class="assy_remarks" value="${data?.remarks || ''}"></td>
                        <td>
                            <i class="bi bi-plus-circle btn" id="showcsc" onclick="weldingaddRow(this)"></i>
                            <i class="bi bi-trash btn delete-welding" id="deletecsc" data-toggle="modal" data-id="{{data.id}}" data-target="#deleteWeldingModal"></i>
                        </td>
                    `;

                    tbody.appendChild(row);

                    // Initialize select2
                    $(row).find('.assy_process_description').select2({
                        dropdownParent: $('#AssemblyModal'),
                        width: '200px',
                        placeholder: 'Select Process Description'
                    });
                }

                // If no rows, create a default empty row
                if (!dataList || dataList.length === 0) {
                    createRow(null);
                } else {
                    dataList.forEach(data => createRow(data));
                }
            }
<div class="modal fade" id="deleteWeldingModal" tabindex="-1" role="dialog" aria-labelledby="deleteWeldingModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteWeldingModalLongTitle">Delete Bom</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            Are you sure to delete this Welding ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-danger" data-dismiss="modal" id="confirmWeldingDeleteBtn">Delete</button>
                        </div>
                        </div>
                    </div>
                </div>
document.addEventListener('click', function (e) {
                // Match clicks on the delete icon
                if (e.target && e.target.classList.contains('delete-bom')) {
                // Find the TR containing this icon
                const row = e.target.closest('tr');
                bomIdToDelete = e.target.getAttribute('data-id');
                rowToDelete = row; // store for modal confirm
                }

                if (e.target && e.target.classList.contains('delete-welding')){
                    const row = e.target.closest('tr');
                    weldingrowdelete = row;
                    weldingId = e.target.getAttribute('data-id');
                }
            });

            // Confirm delete button
            document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
                const res =fetch('/delete_bom_row/', {
                    method: 'POST', // keep as POST since your view uses POST
                    headers: {
                    'Content-Type': 'application/json',
                        // required for Django CSRF if not using JWT
                    },
                    body: JSON.stringify({ bom_id: Number(bomIdToDelete) })
                }).then(response=>{
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    toastr.success("Bom row Deleted successfully");
                })
                .catch(err => {
                    console.error("Failed to load process base:", err);
                });
                if (rowToDelete) {
                    rowToDelete.remove();
                    rowToDelete = null;
                    bomIdToDelete = null;
                    // updateSerialNumbers();
                }
            });
