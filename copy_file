html, body {
    height: 100%;
    margin: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f4f6f9;
    overflow: hidden;
}
#nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: linear-gradient(90deg, #0b4da2, #1f6fd2);
    box-shadow: 0 3px 10px rgba(0,0,0,0.15);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 24px;
}

.navbar-brand {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff !important;
}

.navbar-nav .nav-link {
    color: #eaf1fb !important;
    font-size: 15px;
    margin-right: 18px;
}

.navbar-nav .nav-link:hover {
    color: #0fa3b1 !important;
    text-decoration: none;
}
.col-12 {
    position: absolute;
    top: 64px;
    left: 0;
    width: 100%;
    height: calc(100vh - 64px);
    background: #ffffff;
    padding: 20px 24px;
    box-shadow: inset 0 1px 0 #e1e6ef;
    overflow: hidden;
}
.table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
}

.table thead th {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #0b4da2;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 10px;
}

tr:nth-child(even) {
    background-color: #f7f9fc;
}

tr:hover {
    background-color: #eaf1fb;
}
button,
.btn-primary {
    background: linear-gradient(135deg, #0b4da2, #1f6fd2);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
    transition: all 0.2s ease;
}

button:hover,
.btn-primary:hover {
    background: #083c80;
    transform: translateY(-1px);
}

.btn-secondary {
    background: #6c757d;
    color: #ffffff;
}

.btn-danger {
    background: #d32f2f;
}
.modal-content {
    border-radius: 10px;
    box-shadow: 0 10px 22px rgba(0,0,0,0.18);
    background-color: #ffffff;
}

.modal-header {
    background: linear-gradient(90deg, #0b4da2, #1f6fd2);
    color: #ffffff;
    border-bottom: none;
}

.modal-body {
    padding: 20px;
    background-color: #f4f6f9;
}


.form-group label {
    font-weight: 600;
    color: #2c3e50;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: #1f6fd2;
    box-shadow: 0 0 0 2px rgba(31,111,210,0.15);
    outline: none;
}

input:hover,
select:hover {
    border-color: #0fa3b1;
}

#Editcsc:hover {
    background: #eaf1fb;
}

#deletecsc:hover {
    background: #fdeaea;
}

#showcsc:hover {
    background: #e7f6fb;
}
.editable-field {
    background-color: #ffffff;
    border: 2px solid #1f6fd2;
}

.editable-field:focus {
    border-color: #0b4da2;
    box-shadow: 0 0 4px rgba(11,77,162,0.3);
}
