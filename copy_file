@require_http_methods(["GET"])
def showbomSmMaterial(request, id):
    try:
        bom = BOMSheet.objects.filter(id=id).first()
        if not bom:
            return JsonResponse({"error": f"No BOM found for id={id}"}, status=404)

        sm = SMMaterial.objects.filter(
            part_no=bom.part_no,
            unique_csc_id=bom.unique_csc_id
        ).values()
        sm_material = list(sm)

        if not sm:
            return JsonResponse({"error": "No SM Material found"}, status=404)

        sm_type = sm.cutting_process.lower()
        material_thickness = sm.thickness

        process_base = Processbase.objects.all()
        part_no = bom.part_no
        process_place = bom.scope
        part_description = bom.part_description
        uid = bom.unique_csc_id

        created_objects = []
        # SHEARING
        if sm_type == 'shearing':
            qs = process_base.filter(process_description__icontains="shearing").values_list("process_description", flat=True)
            best, norms = get_best_process(material_thickness, qs)
            for proc_name in ["Shearing", "2nd Shearing"]:
                shering = create_smprocess(
                    part_no, process_place, part_description,
                    proc_name, best, norms,
                    no_of_operations=7, parts_per_cycle=280,
                    unique_csc_id=uid
                )
                created_objects.append(shering)

        # BLANKING
        if sm_type == 'blanking':
            cutting_len = 520
            tonnage = (material_thickness * cutting_len * 470 * 0.75 * 1.1) / 1000 / 9.81
            qs = process_base.filter(process_description__icontains="mechanical").values_list("process_description", flat=True)
            best, norms = get_best_process(tonnage, qs, "mechanical")

            blanking = create_smprocess(
                part_no, process_place, part_description,
                "Blanking", best, norms,
                no_of_operations=1, parts_per_cycle=1,
                cutting_forminglength=cutting_len,
                mechanical_hydraulic="Mechanical",
                unique_csc_id=uid
            )
            created_objects.append(blanking)

        # LASER CUTTING
        if sm_type == 'laser cutting':
            qs = process_base.filter(process_description__icontains="laser").values_list("process_description", flat=True)
            best, norms = get_best_process(material_thickness, qs)

            laser_cutting = create_smprocess(
                part_no, process_place, part_description,
                "Laser Cutting", best, norms,
                no_of_operations=1, parts_per_cycle=1,
                unique_csc_id=uid
            )
            created_objects.append(laser_cutting)

        # HOLE SPOTTING
        best = "Laser cutting Hole spotting"
        obj = Processbase.objects.filter(process_description=best).first()
        norms = obj.norms if obj else None

        hole_spotting = create_smprocess(
            part_no, process_place, part_description,
            "Hole Spotting", best, norms,
            no_of_operations=1, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(hole_spotting)

        # PIERCING
        piercing_val = (material_thickness * 520 * 470 * 0.75 * 1.1) / 1000 / 9.81
        qs = process_base.filter(process_description__icontains="mechanical").values_list("process_description", flat=True)
        best, norms = get_best_process(piercing_val, qs)

        piercing = create_smprocess(
            part_no, process_place, part_description,
            "Piercing", best, norms,
            no_of_operations=1, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(piercing)

        # BENDING
        bending = create_smprocess(
            part_no, process_place, part_description,
            "Bending", None, None,
            no_of_operations=1, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(bending)

        # FORMING
        forming_val = (material_thickness * 520 * 470 * 0.75 * 1.1) / 1000 / 9.81
        qs = process_base.filter(process_description__icontains="mechanical").values_list("process_description", flat=True)
        best, norms = get_best_process(forming_val, qs)

        forming = create_smprocess(
            part_no, process_place, part_description,
            "Forming", best, norms,
            no_of_operations=1, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(forming)

        # DRESSING
        weight = sm.finish_weight / 2
        qs = Processbase.objects.filter(process_description="Dressing")
        norms = qs.first().norms if qs.exists() else None

        dressing = create_smprocess(
            part_no, process_place, part_description,
            "Dressing", "Dressing", norms,
            no_of_operations=weight, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(dressing)

        # BLOCK SETTING
        qs = Processbase.objects.filter(process_description="Block Setting")
        norms = qs.first().norms if qs.exists() else None

        block_setting = create_smprocess(
            part_no, process_place, part_description,
            "Block Setting", "Block Setting", norms,
            no_of_operations=weight, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(block_setting)

        # SETTING / ASSEMBLY / HANDLING
        qs = Processbase.objects.filter(process_description="Setting, Assembly & Handling")
        norms = qs.first().norms if qs.exists() else None

        setting = create_smprocess(
            part_no, process_place, part_description,
            "Setting, Assembly & Handling",
            "Setting, Assembly & Handling", norms,
            no_of_operations=weight, parts_per_cycle=1,
            unique_csc_id=uid
        )
        created_objects.append(setting)

        return JsonResponse({"sm_process": created_objects,"sm_material_by_id":sm_material}, status=200)

    except Exception as e:
        return JsonResponse({"error": str(e)}, status=500)
