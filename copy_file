                [80, 120],
                [50, 140],
                [130, 170],
            ];

            new Chart(ctx, {
                type: 'bar',
                data: { labels, datasets: [{
                label: 'CPU range (₹)',
                data: cpuRanges,
                backgroundColor: 'rgba(255, 99, 132, 0.35)',
                borderColor: 'rgb(255, 99, 132)',
                borderWidth: 1,
                borderSkipped: false,
                }]},
                options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',               // <— horizontal bars
                plugins: {
                    title: { display: true, text: 'Floating Bar — CPU Range' },
                    tooltip: {
                    callbacks: {
                        label: (ctx) => {
                        const [start, end] = ctx.raw;
                        const span = end - start;
                        return ` ${start.toFixed(2)} → ${end.toFixed(2)} (Δ ${span.toFixed(2)})`;
                        }
                    }
                    }
                },
                scales: {
                    x: { beginAtZero: true, title: { display: true, text: 'Amount (₹)' } },
                    y: { title: { display: true, text: 'Part No' } }
                }
                }
            });
            });
