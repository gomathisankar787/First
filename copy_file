<div class="flex-item button-container2">
    
    <!-- STATUS BADGE -->
    <span id="cscStatusBadge"
          class="badge px-3 py-2"
          style="font-size:13px;
                 background-color: {% if csc_status == 'WIP' %}#0d6efd{% else %}#198754{% endif %};
                 color:white;
                 border-radius:20px;">
        {{ csc_status }}
    </span>

    <!-- TOTAL -->
    <div class="floating-total">
        Total Estimated Cost :
        <b>₹ {{ totals.total_cpa|default:0|floatformat:2 }}</b>
    </div>

    <!-- MOVE TO REVIEW SECTION -->
    {% if csc_status == "WIP" %}
    <div class="review-container mt-2 text-end" id="reviewSection">
        <label class="move-review-label">
            <input type="checkbox" id="moveToReviewCheckbox">
            <span class="question-text">Move to Review?</span>
        </label>
    </div>
    {% endif %}

</div>

.button-container2 {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    position: relative;
}

.review-container {
    margin-top: 8px;
    font-size: 13px;
}

.move-review-label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-weight: 500;
    color: #444;
}

.move-review-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
}
<div class="modal fade" id="reviewConfirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Status Update</h5>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        Are you sure you want to move this to <b>Review</b>?
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button class="btn btn-success" id="confirmReviewBtn">Yes, Move</button>
      </div>
    </div>
  </div>
</div>
<script>

const checkbox = document.getElementById("moveToReviewCheckbox");

if (checkbox) {

    checkbox.addEventListener("change", function () {

        if (this.checked) {
            $("#reviewConfirmModal").modal("show");
        }
    });
}


// Confirm Button Click
document.getElementById("confirmReviewBtn")?.addEventListener("click", function () {

    fetch("/api/update-csc-status/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-CSRFToken": "{{ csrf_token }}"
        },
        body: JSON.stringify({
            status: "REVIEW",
            csc_id: "{{ csc_id }}"
        })
    })
    .then(res => res.json())
    .then(data => {

        if (data.success) {

            // Change Badge Color
            const badge = document.getElementById("cscStatusBadge");
            badge.innerText = "UNDER REVIEW";
            badge.style.backgroundColor = "#198754"; // green

            // Change Question to Message
            const questionText = document.querySelector(".question-text");
            questionText.innerText = "Under Review";

            // Disable checkbox
            checkbox.disabled = true;

            // Hide modal
            $("#reviewConfirmModal").modal("hide");

        } else {
            alert("Something went wrong");
            checkbox.checked = false;
        }

    })
    .catch(() => {
        alert("Error updating status");
        checkbox.checked = false;
    });

});

</script>
@csrf_exempt
def update_csc_status(request):
    if request.method == "POST":
        data = json.loads(request.body)
        csc_id = data.get("csc_id")

        obj = CSC.objects.get(id=csc_id)
        obj.csc_status = "REVIEW"
        obj.save()

        return JsonResponse({"success": True})
