html, body {
        height: 100%;
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(135deg, #f4f6f7, #e9ecef);
    }

    /* Navbar */
    /* #nav {
        background: #ffffff;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 10px 20px;
    } */
    
#nav {
    background: #ffffff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 10px 20px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
}

    .navbar-brand {
        font-weight: 700;
        color: #24968f !important;
        font-size: 24px;
    }
    .navbar-nav .nav-link {
        font-size: 16px;
        color: #333 !important;
        margin-right: 15px;
        transition: color 0.3s ease;
    }
    .navbar-nav .nav-link:hover {
        color: #24968f !important;
    }

    /* Sidebar */
    /* #green {
        background: #f8f9fa;
        padding: 20px;
        box-shadow: 2px 0 6px rgba(0, 0, 0, 0.1);
        font-size: 16px;
    } */

    
    #green {
        position: fixed;
        top: 60px; /* Adjust based on nav height */
        left: 0;
        width: 265px; /* Sidebar width */
        height: calc(100vh - 60px); /* Full height minus nav */
        background: #f8f9fa;
        padding: 20px;
        box-shadow: 2px 0 6px rgba(0, 0, 0, 0.1);
        font-size: 16px;
        overflow-y: auto; /* Sidebar scroll if needed */
    }

    #green a {
        display: block;
        padding: 12px 10px;
        color: #333;
        text-decoration: none;
        border-radius: 6px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }
    #green a:hover {
        background-color: #24968f;
        color: #fff;
    }

    /* Main Content */
    /* .col-10 {
        position: relative;
        background: #fff;
        padding: 30px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    } */

    
    .col-12 {
        position: absolute;
        top: 72px; /* Below nav */
        left: 0px; /* Next to sidebar */
        width: calc(335vh);
        height: calc(100vh - 60px); 
        background: #fff;
        padding: 30px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        border-radius: 5px;
        overflow-y: hidden; /* Scroll only main content */
    }
@media (max-width: 768px) {
        #green {
            display: none; /* Hide sidebar on small screens */
        }
        .col-12 {
            width: 100%;
            margin: 10px;
            padding: 15px;
        }
        table {
            font-size: 12px;
        }
    }
</style>
</head>
  
