<script>
function processbaserows() {
    const mainProcess = document.querySelector('select[name="process"]').value;
    if (!mainProcess) return;

    const table = document.getElementById('processTable').getElementsByTagName('tbody')[0];
    table.innerHTML = ""; // clear rows

    const processList = [
        "Shearing",
        "2nd Shearing",
        "Blanking",
        "Laser Cutting",
        "Hole Spotting",
        "Piercing",
        "Bending",
        "Forming",
        "Dressing",
        "Block_setting",
        "Setting_assy_handling"
    ];

    // Exclusion rules per selected process
    let exclude = [];
    if (mainProcess === "shearing") {
        exclude = ["Laser Cutting", "Blanking"]; // 2 removed ⇒ 11 - 2 = 9 rows
    } else if (mainProcess === "blanking") {
        exclude = ["Shearing", "2nd Shearing", "Laser Cutting"]; // ⇒ 8 rows
    } else if (mainProcess === "laser cutting") {
        exclude = ["Shearing", "2nd Shearing", "Blanking"]; // ⇒ 8 rows
    }

    const filtered = processList.filter(p => !exclude.includes(p));

    filtered.forEach((proc, index) => {
        const newRow = table.insertRow();
        newRow.innerHTML = `
            <td><input style="width:130px" value="${partNo}"></td>
            <td><input style="width:130px" value="${scope}"></td>
            <td><input style="width:130px" value="${part_description}"></td>
            <td>
                <select>
                    ${filtered.map(p => `
                        <option ${(index === 0 && p.toLowerCase() === mainProcess) ? "selected" : ""}>
                            ${p}
                        </option>`).join("")}
                </select>
            </td>
            <td>
                <select>
                    <option value="" disabled selected>Select Process</option>
                    <option>Mechanical Press - Cutting</option>
                    <option>Mechanical Press - Forming</option>
                    <option>Hydraulic Press - Cutting</option>
                    <option>Hydraulic Press - Forming</option>
                </select>
            </td>
            <td><input></td>
            <td><input></td>
            <td><input></td>
            <td>
                <select style="width:130px;" onchange="getMachineTypeNorms(this)">
                    <option value="" disabled selected>Select Type</option>
                    {% for m in process_base %}
                        <option value="{{ m.process_description }}">{{ m.process_description }}</option>
                    {% endfor %}
                </select>
            </td>
            <td><input></td>
            <td><input></td>
            <td><input name="norms"></td>
            <td><input></td>
            <td><input></td>
            <td><input style="width:130px;"></td>
            <td>
                <i class="bi bi-plus-circle btn" onclick="processaddRow(this)"></i>
                <i class="bi bi-trash btn" onclick="processdeleteRow(this)"></i>
            </td>
        `;
    });
}
</script>
