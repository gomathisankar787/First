html, body {
    height: 100%;
    margin: 0;
    overflow: hidden; /* 🔒 Prevent page scroll */
    font-family: 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #f4f6f7, #e9ecef);
}

/* Navbar */
#nav {
    background: #ffffff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 10px 20px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
}

/* Main content container */
.main-content {
    position: fixed;
    top: 70px;                /* navbar height */
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: #fff;
    display: flex;
    flex-direction: column;
}

/* Page header (fixed) */
.page-header {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid #ddd;
}

/* Table scroll area */
.table-wrapper {
    flex: 1;                  /* takes remaining height */
    margin-top: 15px;
    overflow-y: auto;         /* ✅ ONLY scroll here */
}

/* Sticky table header */
.table-wrapper thead th {
    position: sticky;
    top: 0;
    background: #f8f9fa;
    z-index: 2;
}

/* Pagination fixed at bottom */
.pagination {
    position: sticky;
    bottom: 0;
    background: #fff;
    padding: 10px 0;
    display: flex;
    gap: 10px;
    justify-content: center;
    border-top: 1px solid #ddd;
    z-index: 3;
}

/* Mobile */
@media (max-width: 768px) {
    table {
        font-size: 12px;
    }
}
