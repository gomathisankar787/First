/* Action column */
.action-cell {
  display: flex;
  justify-content: center;
  gap: 10px;
}

/* Action buttons */
.action-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: none;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.action-btn svg {
  width: 16px;
  height: 16px;
}

/* View */
.action-view {
  color: #2563eb;
}
.action-view:hover {
  background: #dbeafe;
}

/* Edit */
.action-edit {
  color: #059669;
}
.action-edit:hover {
  background: #d1fae5;
}

/* Delete */
.action-delete {
  color: #dc2626;
}
.action-delete:hover {
  background: #fee2e2;
}

/* Tooltip */
.action-btn {
  position: relative;
}

.action-btn::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: -32px;
  background: #0f172a;
  color: #ffffff;
  padding: 4px 8px;
  font-size: 11px;
  border-radius: 4px;
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  transition: opacity 0.2s ease;
}

.action-btn:hover::after {
  opacity: 1;
}

