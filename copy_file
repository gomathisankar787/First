function getRowPayload(row) {
                return {
                    id: row.querySelector('.assy_process_description').dataset.id,
                    process_description: $(row).find('.assy_process_description').val(),
                    no_of_operations: row.querySelector('.assy_no_of_operations').value,
                    parts_per_cycle: row.querySelector('.assy_parts_per_cycle').value,
                    remarks: row.querySelector('.assy_remarks').value
                };
            }

            document.addEventListener("input", function (e) {
                if (
                    e.target.classList.contains("assy_no_of_operations") ||
                    e.target.classList.contains("assy_parts_per_cycle")
                    // e.target.classList.contains("assy_remarks")
                ) {
                    const row = e.target.closest("tr");
                    assy_calculation(getRowPayload(row), row);
                }
            });

            document.addEventListener("blur",function(e){
                if (e.target.classList.contains("assy_remarks")){
                    const row = e.target.closest("tr");
                    assy_calculation(getRowPayload(row),row);
                }
            })

            $(document).on('select2:select', '.assy_process_description', function () {
                const row = $(this).closest('tr')[0];
                assy_calculation(getRowPayload(row), row);
            });

            function assy_calculation(payload, row) {
                fetch("/calculate_welding_value/", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(data => {
                    row.querySelector('.assy_no_of_operations').value = data.no_of_operations;
                    row.querySelector('.assy_parts_per_cycle').value = data.parts_per_cycle;
                    row.querySelector('td:nth-child(9) input').value = data.norms;
                    row.querySelector('td:nth-child(10) input').value = data.process_cost_unit;
                })
                .catch(err => console.error("Calculation error", err));
            }
