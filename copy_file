</div>

</div> <!-- table-card -->

.pagination {
    justify-content: center;
}

.pagination .page-link {
    border-radius: 8px;
    margin: 0 4px;
    color: #333;
}

.pagination .page-item.active .page-link {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
}
