function evaluateFormula(formula) {
                if (!formula || !formula.startsWith("=")) return "";

                try {
                    // Remove '=' like Excel
                    const expr = formula.substring(1);

                    // math.js supports SUM, AVG, etc.
                    return math.evaluate(expr);
                } catch (e) {
                    return "Error";
                }
                }

