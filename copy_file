html, body {
    height: 100%;
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: #f4f5f7;
    overflow: hidden; /* prevent body scroll */
}

/* =========================
   HEADER (Axis Bank style)
   ========================= */
#nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: linear-gradient(90deg, #97144d, #b01c56);
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 24px;
}

.navbar-brand {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff !important;
    letter-spacing: 0.5px;
}

.navbar-nav .nav-link {
    color: #ffffff !important;
    font-size: 15px;
    margin-right: 18px;
    opacity: 0.9;
}

.navbar-nav .nav-link:hover {
    opacity: 1;
    text-decoration: underline;
}

/* =========================
   MAIN CONTENT AREA
   ========================= */
.col-10 {
    position: absolute;
    top: 64px; /* below header */
    left: 0;
    width: 100%;
    height: calc(100vh - 64px);
    background: #ffffff;
    padding: 20px 24px;
    box-shadow: inset 0 1px 0 #e5e5e5;
    overflow: hidden; /* important */
}

/* =========================
   SCROLLABLE TABLE AREA
   ========================= */
.table-scroll-wrapper {
    height: 100%;
    overflow-y: auto;
    padding-bottom: 20px;
}

/* =========================
   TABLE STYLING (Bank UI)
   ========================= */
.table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
}

.table thead th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #97144d;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 10px;
}

.table td {
    padding: 8px;
    font-size: 13px;
    border: 1px solid #e1e1e1;
    text-align: center;
}

.table tr:nth-child(even) {
    background-color: #fafafa;
}

.table tr:hover {
    background-color: #f3e6ec;
}

/* =========================
   BUTTONS (Axis feel)
   ========================= */
button,
.btn-primary {
    background: linear-gradient(135deg, #97144d, #b01c56);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
    transition: background 0.3s ease, transform 0.2s ease;
}

button:hover,
.btn-primary:hover {
    background: linear-gradient(135deg, #7d103f, #97144d);
    transform: translateY(-1px);
}

.btn-secondary {
    background: #6c757d;
    color: #ffffff;
}

.btn-danger {
    background: #d32f2f;
}

/* =========================
   MODAL CLEANUP
   ========================= */
.modal-header {
    background: linear-gradient(90deg, #97144d, #b01c56);
    color: #ffffff;
    border-bottom: none;
}

.modal-title {
    font-size: 18px;
    font-weight: 600;
}

.modal-content {
    border-radius: 6px;
}

/* =========================
   FORM INPUTS
   ========================= */
.form-group input,
.form-group select,
.form-group textarea {
    height: 44px;
    border-radius: 4px;
    border: 1px solid #ccc;
    font-size: 14px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #97144d;
    box-shadow: 0 0 0 2px rgba(151,20,77,0.15);
    outline: none;
}

/* =========================
   REMOVE SIDEBAR COMPLETELY
   ========================= */
#green {
    display: none !important;
}

/* =========================
   RESPONSIVE
   ========================= */
@media (max-width: 768px) {
    #nav {
        height: 56px;
    }

    .col-10 {
        top: 56px;
        padding: 15px;
    }

    .table thead th {
        font-size: 12px;
    }
}
