    <div class="container-fluid h-100">
        <div class="row h-100">
            <div class="col-12" style="text-align: justify;">
                <div class="row justify-content-between">
                    <h1 class="col-auto">CSC List</h1>
                    <button type="button" class="col-auto btn btn-primary" data-toggle="modal" data-target="#exampleModalCenter">Create New CSC</button>
                </div>
                <div class="table-scroll-wrapper">
                    <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Part Name</th>
                            <th>Part Rev</th>
                            <th>Part Description</th>
                            <th>Part Type</th>
                            <th>Estimated On</th>
                            <th>Estimated By</th>
                            <th>Unique CSC ID</th>
                            <th>CSC Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for values in page_obj %}
                        <tr>
                            <td>{{values.part_num}}</td>
                            <td>{{values.rev}}</td>
                            <td>{{values.desc}}</td>
                            <td>{{values.part_typ.parttype_name}}</td>
                            <td>{{values.rm_base}}</td>
                            <td>{{values.updated_by}}</td>
                            <td>{{values.unique_csc_id}}</td>
                            <td>{{values.csc_status}}</td>
                        <td><i class="bi bi-eye btn" id="showcsc" onclick="uniquecscview({{values.id}})"></i> <i class="bi bi-pencil-square btn" id="Editcsc" data-toggle="modal" data-target="#updatecscModal"
                        data-id="{{ values.id }}"
                        data-partnum="{{ values.part_num }}"
                        data-rev="{{ values.rev }}"
                        data-desc="{{ values.desc }}"
                        data-parttyp="{{ values.part_typ_id }}"
                        data-project="{{ values.projects_id}}"
                        data-rmbase="{{ values.rm_base}}"
                        data-processbase="{{ values.process_base }}"
                        data-ohprofitbase="{{ values.oh_profit_base }}"
                        data-remarks="{{ values.remarks }}"></i> <i class="bi bi-trash btn" id="deletecsc" onclick="deleteCSC(this,{{ values.id }})"></i></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

            <!-- Pagination Controls -->
                <div class="pagination" style="display: flex; gap: 10px;">
                    <!-- previous button -->
                    {% if page_obj.has_previous %}
                        <a href="?page={{page_obj.previous_page_number}}">Previous</a>
                    {% else %}
                        <span style="opacity: 0.5;">Previous</span>
                    {% endif %}
                    <!-- page numbers -->
                    {% for num in page_obj.paginator.page_range %}
                        {% if page_obj.number == num %}
                            <strong>{{ num }}</strong>
                        {% else %}
                            <a href="?page={{ num }}">{{num}}</a>
                        {% endif %}
                    {% endfor %}
                    <!-- next button -->
                    {% if page_obj.has_next %}
                        <a href="?page={{ page_obj.next_page_number }}">Next</a>
                    {% else %}
                        <span style="opacity:0.5;">Next</span>
                    {% endif %}
                </div>
            </div>
            </div>
        </div>
    </div>
        <!-- create CSC Modal -->
        <div class="modal fade" id="exampleModalCenter" tabindex="-1" data-backdrop="static" data-keyboard="false" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Create new CSC</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closeModal()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-container">
                        <form class="create-csc-form" method="post" action="">
                        {% csrf_token %}
                        <div class="form-row">
                            <div class="form-group mr-2">
                                <label for="partNumber">Part Number</label>
                                <input type="text" id="partNumber" name="part_num" >
                            </div>
                            <div class="form-group ml-4">
                                <label for="revision">Revision</label>
                                <input type="text" id="revision" name="rev" >
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea class="formDescription" id="description" name="desc"></textarea>
                        </div>

                <!-- Add Part Type Button -->
                        <div class="form-group" style="display: flex;">
                            <label for="parttype" style="flex: 1; display: flex;">Part type</label>
                            <div style="flex: 5; display: flex;">
                                <select id="parttype" name="part_typ" class="form-control" style="flex: 1;">
                                    <option value="" disabled selected>--- Select Part Type ---</option>
                                    {% for part_type in part_types %}
                                        <option value="{{ part_type.id }}">{{ part_type.parttype_name }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" id="parttypebutton" class="btn btn-primary" style="margin-left: 10px; width: 150px;" data-toggle="modal" data-target="#addPartTypeModal">Add PartType</button>
                            </div>
                        </div>

                        <div class="form-group" style="display: flex;">
                            <label for="project" style="flex: 1;">Project</label>
                            <div style="flex: 5; display: flex;">
                                <select id="project" name="projects" class="form-control" style="flex: 1;">
                                    <option value="" disabled selected> ---Select Project--- </option>
                                    {% for project in projects %}
                                        <option value="{{ project.id }}">{{ project.projects_name }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" id="projectbutton" class="btn btn-primary" style="margin-left: 10px; width: 150px;" data-bs-toggle="modal" data-bs-target="#addProjectModal">Add Project</button>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="rmmaster">Rm Base Date</label>
                            <select id="rmmaster" name="rm_base">
                                {% for base in rm_base_values %}
                                    <option value="{{ base }}" {% if base == rm_latest %}selected{% endif %}>
                                        {{ base }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="processmaster">Process Base Date</label>
                            <select id="processmaster" name="process_base">
                                {% for base in process_base_values %}
                                    <option value="{{ base }}" {% if base == process_latest %}selected{% endif %}>
                                        {{ base }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="form-group">
                        <label for="ohprofit">OH Profit & Other Cost Base</label>
                        <select id="ohprofit" name="oh_profit_base">
                            {% for base in ohprofit_base_values %}
                                <option value="{{ base }}" {% if base == ohprofit_latest %}selected{% endif %}>
                                    {{ base }}
                                </option>
                            {% endfor %}
                        </select>
                        </div>

                        <div class="form-group">
                            <label for="remarks">Remarks</label>
                            <input type="text" id="remarks" name="remarks">
                        </div>
                    </form>
                </div>
                </div>
