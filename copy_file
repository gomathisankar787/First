<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
    <div id="deleteConfirmToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-danger text-white">
            <strong class="me-auto">Confirm Delete</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            <p class="mb-2">Are you sure you want to delete this process?</p>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-sm btn-secondary" onclick="hideDeleteToast()">Cancel</button>
                <button class="btn btn-sm btn-danger" onclick="confirmDeleteProcess()">Delete</button>
            </div>
        </div>
    </div>
</div>
let deleteRowRef = null;
let deleteProcId = null;
let deleteToast = null;

function showDeleteToast(button, procId) {
    deleteRowRef = button.closest('tr');
    deleteProcId = procId;

    const toastEl = document.getElementById('deleteConfirmToast');
    deleteToast = new bootstrap.Toast(toastEl, { autohide: false });
    deleteToast.show();
}

function hideDeleteToast() {
    if (deleteToast) deleteToast.hide();
}

function confirmDeleteProcess() {
    // Remove row from UI
    if (deleteRowRef) {
        deleteRowRef.remove();
    }

    // Optional: AJAX delete
    /*
    $.ajax({
        url: `/delete-process/${deleteProcId}/`,
        type: 'POST',
        headers: { 'X-CSRFToken': csrftoken },
        success: function () {
            console.log('Deleted successfully');
        }
    });
    */

    hideDeleteToast();
}
