    const MAX_ROWS = 150;

    function showInsertMenu(trigger) {
    const tableBody = document.getElementById("bom-table-body");
    if (!tableBody) return;

    // Enforce max rows
    if (tableBody.rows.length >= MAX_ROWS) {
        alert(`Maximum of ${MAX_ROWS} rows allowed.`);
        return;
    }

    // Remove any existing menu first
    const existing = document.getElementById("insert-menu");
    if (existing) existing.remove();

    // Create menu container
    const menu = document.createElement("div");
    menu.id = "insert-menu";
    menu.className = "insert-menu";
    menu.innerHTML = `
        <button type="button" data-pos="above">➕ Insert Above</button>
        <button type="button" data-pos="below">➕ Insert Below</button>
    `;
    document.body.appendChild(menu);

    // Position menu near the icon
    const rect = trigger.getBoundingClientRect();
    const top = rect.bottom + window.scrollY + 6;
    const left = rect.left + window.scrollX;
    menu.style.top = `${top}px`;
    menu.style.left = `${left}px`;

    // Find current row (if the icon is inside a row)
    let currentRow = trigger.closest("tr");

    // Click handlers
    menu.addEventListener("click", (e) => {
        const btn = e.target.closest("button");
        if (!btn) return;
        const pos = btn.getAttribute("data-pos"); // "above" | "below"
        menu.remove();

        insertRowRelative(tableBody, currentRow, pos);
    });

    // Close menu on outside click / ESC
    const closeMenu = (evt) => {
        if (!menu.contains(evt.target) && evt.target !== trigger) {
        menu.remove();
        document.removeEventListener("mousedown", closeMenu, true);
        document.removeEventListener("keyup", escClose, true);
        }
    };
    const escClose = (evt) => {
        if (evt.key === "Escape") {
        menu.remove();
        document.removeEventListener("mousedown", closeMenu, true);
        document.removeEventListener("keyup", escClose, true);
        }
    };
    document.addEventListener("mousedown", closeMenu, true);
    document.addEventListener("keyup", escClose, true);
    }

    function insertRowRelative(tableBody, currentRow, position) {
    // Build the row and insert at the correct index
    const newRow = tableBody.insertRow();
    newRow.innerHTML = buildNewRowHtml("—"); // Placeholder S.No; will reindex

    // Determine index to place: if currentRow exists, place before/after it.
    let targetIndex = tableBody.rows.length - 1; // default append
    if (currentRow) {
        const rowsArr = Array.from(tableBody.rows);
        const curIndex = rowsArr.indexOf(currentRow);
        if (position === "above") {
        targetIndex = curIndex;
        } else {
        targetIndex = curIndex + 1;
        }
    } else {
        // If menu triggered outside a <tr>, put below = append, above = insert at top
        targetIndex = (position === "above") ? 0 : tableBody.rows.length - 1;
    }

    // Move the newly inserted row to targetIndex if needed
    const lastIndex = tableBody.rows.length - 1;
    if (targetIndex !== lastIndex) {
        tableBody.insertBefore(newRow, tableBody.rows[targetIndex]);
    }

    // Reindex S.No after insertion
    reindexSerialNumbers(tableBody);

    // Focus first input in the new row
    const firstInput = newRow.querySelector('input, select, textarea');
    if (firstInput) firstInput.focus();
    }

