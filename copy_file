const excelInput = $('#updatecscModal').find('input[name="cutting_length"]');

let storedFormula = "";
let isEditing = false;

// 🔹 Dynamic function (example)
function p() {
  return Math.floor(Date.now() / 1000) % 10;
}

// 🔹 Formula evaluator
function evaluateFormula(formula) {
  if (!formula || !formula.startsWith("=")) return formula;

  const expression = formula.slice(1);

  try {
    const fn = new Function("p", `return ${expression}`);
    return fn(p);
  } catch (e) {
    return "Error";
  }
}

// 🔹 Focus → show formula
excelInput.on("focus", function () {
  isEditing = true;
  if (storedFormula) {
    $(this).val(storedFormula);
  }
});

// 🔹 Blur → calculate result
excelInput.on("blur", function () {
  isEditing = false;

  const value = $(this).val();
  if (!value || !value.startsWith("=")) return;

  storedFormula = value;

  const result = evaluateFormula(storedFormula);

  $(this)
    .val(result)
    .attr("title", storedFormula); // Tooltip
});

// 🔹 Auto recalc (Excel-like)
setInterval(() => {
  if (!storedFormula || isEditing) return;

  excelInput.val(evaluateFormula(storedFormula));
}, 1000);

// 🔹 Modal open safety
$('#updatecscModal').on('shown.bs.modal', function () {
  if (storedFormula && !isEditing) {
    excelInput.val(evaluateFormula(storedFormula));
  }
});
