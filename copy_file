        </main>
      </div>
  );
};

export default App;


# csc.css
html, body {
  height: 100%;
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  background: #f4f6f7;
}

/* Navbar */
.app-navbar {
  background: #ffffff;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
}

/* Sidebar */
.sidebar {
  position: fixed;
  top: 60px;
  left: 0;
  width: 260px;
  height: calc(100vh - 60px);
  background: #f8f9fa;
  padding: 20px;
  box-shadow: 2px 0 6px rgba(0,0,0,0.1);
}

.sidebar a {
  display: block;
  padding: 12px;
  color: #333;
  text-decoration: none;
  border-radius: 6px;
  margin-bottom: 8px;
}

.sidebar a:hover {
  background: #24968f;
  color: #fff;
}

.btn-primary, .btn-secondary {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 14px;
    transition: all 0.3s ease;
}
.btn-primary {
    background-color: #3498db;
    color: #fff;
    border: none;
}
.btn-primary:hover {
    background-color: #2980b9;
    transform: translateY(-2px);
}

.flex-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

/* Main content */
.main-content {
  /* margin-left: 280px;
  margin-top: 80px; */
  padding: 20px;
  background: #ffffff;
  border-radius: 6px;
  box-shadow: 0 8px 16px rgba(0,0,0,0.1);
}

/* Tables */
.table th {
  background: #24968f;
  color: #fff;
  font-size: 14px;
}

.table td {
  font-size: 13px;
  text-align: center;
  vertical-align: middle;
}

/* Buttons */
.primary-btn {
  background: #24968f;
  border: none;
  color: #fff;
}

.primary-btn:hover {
  background: #006955;
}

/* Tabs */
.nav-pills .nav-link.active {
  background: #24968f;
}

/* Responsive */
@media (max-width: 768px) {
  .sidebar {
    display: none;
  }
  .main-content {
    margin-left: 0;
  }
}

