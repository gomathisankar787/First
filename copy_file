<div class="card p-3 table-responsive">

    <form method="post">
        <table class="table table-bordered table-sm align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th rowspan="2">Process Type</th>

                    <th colspan="3">ICC</th>
                    <th colspan="3">Rejection</th>
                    <th colspan="3">Inspection</th>
                    <th colspan="3">TMC</th>
                    <th colspan="3">Design Cost</th>
                    <th colspan="3">Over Head</th>
                    <th colspan="3">Profit</th>

                    <th rowspan="2">Warranty Cost</th>
                    <th rowspan="2">Inbound Logistics</th>
                    <th rowspan="2">Actions</th>
                </tr>
                <tr>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                    <th>RM</th><th>Conv</th><th>BOF</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>
                        <input type="text" class="form-control form-control-sm"
                               name="process_type">
                    </td>

                    <!-- ICC -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="icc_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="icc_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="icc_bof"></td>

                    <!-- Rejection -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="rej_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="rej_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="rej_bof"></td>

                    <!-- Inspection -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="inspection_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="inspection_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="inspection_bof"></td>

                    <!-- TMC -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="tmc_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="tmc_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="tmc_bof"></td>

                    <!-- Design Cost -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="design_cost_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="design_cost_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="design_cost_bof"></td>

                    <!-- Over Head -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="oh_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="oh_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="oh_bof"></td>

                    <!-- Profit -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="profit_rm"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="profit_conv"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="profit_bof"></td>

                    <!-- Other -->
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="warranty_cost"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm" name="inbound_logistics"></td>

                    <td class="text-center">
                        <button class="btn btn-sm btn-success">Save</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

</div>
