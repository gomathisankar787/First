function bindFormula(modal, formulaName, targetName, calculateFn) {
    modal.on('input', `input[name="${formulaName}"]`, function () {
        const formula = $(this).val().trim();
        const targetInput = modal.find(`input[name="${targetName}"]`);

        if (!formula.startsWith("=")) {
            targetInput.val("");
            calculateFn();
            return;
        }

        const result = evaluateFormula(formula);

        if (result === "Error" || isNaN(result)) {
            targetInput.val("");
        } else {
            targetInput.val(Number(result).toFixed(3));
        }

        // 🔥 Trigger recalculation
        calculateFn();
    });
}
