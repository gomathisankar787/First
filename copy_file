        const btn = e.target.closest("button");
        if (!btn) return;
        const pos = btn.getAttribute("data-pos"); // "above" | "below"
        menu.remove();

        insertRowRelative(tableBody, currentRow, pos);
    });

    // Close menu on outside click / ESC
    const closeMenu = (evt) => {
        if (!menu.contains(evt.target) && evt.target !== trigger) {
        menu.remove();
        document.removeEventListener("mousedown", closeMenu, true);
        document.removeEventListener("keyup", escClose, true);
        }
    };
    const escClose = (evt) => {
        if (evt.key === "Escape") {
        menu.remove();
        document.removeEventListener("mousedown", closeMenu, true);
        document.removeEventListener("keyup", escClose, true);
        }
    };
    document.addEventListener("mousedown", closeMenu, true);
    document.addEventListener("keyup", escClose, true);
    }

    function insertRowRelative(tableBody, currentRow, position) {
    // Build the row and insert at the correct index
    const newRow = tableBody.insertRow();
    newRow.innerHTML = buildNewRowHtml("—"); // Placeholder S.No; will reindex

    // Determine index to place: if currentRow exists, place before/after it.
    let targetIndex = tableBody.rows.length - 1; // default append
    if (currentRow) {
        const rowsArr = Array.from(tableBody.rows);
        const curIndex = rowsArr.indexOf(currentRow);
        if (position === "above") {
        targetIndex = curIndex;
        } else {
        targetIndex = curIndex + 1;
        }
    } else {
        // If menu triggered outside a <tr>, put below = append, above = insert at top
        targetIndex = (position === "above") ? 0 : tableBody.rows.length - 1;
    }

    // Move the newly inserted row to targetIndex if needed
    const lastIndex = tableBody.rows.length - 1;
    if (targetIndex !== lastIndex) {
        tableBody.insertBefore(newRow, tableBody.rows[targetIndex]);
    }

    // Reindex S.No after insertion
    reindexSerialNumbers(tableBody);

    // Focus first input in the new row
    const firstInput = newRow.querySelector('input, select, textarea');
    if (firstInput) firstInput.focus();
    }

    function reindexSerialNumbers(tbody) {
    Array.from(tbody.rows).forEach((row, idx) => {
        const snoCell = row.querySelector("td.sno");
        if (snoCell) snoCell.textContent = (idx + 1).toString();
        const orderInput = row.querySelector('input.order-index');
        if (orderInput) orderInput.value = (idx + 1).toString();

    });
    }

    // Build the inner HTML for a new row
    function buildNewRowHtml(snoText) {
    return `
        <td class="sno" style="align-content:center">${snoText}</td>
        <input type="hidden" name="order_index[]" value="${snoText}" class="order-index">
        <td><input type="number" name="level[]" class="form-control" style="height:60px;"></td>
        <td><input type="text" name="part_num[]" class="form-control" style="height:60px;"></td>
        <td><input type="text" name="rev[]" class="form-control" style="height:60px;"></td>
        <td><input type="text" name="desc[]" class="form-control" style="height:60px;"></td>
        <td><input type="number" name="qty[]" class="form-control" style="height:60px;"></td>

        <td>
        <select name="process_type[]" class="form-control" onchange="toggleProcessType(this)" style="height:60px;">
            <option value="" disabled selected>Select Process Type</option>
            {% for process in process_types %}
            <option value="{{ process }}">{{ process }}</option>
            {% endfor %}
        </select>
        </td>

        <td>
        <select name="scope[]" class="form-control" style="height:60px;">
            <option value="" disabled selected>Select Scope</option>
            <option value="InHouse">InHouse</option>
            <option value="BOSF">BOSF</option>
            <option value="BOF">BOF</option>
        </select>
        </td>

        <td>
        <select name="method[]" class="form-control" onchange="toggleMethod(this)" style="height:60px;">
            <option value="" disabled selected>Select Method</option>
            <option value="CSC">CSC</option>
            <option value="Standard">Standard</option>
            <option value="Import">Import</option>
            <option value="Quote">Quote</option>
            <option value="Reference">Reference</option>
            <option value="Consumables">Consumables</option>
            <option value="LPP-Regression">LPP-Regression</option>
            <option value="LPP-Thumbrule">LPP-Thumbrule</option>
            <option value="KMC">KMC</option>
            <option value="ME2M">ME2M</option>
            <option value="MM03">MM03</option>
            <option value="ZS08">ZS08</option>
            <option value="ZS12">ZS12</option>
            <option value="CS03">CS03</option>
        </select>
        </td>

        <td>
        <select name="is_nesting_needed[]" class="form-control" style="height:60px;">
            <option value="" disabled selected>Select</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
        </select>
        </td>

        <td>
        <i class="bi bi-plus-circle btn" id="Editcsc" onclick="showInsertMenu(this)"></i>
        <i class="bi bi-trash btn" id="deletecsc" onclick="deleteRow(this)"></i>
        </td>
    `;
    }

    // Optional: deleteRow helper to keep S.No consistent
    function deleteRow(icon) {
    const tableBody = document.getElementById("bom-table-body");
    const row = icon.closest("tr");
    if (row) {
        row.remove();
        reindexSerialNumbers(tableBody);
    }
    }

    (function() {
    const tbody = document.getElementById('bom-table-body');
    if (!tbody) return;

    // Make all rows draggable and bind events
    function bindRowDnD(row) {
        if (row.dataset.dndBound === "1") return;
        row.dataset.dndBound = "1";
        row.setAttribute("draggable", "true");

        row.addEventListener('dragstart', (e) => {
        row.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        // Firefox requires data set
        e.dataTransfer.setData('text/plain', '');
        });

        row.addEventListener('dragend', () => {
        row.classList.remove('dragging');
        reindexSerialNumbers(tbody);  // update S.No + order_index[]
        });
    }

    // Initial bind
    Array.from(tbody.rows).forEach(bindRowDnD);

    // If rows are added later, observe and bind automatically
    const observer = new MutationObserver((mutations) => {
        mutations.forEach(m => {
        m.addedNodes.forEach(node => {
            if (node.nodeType === 1 && node.tagName === 'TR') {
            bindRowDnD(node);
            }
        });
        });
    });
    observer.observe(tbody, { childList: true });

    // Calculate where to drop relative to mouse Y
    function getRowAfterY(container, y) {
        const rows = [...container.querySelectorAll('tr:not(.dragging)')];
        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
        rows.forEach((row) => {
        const rect = row.getBoundingClientRect();
        const offset = y - (rect.top + rect.height / 2);
        if (offset < 0 && offset > closest.offset) {
            closest = { offset, element: row };
        }
        });
        return closest.element;
    }

    // Rearrange rows live during dragover
    tbody.addEventListener('dragover', (e) => {
        e.preventDefault();
        const dragging = tbody.querySelector('.dragging');
        if (!dragging) return;

        const after = getRowAfterY(tbody, e.clientY);
        if (after == null) {
        tbody.appendChild(dragging);
        } else {
        tbody.insertBefore(dragging, after);
        }
    });

    // Keep S.No and hidden order_index[] aligned with visible order
    window.reindexSerialNumbers = function(tbody) {
        Array.from(tbody.rows).forEach((row, idx) => {
        const snoCell = row.querySelector('td.sno');
        if (snoCell) snoCell.textContent = String(idx + 1);
        const orderInput = row.querySelector('input.order-index');
        if (orderInput) orderInput.value = String(idx + 1);
        });
    };
    })();


    </script>
</body>

